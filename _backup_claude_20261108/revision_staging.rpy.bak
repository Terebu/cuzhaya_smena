    cs_page_live_says={}
    for _cs_page_node in list(renpy.game.script.namemap.values()):
        if type(_cs_page_node).__name__ != "Say":continue
        _cs_page_file=str(getattr(_cs_page_node,"filename","")).replace("\\","/")
