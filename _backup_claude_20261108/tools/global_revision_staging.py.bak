"""Authored camera, cast, sound and item transitions for the new editions."""
import re

def staging(name,P):
    H={};A={}
    def at(i,*lines):H.setdefault(i,[]).extend(lines)
    def state(i,*lines):A.setdefault(i,[]).extend('$ '+s for s in lines)
    def room(i,image):at(i,'$ cs_rev_room('+repr(image)+')')
    def time(i,value):at(i,'$ cs_rev_time('+repr(value)+')')
    def music(i,track='cs_day_music_daily',volume=0.16):at(i,'$ cs_rev_music('+track+','+str(volume)+')')
    def quiet(i):at(i,'stop music fadeout 1.5')
    def leave(i,*tags):at(i,'$ cs_rev_exit('+repr(list(tags))+')','with cs_sprite_leave')
    def pov(i):at(i,'$ cs_pov_begin()','with cs_sprite_leave')
    def cg(i,image):room(i,image)
    end=P.index('Приложение для Codex')
    heads=[i for i,s in enumerate(P[:end]) if re.match(r'^Сцена (?:\d\d|П\d)\.',s)]
    headers=[]
    if name=='prologue_day01':
        backgrounds=['cs_room','cs_street','cs_bus_city','cs_bus_winter',
          'bg int_bus','bg ext_bus','bg ext_camp_entrance_day','bg ext_house_of_mt_day','bg int_house_of_mt_day','cs_camp_path_day','bg int_dining_hall_people_day','cs_camp_path_day','cs_house_lena_darya_int_day','cs_house_lena_darya_int_day','cs_camp_path_sunset','bg ext_square_sunset','bg ext_houses_sunset','cs_camp_path_sunset','cs_library_interior_evening','cs_library_exterior_sunset','cs_house_lena_darya_int_night']
        for j,h in enumerate(heads):
            d=0 if j<4 else 1;n=j+1 if j<4 else j-3
            title=P[h].split('. ',1)[1]
            when='prolog' if d==0 else 'day' if n<=10 else 'sunset' if n<=16 else 'night'
            outfit='winter' if d==0 or n<=5 else 'pioneer'
            headers.append((d,n,title,h+2,heads[j+1] if j+1<len(heads) else end,backgrounds[j],when,outfit))
        at(69,'label cs_rev_check_room:','call cs_opening_credits from cs_rev_credits_return')
        music(69,'cs_music_calm',0.12)
        at(81,'label cs_rev_check_battery7:')
        at(84,'show screen cs_phone(7, "battery")')
        at(90,'hide screen cs_phone')
        at(91,'$ cs_rev_allowed = list(set(cs_rev_allowed + ["cs_dasha_winter"]))','$ cs_rev_focus("da")','with cs_sprite_change')
        at(99,'$ cs_pov_begin()','show screen cs_phone(5, "profile")','show screen cs_instagram_post("cs_instagram_oni")')
        at(102,'hide screen cs_instagram_post','show screen cs_phone(5, "off")')
        at(103,'hide screen cs_phone')
        at(104,'show screen cs_phone(2, "battery")')
        at(105,'show screen cs_phone(0, "off")','play sound cs_phone_error')
        at(107,'hide screen cs_phone','$ cs_rev_focus("da")','with cs_sprite_change')
        at(116,'$ cs_rev_focus("da")','with cs_sprite_change')
        at(138,'$ cs_rev_focus("da")','with cs_sprite_change')
        room(86,'cs_stop');room(90,'cs_bus_city');room(115,'cs_bus_winter')
        state(129,'cs_darya_known = True')
        # Restore the stable prologue's sleep/wake camera sequence without
        # changing manuscript indices or duplicating the wake-up dialogue.
        at(141, 'cs_narrator "Я зевнула и прикрыла рот ладонью."',
           'cs_narrator "Дарья откинулась на спинку сиденья и закрыла глаза."')
        at(146, 'cs_narrator "Мы замолчали. Отопитель гудел, и меня всё сильнее клонило в сон."')
        at(147, 'cs_narrator "Я прикрыла глаза."')
        room(147,'cs_sleep_winter')
        at(148,'stop music fadeout 3.0','stop ambience fadeout 3.0')
        at(150,'window hide', '$ cs_pov_begin()')
        room(150,'black')
        at(150,'pause 2.0')
        at(152,'cs_narrator "Я нахмурилась, не открывая глаз."')
        at(153,'play ambience cs_forest fadein 2.5')
        at(154,'cs_narrator "Я лежала или сидела? Кажется, сидела."', 'cs_narrator "Но почему тогда было так тихо? Я прислушалась."')
        time(156,'day');room(156,'cs_sunlight')
        at(156,'pause 0.6')
        room(156,'bg int_bus')
        room(158,'cs_sleep_summer')
        room(159,'bg ext_camp_entrance_day')
        at(159,'show cs_windshield')
        at(164,'$ cs_rev_darya_offscreen = True')
        state(167,'cs_rev_darya_offscreen = False')
        state(243,'cs_slavya_known = True')
        room(260,'cs_camp_path_day')
        state(276,'cs_olga_seen = True')
        room(290,'bg int_house_of_mt_day')
        room(336,'bg int_house_of_mt_day');at(336,'$ cs_rev_costume("pioneer")')
        room(378,'bg ext_dining_hall_near_day')
        room(450,'cs_house_lena_darya_int_day');leave(456,'sl')
        room(486,'cs_house_lena_darya_ext_day');room(502,'cs_house_lena_darya_int_day')
        room(510,'bg ext_clubs_day');room(512,'bg int_clubs_male_day')
        music(512,'"sound/music/smooth_machine.ogg"')
        music(575,'"sound/music/get_to_know_me_better.ogg"',0.14)
        state(674,'cs_met_un = True')
        state(690,'cs_un_name_known = True')
        # Guarded flags from the manuscript are emitted separately from speech.
        state(674,'cs_part09_choice = "meet"')
        state(707,'cs_part09_choice = "pass"')
        room(724,'bg int_dining_hall_sunset')
        state(740,'cs_met_mz = True')
        room(841,'cs_library_exterior_sunset')
        time(871,'night');quiet(871)
        at(886,'$ cs_rev_room("cs_house_lena_darya_int_sleep_night")')
        at(899,'play sound "<from 0.0 to 0.7>sound/sfx/bus_idle.ogg" volume 0.12')
        pov(899)
    elif name=='day02':
        backgrounds=['cs_house_lena_darya_int_day','bg ext_square_day','bg ext_no_bus','cs_house_lena_darya_int_day','cs_camp_path_day','bg ext_square_day','bg int_clubs_male_day','bg ext_aidpost_day','bg ext_clubs_day','bg int_dining_hall_people_day','cs_road_powerlines_day','bg ext_camp_entrance_day','bg int_aidpost_day','bg ext_square_day','bg int_library_day','bg int_dining_hall_sunset','bg ext_square_sunset','cs_house_lena_darya_int_night']
        for j,h in enumerate(heads):
            n=j+1;headers.append((2,n,P[h].split('. ',1)[1],h+2,heads[j+1] if j+1<len(heads) else end,backgrounds[j],'day' if n<16 else 'sunset' if n<18 else 'night','sport' if n<=3 else 'pioneer'))
        at(83,'$ cs_rev_darya_offscreen = True');room(110,'cs_house_lena_darya_ext_day');room(115,'bg ext_playground_day')
        room(148,'bg ext_house_of_mt_day');room(192,'bg int_dining_hall_people_day')
        state(274,'cs_met_mi = True','cs_mi_name_known = True')
        room(284,'bg int_musclub_day')
        music(293,'cs_darya_piano_track',0.22);quiet(297)
        music(313,'cs_miku_piano_track',0.22);quiet(314);music(317,'cs_miku_piano_track',0.22);quiet(318);music(324,'cs_miku_piano_track',0.22);quiet(332)
        room(355,'bg ext_square_day')
        music(362);at(368,'play sound "sound/sfx/dinner_jingle_speaker.ogg"')
        state(310,'cs_day02_miku_listened = True');state(336,'cs_day02_miku_listened = False')
        state(388,'cs_helped_sl_day2 = True');state(415,'cs_helped_sl_day2 = False')
        room(382,'cs_storage_ext_day');room(422,'bg ext_clubs_day')
        music(430,'"sound/music/smooth_machine.ogg"')
        room(451,'bg ext_clubs_day');state(451,'cs_lena_elbow_injury_day2 = max(1,cs_lena_elbow_injury_day2)')
        room(470,'bg int_aidpost_day');state(501,'cs_lena_elbow_bandaged = True')
        state(510,'cs_helped_viola_day2 = True');state(520,'cs_helped_viola_day2 = False')
        cg(555,'cs_cg_poster_planning_day');room(593,'bg ext_clubs_day')
        state(565,'cs_worked_with_se_day2 = True');state(584,'cs_worked_with_se_day2 = False')
        room(605,'cs_camp_path_day')
        state(663,'cs_trusted_se_road_day2 = True');state(673,'cs_trusted_se_road_day2 = False')
        # Four actual road views, returning to the exact marked verge.
        room(685,'cs_road_powerlines_day');quiet(685)
        room(697,'cs_road_right_bend_day');room(709,'cs_road_marked_verge_day')
        room(716,'cs_road_left_bend_day');room(721,'cs_road_marked_verge_day')
        room(725,'cs_road_powerlines_day')
        state(725,'cs_road_loop_observations = max(2,cs_road_loop_observations)')
        at(734,'play sound "sound/sfx/bodyfall_1.ogg"')
        state(735,'cs_lena_elbow_injury_day2 = 2')
        state(802,'cs_lena_elbow_bandaged = True','cs_lena_no_sport_day2 = True')
        state(822,'cs_talked_viola_second_day2 = True');state(833,'cs_talked_viola_second_day2 = False')
        room(850,'bg ext_aidpost_day')
        state(887,'cs_road_notes_written = True')
        state(917,'cs_talked_mz_square_day2 = True');state(934,'cs_talked_mz_square_day2 = False')
        at(950,'$ cs_rev_darya_offscreen = True');pov(952)
        state(985,'cs_rev_darya_offscreen = False')
        state(996,'cs_reading_book_borrowed = False','cs_reading_book_location = "library_shelf"','cs_lena_book_returned = True')
        state(1026,'cs_mz_map_lead = True')
        music(1104,'"sound/music/feeling_good.ogg"')
        state(1124,'cs_mi_intro_revised = True')
        state(1133,'cs_viola_spare_bandage = True')
        state(1137,'cs_un_concert_sketch_seen = True')
        music(1147,'cs_miku_piano_track',0.25);cg(1147,'cs_cg_square_concert_evening')
        room(1161,'bg ext_square_sunset');quiet(1178)
        room(1221,'cs_house_lena_darya_int_sleep_night')
    elif name=='day03':
        backgrounds=['cs_house_lena_darya_int_day','cs_house_lena_darya_int_day','bg int_dining_hall_people_day','bg int_aidpost_day','bg ext_house_of_mt_day','bg int_musclub_day','bg int_dining_hall_people_day','bg int_library_day','bg ext_square_day','bg ext_musclub_day','bg int_dining_hall_sunset','cs_library_interior_evening','cs_library_exterior_night','cs_house_lena_darya_int_night']
        for j,h in enumerate(heads):
            n=j+1;headers.append((3,n,P[h].split('. ',1)[1],h+2,heads[j+1] if j+1<len(heads) else end,backgrounds[j],'day' if n<10 else 'sunset' if n<13 else 'night','pioneer'))
        quiet(59);room(71,'bg ext_square_day');room(72,'bg ext_playground_day')
        at(75,'play sound "<from 0.0 to 0.7>sound/sfx/bus_idle.ogg" volume 0.12')
        at(103,'play sound "sound/sfx/dinner_horn_processed.ogg"')
        at(108,'$ cs_rev_darya_offscreen = True');state(119,'cs_rev_darya_offscreen = False')
        room(132,'cs_camp_path_day')
        state(234,'cs_rev_viola_before = cs_friend_viola')
        room(279,'cs_int_administration_day');room(289,'cs_camp_path_day')
        room(295,'cs_storage_int_day');room(320,'cs_storage_ext_day')
        room(333,'bg ext_musclub_day');room(335,'bg int_musclub_day')
        music(339,'cs_miku_piano_track',0.22);quiet(345)
        at(424,'$ cs_rev_snapshot("cs_mz_friend_on_arrival_day3","cs_friend_mz")')
        pov(449);time(637,'night');room(637,'cs_library_interior_night');pov(637)
        state(449,'cs_day03_reading_book_id = "goncharov_ordinary_story"','cs_day03_reading_book_location = "lena_hand"')
        at(477,'$ cs_rev_snapshot("cs_se_friend_before_square_day3","cs_friend_se")')
        room(540,'cs_house_lena_darya_int_sunset');state(562,'cs_da_cheek_kiss_day3 = True')
        at(566,'$ cs_rev_snapshot("cs_mz_dinner_friend_on_arrival","cs_friend_mz")')
        room(594,'bg ext_square_sunset')
        at(708,'$ cs_rev_snapshot("cs_da_friend_before_night","cs_friend_da")')
        music(723,'"sound/music/a_promise_from_distant_days.ogg"',0.12)
        cg(767,'cs_cg_lena_darya_shared_sleep_night')
        # The illustration is conditional; separate beds keep the cabin visible.
        H[767]=['if cs_da_shared_bed_day3:','    $ cs_rev_room("cs_cg_lena_darya_shared_sleep_night")','    $ cs_da_shared_sleep_cg_seen_day3 = True','else:','    $ cs_rev_room("cs_house_lena_darya_int_sleep_night")','$ cs_pov_begin()','with cs_sprite_leave','stop music fadeout 2.0']
        state(723,'cs_day03_sketchbook_location = "cabin_table"')
    else:
        backgrounds=['cs_house_lena_darya_int_sleep_night','cs_d4_old_photo_room','cs_d4_old_stairs','bg ext_path_day','cs_house_lena_darya_ext_day','bg ext_house_of_mt_day','cs_camp_path_day','bg ext_square_day','bg int_dining_hall_people_day','bg int_library_day','cs_library_exterior_sunset','cs_library_exterior_sunset']
        for j,h in enumerate(heads):
            n=j+1;headers.append((4,n,P[h].split('. ',1)[1],h+2,heads[j+1] if j+1<len(heads) else end,backgrounds[j],'night' if n==1 else 'day' if n<11 else 'sunset','sport' if n<5 else 'pioneer'))
        quiet(28);at(28,'$ cs_rev_darya_offscreen = True');room(99,'bg ext_square_night')
        room(108,'bg ext_path_night');music(110,'"sound/music/into_the_unknown.ogg"',0.12)
        room(120,'cs_d4_old_ext');room(132,'cs_d4_old_corridor')
        room(177,'cs_d4_old_corridor');room(198,'cs_d4_old_stairs')
        room(211,'cs_d4_old_door');room(216,'bg int_catacombs_entrance');room(223,'cs_d4_old_bunker');room(229,'cs_d4_old_archive')
        at(231,'$ cs_pov_begin()','show cs_d4_document roster1971 at cs_d4_document_center','with cs_sprite_enter')
        at(234,'hide cs_d4_document','show cs_d4_document photo1971 at cs_d4_document_center','with cs_sprite_change')
        at(238,'hide cs_d4_document','with cs_sprite_leave')
        at(240,'show cs_d4_document photo1963 at cs_d4_document_center','with cs_sprite_enter')
        at(241,'hide cs_d4_document','with cs_sprite_leave')
        room(256,'cs_d4_old_corridor');room(257,'cs_d4_old_stairs');quiet(260)
        room(284,'cs_d4_old_door');room(300,'cs_d4_old_stairs')
        state(301,'cs_rev_darya_offscreen = False')
        room(374,'cs_d4_old_ext');time(386,'day');room(404,'bg ext_square_day')
        room(501,'cs_house_lena_darya_int_day');leave(501,'cs_semen')
        room(539,'cs_house_lena_darya_ext_day');at(539,'$ cs_rev_allowed = cs_rev_allowed + (["cs_semen"] if "cs_semen" not in cs_rev_allowed else [])')
        room(552,'bg int_house_of_mt_day');state(651,'cs_d4_undated_photo_location = "olga"','cs_d4_photo1971_location = "lena"','cs_d4_roster_location = "lena"')
        room(669,'bg int_dining_hall_people_day');room(694,'bg int_aidpost_day')
        state(711,'cs_lena_elbow_bandaged = False')
        room(790,'bg ext_musclub_day');at(794,'$ cs_rev_offscreen_once = True')
        room(806,'cs_camp_path_day');room(824,'bg ext_dining_hall_near_day')
        at(829,'play sound "sound/sfx/dinner_horn_processed.ogg"')
        room(910,'bg int_library_day');quiet(910)
        state(1021,'cs_d4_photo1971_location = "library_locked_drawer"','cs_d4_roster_location = "library_locked_drawer"')
        at(1048,'play sound "sound/sfx/dinner_horn_processed.ogg"')
        room(1060,'bg ext_square_sunset');room(1083,'bg int_dining_hall_sunset')
        room(1158,'cs_library_interior_night');time(1158,'night')
        state(1223,'cs_d4_dream_notes_location = "library_locked_drawer"')
        room(1237,'cs_camp_path_night');room(1332,'cs_house_lena_darya_int_sleep_night');quiet(1332)
    from global_revision_sfx import cues
    for i,lines in list(H.items()):H[i]=[s for s in lines if not s.startswith('play sound ')]
    for i,lines in cues(name).items():at(i,*lines)
    return H,headers,A
