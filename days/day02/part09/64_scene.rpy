    # cs_presence_keep: hide cs_dasha_pioneer
    show cs_zhenya thinking pioneer normal at cs_darya_normal_left
    show cs_darya shrug pioneer normal at cs_darya_normal_right
    $ cs_part09_cast = ["cs_zhenya", "cs_darya"]
    $ cs_presence_stage()
    # cs_global_transition
    with cs_sprite_change
    cs_mz "Чего ты так улыбаешься?"
    cs_narrator "Я задумалась."
    cs_ls "Радуюсь встрече со знакомым человеком."
    cs_narrator "Женя посмотрела на меня ещё внимательнее."
    # cs_presence_keep: hide cs_semen
    # cs_presence_keep: hide mz
    # cs_presence_keep: hide un
    # cs_presence_keep: hide mi
    # cs_presence_keep: hide dv
    # cs_presence_keep: hide sl
    # cs_presence_keep: hide us
    # cs_presence_keep: hide mt
    # cs_presence_keep: hide sh
    # cs_presence_keep: hide el
    # cs_presence_keep: hide cs
    # cs_presence_keep: hide cs_dasha_winter
    # cs_presence_keep: hide cs_dasha_pioneer
    show cs_zhenya normal pioneer normal at cs_darya_normal_left
    show cs_darya shrug pioneer normal at cs_darya_normal_right
    $ cs_part09_cast = ["cs_zhenya", "cs_darya"]
    $ cs_presence_stage()
    # cs_global_transition
    with cs_sprite_change
    cs_mz "Подозрительно."
    cs_ls "Уже несколько человек сегодня так сказали."
    cs_da "Не без оснований."
    cs_narrator "Я повернулась к ней."
    cs_ls "Опять?"
    cs_narrator "Она улыбнулась."
    cs_narrator "Женя вздохнула."
    cs_narrator "Но на этот раз не стала немедленно возвращаться к книге."
    call cs_day02_dinner_branches from cs_return_3f20a08780bac7be0bc1
    return
