# -*- coding: utf-8 -*-
label cs_day02_64:
    $ save_name = "Чужая смена — День 2: Самый дальний стол"
    $ cs_part09_live = True
    # cs_presence_keep: hide cs_semen
    # cs_presence_keep: hide cs_zhenya
    # cs_presence_keep: hide mz
    # cs_presence_keep: hide un
    # cs_presence_keep: hide mi
    # cs_presence_keep: hide dv
    # cs_presence_keep: hide sl
    # cs_presence_keep: hide us
    # cs_presence_keep: hide mt
    # cs_presence_keep: hide sh
    # cs_presence_keep: hide el
    # cs_presence_keep: hide cs
    # cs_presence_keep: hide cs_dasha_winter
    # cs_presence_keep: hide cs_dasha_pioneer
    show cs_darya shrug pioneer normal at cs_darya_normal_right
    $ cs_part09_cast = ["cs_darya"]
    $ cs_presence_stage()
    # cs_global_transition
    with cs_sprite_change
    $ renpy.music.set_volume(0.14, channel="music", delay=1.0)
    label cs_check_part09_s64:
    label cs_check_dinner64_start:
    # cs_director_begin: entry frame; explicit scene plan
    $ cs_frame_focus(["cs_darya"])
    with cs_sprite_change
    # cs_director_end
    cs_narrator "С подносами в руках мы отошли от раздачи. Я осторожно придерживала тарелку здоровой рукой. Вторую старалась держать подальше от всего, что могло задеть повязку."
    cs_th "Вот ведь. Раньше никогда не задумывалась, насколько неудобно переносить обычный поднос, когда одна рука решила временно отказаться от полноценного участия в общественной жизни."
    cs_narrator "Дарья шла рядом."
    cs_da "Давай помогу."
    cs_narrator "Я посмотрела на неё."
    cs_ls "Спасибо, но пока справляюсь."
    cs_da "Тогда хотя бы не пытайся одновременно нести поднос и размахивать рукой."
    cs_narrator "Я усмехнулась."
    cs_ls "У меня вообще-то богатый опыт выполнения нескольких задач."
    cs_narrator "Она посмотрела на повязку."
    cs_da "Сегодня мы уже видели результаты."
    cs_narrator "Я вздохнула."
    cs_ls "Это была одна техническая ошибка."
    cs_da "Два посещения медпункта."
    cs_ls "Попрошу не пользоваться статистикой против меня."
    cs_narrator "Дарья рассмеялась. Мы прошли между столами. Большинство мест уже было занято. Где-то смеялись пионеры."
    cs_narrator "За другим столом двое мальчишек спорили о предстоящем выступлении Алисы. Возле окна сидела компания девочек, оживлённо обсуждавших, кто сегодня будет выступать первым. А в самом дальнем углу столовой обнаружилась Женя. Я остановилась."
    cs_th "О. Вот она."
    cs_narrator "Причём место девушка выбрала весьма характерное. Самый дальний свободный стол. Подальше от прохода. Подальше от шумных компаний."
    cs_narrator "Поближе к окну. Она поставила поднос, аккуратно отодвинула книгу от тарелки и устроилась так, будто совершенно искренне рассчитывала провести ближайшие двадцать минут без участия посторонних. Я посмотрела на неё, потом на Дарью."
    cs_ls "Видишь?"
    cs_narrator "Она проследила за моим взглядом."
    # cs_presence_keep: hide cs_semen
    # cs_presence_keep: hide cs_zhenya
    # cs_presence_keep: hide mz
    # cs_presence_keep: hide un
    # cs_presence_keep: hide mi
    # cs_presence_keep: hide dv
    # cs_presence_keep: hide sl
    # cs_presence_keep: hide us
    # cs_presence_keep: hide mt
    # cs_presence_keep: hide sh
    # cs_presence_keep: hide el
    # cs_presence_keep: hide cs
    # cs_presence_keep: hide cs_dasha_winter
    # cs_presence_keep: hide cs_dasha_pioneer
    show cs_darya thinking pioneer normal at cs_darya_normal_right
    $ cs_part09_cast = ["cs_darya"]
    $ cs_presence_stage()
    # cs_global_transition
    with cs_sprite_change
    cs_da "Женю?"
    cs_ls "Именно."
    cs_narrator "Дарья задумалась. Потом улыбнулась."
    # cs_presence_keep: hide cs_semen
    # cs_presence_keep: hide cs_zhenya
    # cs_presence_keep: hide mz
    # cs_presence_keep: hide un
    # cs_presence_keep: hide mi
    # cs_presence_keep: hide dv
    # cs_presence_keep: hide sl
    # cs_presence_keep: hide us
    # cs_presence_keep: hide mt
    # cs_presence_keep: hide sh
    # cs_presence_keep: hide el
    # cs_presence_keep: hide cs
    # cs_presence_keep: hide cs_dasha_winter
    # cs_presence_keep: hide cs_dasha_pioneer
    show cs_darya arms_crossed pioneer normal at cs_darya_normal_right
    $ cs_part09_cast = ["cs_darya"]
    $ cs_presence_stage()
    # cs_global_transition
    with cs_sprite_change
    cs_da "Только не говори, что собираешься объявить ей принудительную программу социализации."
    cs_narrator "Я посмотрела на неё."
    cs_th "А ведь именно такая мысль только что и появилась. Соколова. Человек специально сел один. Возможно, это не просьба о спасении."
    cs_th "Возможно, он просто хочет спокойно поужинать."
    cs_narrator "Я слегка вздохнула."
    cs_ls "Никакой принудительной программы."
    cs_narrator "Дарья приподняла бровь."
    # cs_presence_keep: hide cs_semen
    # cs_presence_keep: hide cs_zhenya
    # cs_presence_keep: hide mz
    # cs_presence_keep: hide un
    # cs_presence_keep: hide mi
    # cs_presence_keep: hide dv
    # cs_presence_keep: hide sl
    # cs_presence_keep: hide us
    # cs_presence_keep: hide mt
    # cs_presence_keep: hide sh
    # cs_presence_keep: hide el
    # cs_presence_keep: hide cs
    # cs_presence_keep: hide cs_dasha_winter
    # cs_presence_keep: hide cs_dasha_pioneer
    show cs_darya ear_touch pioneer normal at cs_darya_normal_right
    $ cs_part09_cast = ["cs_darya"]
    $ cs_presence_stage()
    # cs_global_transition
    with cs_sprite_change
    cs_da "Правда?"
    cs_ls "Абсолютно."
    cs_narrator "Немного помолчала."
    cs_ls "Но, пожалуй, можно хотя бы спросить, не возражает ли она против компании."
    cs_narrator "Дарья улыбнулась."
    # cs_presence_keep: hide cs_semen
    # cs_presence_keep: hide cs_zhenya
    # cs_presence_keep: hide mz
    # cs_presence_keep: hide un
    # cs_presence_keep: hide mi
    # cs_presence_keep: hide dv
    # cs_presence_keep: hide sl
    # cs_presence_keep: hide us
    # cs_presence_keep: hide mt
    # cs_presence_keep: hide sh
    # cs_presence_keep: hide el
    # cs_presence_keep: hide cs
    # cs_presence_keep: hide cs_dasha_winter
    # cs_presence_keep: hide cs_dasha_pioneer
    show cs_darya shrug pioneer normal at cs_darya_normal_right
    $ cs_part09_cast = ["cs_darya"]
    $ cs_presence_stage()
    # cs_global_transition
    with cs_sprite_change
    cs_da "Вот это уже разумнее."
    cs_narrator "Мы направились в сторону дальнего стола."
    # cs_presence_keep: hide cs_semen
    # cs_presence_keep: hide mz
    # cs_presence_keep: hide un
    # cs_presence_keep: hide mi
    # cs_presence_keep: hide dv
    # cs_presence_keep: hide sl
    # cs_presence_keep: hide us
    # cs_presence_keep: hide mt
    # cs_presence_keep: hide sh
    # cs_presence_keep: hide el
    # cs_presence_keep: hide cs
    # cs_presence_keep: hide cs_dasha_winter
    # cs_presence_keep: hide cs_dasha_pioneer
    show cs_zhenya normal pioneer normal at cs_darya_normal_left
    show cs_darya shrug pioneer normal at cs_darya_normal_right
    $ cs_part09_cast = ["cs_zhenya", "cs_darya"]
    $ cs_presence_stage()
    # cs_global_transition
    with cs_sprite_change
    label cs_check_dinner64_greeting:
    cs_narrator "Женя заметила нас ещё до того, как мы подошли. Она подняла взгляд поверх очков. Посмотрела сначала на меня, затем на Дарью."
    cs_narrator "И остановилась на моём выражении лица."
    cs_mz "Соколова."
    cs_ls "Женя."
    # cs_presence_keep: hide cs_semen
    # cs_presence_keep: hide mz
    # cs_presence_keep: hide un
    # cs_presence_keep: hide mi
    # cs_presence_keep: hide dv
    # cs_presence_keep: hide sl
    # cs_presence_keep: hide us
    # cs_presence_keep: hide mt
    # cs_presence_keep: hide sh
    # cs_presence_keep: hide el
    # cs_presence_keep: hide cs
    # cs_presence_keep: hide cs_dasha_winter
    # cs_presence_keep: hide cs_dasha_pioneer
    show cs_zhenya thinking pioneer normal at cs_darya_normal_left
    show cs_darya shrug pioneer normal at cs_darya_normal_right
    $ cs_part09_cast = ["cs_zhenya", "cs_darya"]
    $ cs_presence_stage()
    # cs_global_transition
    with cs_sprite_change
    cs_mz "Чего ты так улыбаешься?"
    cs_ls "Радуюсь встрече со знакомым человеком."
    cs_narrator "Женя посмотрела на меня ещё внимательнее."
    # cs_presence_keep: hide cs_semen
    # cs_presence_keep: hide mz
    # cs_presence_keep: hide un
    # cs_presence_keep: hide mi
    # cs_presence_keep: hide dv
    # cs_presence_keep: hide sl
    # cs_presence_keep: hide us
    # cs_presence_keep: hide mt
    # cs_presence_keep: hide sh
    # cs_presence_keep: hide el
    # cs_presence_keep: hide cs
    # cs_presence_keep: hide cs_dasha_winter
    # cs_presence_keep: hide cs_dasha_pioneer
    show cs_zhenya normal pioneer normal at cs_darya_normal_left
    show cs_darya shrug pioneer normal at cs_darya_normal_right
    $ cs_part09_cast = ["cs_zhenya", "cs_darya"]
    $ cs_presence_stage()
    # cs_global_transition
    with cs_sprite_change
    cs_mz "Подозрительно."
    cs_ls "Уже несколько человек сегодня так сказали."
    cs_da "Не без оснований."
    cs_narrator "Я повернулась к ней."
    cs_ls "Опять?"
    cs_narrator "Она улыбнулась. Женя вздохнула. Но на этот раз не стала немедленно возвращаться к книге."
    call cs_day02_dinner_branches from cs_return_3f20a08780bac7be0bc1
    return
