# -*- coding: utf-8 -*-
label cs_day03_78a:
    $ save_name = "Чужая смена — День 3: Последствия вчерашней помощи"
    cs_narrator "Славя вдруг посмотрела на папку в коробке."
    cs_narrator "Потом на меня."
    cs_sl "Кстати, хорошо, что встретила тебя."
    cs_narrator "Я насторожилась."
    cs_ls "Это сейчас прозвучало как начало поручения."
    show sl laugh pioneer at cs_actor_left
    $ cs_presence_stage()
    with cs_sprite_change
    cs_narrator "Она засмеялась."
    cs_sl "Нет. Наоборот."
    cs_narrator "Славя осторожно вынула папку."
    cs_narrator "Открыла её."
    cs_narrator "И показала мне знакомый лист."
    cs_narrator "Наш плакат."
    cs_narrator "Тот самый, который мы вчера рисовали вместе с Семёном и Дарьей."
    cs_narrator "Большой заголовок."
    cs_narrator "Ноты."
    cs_narrator "Гитара."
    cs_narrator "Небольшие декоративные элементы, над которыми я успела повозиться значительно дольше, чем того требовало здравомыслие."
    cs_narrator "Я удивлённо подняла брови."
    cs_ls "Ого."
    cs_sl "После концерта мы снимали объявления. Я подумала, что ваш лучше не складывать вместе со старой бумагой."
    cs_narrator "Я посмотрела на неё."
    cs_ls "Ты его сохранила?"
    cs_narrator "Она кивнула."
    cs_sl "Да. Вы ведь столько над ним работали."
    cs_narrator "Немного помолчала."
    cs_sl "Особенно ты. Я помню, как долго вы с Семёном обсуждали надпись."
    cs_narrator "Я невольно улыбнулась."
    cs_ls "Это называется профессиональная деформация."
    cs_sl "Что?"
    cs_narrator "Я покачала головой."
    cs_ls "Неважно. Художники иногда способны полчаса спорить о расстоянии между двумя буквами."
    cs_narrator "Она рассмеялась."
    cs_sl "Теперь буду знать."
    cs_narrator "Я осторожно коснулась края листа здоровой рукой."
    cs_narrator "Бумага немного помялась в одном углу."
    cs_narrator "Но рисунок сохранился."
    cs_narrator "И даже цвета выглядели вполне прилично."
    cs_th "Надо же."
    cs_th "В Москве подобная работа наверняка осталась бы обычным файлом в папке."
    cs_th "А здесь её можно взять в руки."
    cs_th "И кто-то подумал о том, чтобы сохранить."
    cs_ls "Спасибо, Славя."
    cs_narrator "Она улыбнулась."
    cs_sl "Не за что."
    cs_narrator "Потом посмотрела на мою повязку."
    cs_sl "Давай я пока оставлю его у себя. После завтрака или позже заберёшь. А то с рукой неудобно нести."
    cs_narrator "Я кивнула."
    cs_ls "Хорошая идея."
    cs_narrator "Немного подумала."
    cs_ls "Даша тоже обрадуется. Она вчера переживала, чтобы мы ничего не испортили, пока рисовали."
    cs_sl "Тогда обязательно покажи ей."
    show sl smile pioneer at cs_actor_left
    $ cs_presence_stage()
    with cs_sprite_change
    cs_narrator "Я улыбнулась."
    cs_ls "Договорились."
    cs_narrator "Она аккуратно закрыла папку."
    cs_narrator "Я посмотрела на неё уже внимательнее."
    cs_ls "Славя."
    cs_sl "Что?"
    cs_ls "А ты всегда так внимательно относишься к тому, что делают другие?"
    cs_narrator "Она немного удивилась."
    cs_sl "В каком смысле?"
    cs_narrator "Я кивнула на коробку."
    cs_ls "Ну, можно было просто убрать плакат вместе со всеми украшениями. Никто бы ничего не сказал."
    show sl normal pioneer at cs_actor_left
    $ cs_presence_stage()
    with cs_sprite_change
    cs_narrator "Она немного задумалась."
    cs_sl "Наверное, просто жалко выбрасывать то, во что люди вложили столько сил."
    cs_narrator "Я посмотрела на неё."
    cs_th "Вот и всё."
    cs_th "Никакой особенной причины."
    cs_th "Просто человеку не всё равно."
    show sl smile pioneer at cs_actor_left
    $ cs_presence_stage()
    with cs_sprite_change
    cs_narrator "Я улыбнулась."
    cs_ls "Знаешь, мне нравится твой подход."
    cs_narrator "Славя улыбнулась в ответ."
    cs_sl "Спасибо."
    cs_narrator "Немного помолчала."
    cs_narrator "Потом добавила:"
    cs_sl "И я рада, что вы вчера помогли. Без вас мы бы точно дольше возились."
    cs_narrator "Я кивнула."
    cs_ls "Тогда официально считаю наше трудовое сотрудничество успешным."
    cs_narrator "Славя рассмеялась."
    cs_sl "Согласна."
    cs_th "Пожалуй, это было приятнее любой формальной благодарности."
    cs_th "Плакат сохранили не потому, что он необходим лагерю."
    cs_th "А потому, что он что-то значил для нас."
    if not cs_sl_poster_saved_day3:
        $ cs_sl_poster_saved_day3 = True
        $ cs_day03_poster_location = "slavya"
    return
