# -*- coding: utf-8 -*-
label cs_day03_102a:
    $ save_name = "Чужая смена — День 3: Две пострадавшие творческие личности"
    cs_narrator "Я посмотрела на Алису."
    cs_ls "Серьёзно, всё нормально?"
    cs_narrator "Она пожала плечами."
    cs_dv "Да. Палец немного задела."
    cs_narrator "Я кивнула."
    cs_ls "Струной?"
    cs_dv "Угу. Меняла, дёрнула неудачно."
    cs_narrator "Она немного помолчала."
    cs_narrator "Потом добавила:"
    cs_dv "И не надо сейчас рассказывать, какая я неуклюжая. Сама знаю."
    cs_narrator "Я посмотрела на неё."
    cs_narrator "Потом на собственную повязку."
    cs_ls "Алиса."
    cs_narrator "Она насторожилась."
    cs_dv "Что?"
    cs_narrator "Я приподняла забинтованный локоть."
    cs_ls "Как думаешь, кто из нас двоих сейчас обладает большим моральным правом читать лекции о неуклюжести?"
    cs_narrator "Алиса посмотрела на мою руку."
    cs_narrator "Потом на меня."
    cs_narrator "Несколько секунд молчала."
    cs_narrator "И неожиданно рассмеялась."
    cs_dv "Ладно. Убедила."
    cs_narrator "Я улыбнулась."
    cs_ls "Вот и хорошо."
    cs_narrator "Дарья наблюдала за нами с лёгкой улыбкой."
    cs_da "Вы обе просто не умеете вовремя останавливаться."
    cs_narrator "Я повернулась к ней."
    cs_ls "Попрошу не объединять совершенно разные творческие происшествия в одну статистическую категорию."
    if renpy.showing("dv"):
        show dv grin pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Алиса усмехнулась."
    cs_dv "Да ладно. Она права."
    cs_narrator "Я посмотрела на Алису."
    cs_ls "Предательство. Причём совершенно неожиданное."
    cs_narrator "Она рассмеялась."
    cs_narrator "Потом снова взглянула на палец."
    cs_narrator "Я заметила, что ей неприятно сгибать его."
    cs_narrator "И решила не продолжать шутку."
    cs_ls "Ты лучше покажи Виоле. С такими вещами не стоит геройствовать."
    cs_narrator "Алиса подняла на меня взгляд."
    cs_dv "Я для этого и пришла."
    cs_narrator "Я кивнула."
    cs_ls "Значит, действуешь разумнее меня вчерашней."
    cs_narrator "Она усмехнулась."
    cs_dv "Ого. Соколова признаёт чужое превосходство?"
    cs_narrator "Я задумалась."
    cs_ls "В отдельных номинациях."
    if renpy.showing("cs_darya"):
        show cs_darya amused pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья рассмеялась."
    cs_narrator "Алиса посмотрела на меня внимательнее."
    cs_dv "Слушай, а ты сама-то нормально?"
    cs_narrator "Я немного удивилась."
    cs_ls "В каком смысле?"
    cs_narrator "Она кивнула на локоть."
    cs_dv "Ну, после вчерашнего."
    cs_narrator "Я улыбнулась."
    cs_ls "Уже лучше. Повязку поменяли, нагрузки запретили."
    cs_dv "Тогда чего улыбаешься?"
    cs_narrator "Я задумалась."
    cs_ls "Потому что к ограничениям можно относиться по-разному. Я предпочитаю с юмором."
    cs_narrator "Она усмехнулась."
    cs_dv "У тебя этого добра явно с избытком."
    cs_narrator "Я кивнула."
    cs_ls "Могу поделиться. Бесплатно, без регистрации."
    cs_dv "Спасибо, сама справлюсь."
    cs_narrator "Я улыбнулась."
    cs_th "Вот это уже похоже на нормальный разговор."
    cs_th "Без необходимости устраивать соревнование, кто кого сильнее заденет."
    cs_narrator "Алиса повернулась к двери."
    cs_narrator "Но перед тем как войти, снова посмотрела на меня."
    cs_dv "Ладно. Спасибо."
    cs_narrator "Я удивлённо подняла бровь."
    cs_ls "За что?"
    cs_narrator "Она пожала плечами."
    cs_dv "За то, что не начала разводить панику из-за царапины."
    cs_narrator "Я слегка улыбнулась."
    cs_ls "Не за что."
    if renpy.showing("dv"):
        show dv grin pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Алиса усмехнулась."
    cs_dv "И никому не рассказывай, ладно?"
    cs_narrator "Я кивнула."
    cs_ls "Конечно."
    cs_narrator "Она посмотрела на меня ещё секунду."
    cs_narrator "Потом улыбнулась."
    cs_dv "Тогда увидимся."
    cs_ls "Увидимся."
    $ cs_actor_exit(["dv"])
    with cs_sprite_leave
    label cs_check_day03_102_alice_left_a:
    cs_narrator "Алиса вернулась внутрь."
    cs_th "Надо же."
    cs_th "Оказывается, с Алисой можно разговаривать не только на языке взаимных подколов."
    cs_th "Хотя, признаться, подколы у неё получаются неплохие."
    return
