# -*- coding: utf-8 -*-
label cs_day03_115:
    $ save_name = "Чужая смена — День 3: Развилка Мику — услышать музыку"
    cs_narrator "Мику снова разложила ноты."
    cs_mi "Слушайте, а вы можете помочь мне с одной вещью?"
    cs_narrator "Я заинтересованно посмотрела на неё."
    cs_ls "Если нужно переносить пианино, вынуждена отказаться по медицинским причинам."
    if renpy.showing("mi"):
        show mi laugh pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Мику рассмеялась."
    cs_mi "Нет-нет! Ничего переносить не нужно. Я просто хочу показать два варианта начала мелодии и понять, какой звучит лучше."
    cs_narrator "Алиса посмотрела на меня."
    cs_dv "Предупреждаю: вариантов у неё может оказаться больше двух."
    cs_narrator "Мику возмущённо повернулась."
    cs_mi "Алиса!"
    cs_narrator "Я улыбнулась."
    cs_th "Вообще-то мне действительно интересно."
    cs_th "Раньше я чаще слушала музыку уже в готовом виде."
    cs_th "А здесь можно увидеть, как она получается."
    call cs_day03_miku_arrangement_choice from cs_return_b9c1622e12eb72d338a9
    return
