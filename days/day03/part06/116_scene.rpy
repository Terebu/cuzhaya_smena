# -*- coding: utf-8 -*-
label cs_day03_116:
    $ save_name = "Чужая смена — День 3: Алиса и её гитара"
    $ cs_frame_focus(["dv"])
    with cs_sprite_change
    label cs_check_day03_116_alice_focus:
    cs_narrator "Мику вернулась к нотам."
    cs_narrator "Дарья осталась возле пианино."
    cs_narrator "Они начали тихо обсуждать расположение аккордов."
    cs_narrator "Алиса тем временем поправила ремень гитары."
    cs_narrator "Несколько раз провела по струнам."
    cs_narrator "Поморщилась."
    cs_narrator "Подкрутила колок."
    cs_narrator "И снова сыграла."
    cs_narrator "Я посмотрела на неё."
    cs_th "Вообще интересная девушка."
    # morning_alice_trust: a quiet callback, no disclosure of her visit.
    if cs_dv_medpoint_day3:
        cs_th "Утром мы уже поговорили без взаимных уколов. Теперь хотелось узнать, чем она живёт, кроме вечной готовности спорить."
    else:
        cs_th "За первые два дня мы успели обменяться несколькими замечаниями, но толком так и не поговорили."
    cs_th "В основном я видела, как она спорит с Ульяной, играет на гитаре или выражает недовольство происходящим."
    cs_th "Что, конечно, не особенно помогает узнать человека."
    cs_narrator "Алиса заметила мой взгляд."
    if cs_dv_medpoint_day3:
        cs_dv "Опять ты, Соколова? Только без комиссий."
        cs_ls "Никаких комиссий. Просто слушаю."
    else:
        cs_dv "Чего?"
    cs_narrator "Я улыбнулась."
    cs_ls "Ничего. Смотрю, как ты настраиваешь гитару."
    cs_narrator "Она прищурилась."
    cs_dv "И?"
    cs_ls "И думаю, что у меня с подобными инструментами всё заканчивается значительно быстрее."
    cs_dv "В смысле?"
    cs_narrator "Я совершенно серьёзно ответила:"
    cs_ls "Беру гитару. Понимаю, что не умею играть. Возвращаю владельцу."
    if renpy.showing("dv"):
        show dv grin pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Алиса усмехнулась."
    cs_dv "Очень насыщенная музыкальная карьера."
    cs_narrator "Я кивнула."
    cs_ls "Зато без провальных концертов."
    cs_narrator "Она рассмеялась."
    cs_dv "Ну, тут не поспоришь."
    cs_narrator "Я немного помолчала."
    cs_narrator "Потом посмотрела на её руки."
    cs_narrator "Движения были уверенными."
    cs_narrator "Она даже не особенно задумывалась, где именно должна оказаться каждая из них."
    cs_th "Вот ведь."
    cs_th "Сколько времени нужно потратить, чтобы инструмент настолько привык к тебе?"
    cs_ls "Слушай, Алиса."
    cs_narrator "Она подняла голову."
    cs_dv "Что?"
    cs_ls "А ты давно играешь?"
    cs_narrator "Она пожала плечами."
    cs_dv "Давно уже. А что?"
    cs_narrator "Я посмотрела на гитару."
    cs_ls "Да просто вчера на концерте ты выглядела так, будто даже не замечала людей вокруг."
    if renpy.showing("dv"):
        show dv smile pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Алиса чуть улыбнулась."
    cs_dv "Смотря в каком смысле."
    cs_ls "В хорошем. На концерте гитара хорошо держала ритм, даже когда зал шумел. Мне это понравилось."
    cs_narrator "Она на секунду замолчала."
    cs_narrator "Потом усмехнулась."
    cs_dv "А ты, оказывается, умеешь нормально разговаривать."
    cs_narrator "Я приложила здоровую ладонь к груди."
    cs_ls "Второй раз за утро слышу подобное. Пора пересмотреть собственную репутацию."
    if renpy.showing("dv"):
        show dv laugh pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Алиса рассмеялась."
    cs_dv "Поздно."
    cs_ls "Жестоко."
    return
