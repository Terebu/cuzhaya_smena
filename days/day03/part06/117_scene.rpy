label cs_day03_117:
    $ save_name = "Чужая смена — День 3: Первая развилка Алисы"
    cs_narrator "Алиса снова коснулась струн."
    cs_narrator "На этот раз сыграла короткую последовательность — не слишком длинную, но достаточно уверенную, чтобы я невольно прислушалась."
    cs_narrator "Она посмотрела на меня."
    cs_dv "Ну что? Нормально?"
    cs_narrator "Я задумалась."
    cs_th "Можно отделаться обычным комплиментом."
    cs_th "А можно попробовать разобраться, что она вообще хотела сыграть."
    cs_th "Кажется, Алиса не особенно любит, когда её хвалят просто ради вежливости."
    call cs_day03_alice_music_choice from cs_return_5e6200739df2964b2dc6
    return
