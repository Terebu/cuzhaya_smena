# -*- coding: utf-8 -*-
label cs_day03_117a:
    $ save_name = "Чужая смена — День 3: Разговор без обязательных комплиментов"
    cs_narrator "Я немного подумала."
    cs_ls "Слушай, а ты сейчас специально сделала переход резче, чем в первый раз?"
    cs_narrator "Алиса посмотрела на меня."
    cs_dv "Заметила?"
    cs_narrator "Я кивнула."
    cs_ls "Да. Сначала он звучал спокойнее."
    cs_narrator "Она чуть улыбнулась."
    cs_dv "Вот. Именно."
    cs_narrator "Я заинтересовалась."
    cs_ls "А зачем?"
    cs_narrator "Она поправила гитару."
    cs_dv "Чтобы не получилось слишком ровно. Иногда хочется, чтобы музыка немного цепляла."
    cs_narrator "Я задумчиво кивнула."
    cs_ls "Понимаю."
    cs_narrator "Алиса приподняла бровь."
    cs_dv "Правда?"
    cs_narrator "Я улыбнулась."
    cs_ls "Ну, у меня примерно так с рисунками. Можно сделать аккуратно, симметрично и совершенно скучно."
    cs_narrator "Она усмехнулась."
    cs_dv "Во-во."
    cs_narrator "Я посмотрела на неё."
    cs_ls "Но тут ведь тоже нужно знать меру?"
    cs_narrator "Она улыбнулась шире."
    cs_dv "Ага. Иначе получится просто шум."
    cs_narrator "Я кивнула."
    cs_ls "Значит, сходимся во мнениях."
    cs_narrator "Она снова сыграла короткий фрагмент."
    cs_narrator "Потом остановилась."
    cs_dv "А теперь?"
    cs_narrator "Я прислушалась."
    cs_ls "Сейчас интереснее."
    if renpy.showing("dv"):
        show dv grin pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Алиса усмехнулась."
    cs_dv "Вот и мне так кажется."
    cs_narrator "Я немного помолчала."
    cs_narrator "Потом спросила:"
    cs_ls "Слушай, а ты сама придумываешь такие переходы?"
    cs_narrator "Она кивнула."
    cs_dv "Иногда. Иногда подбираю то, что слышала раньше. Бывает, просто играю, пока что-нибудь нормальное не получится."
    cs_narrator "Я улыбнулась."
    cs_ls "Самый честный творческий метод из существующих."
    if renpy.showing("dv"):
        show dv laugh pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Алиса рассмеялась."
    cs_dv "А у тебя иначе?"
    cs_narrator "Я покачала головой."
    cs_ls "Примерно так же. Только у меня вместо струн карандаши. И возможность полчаса стирать одну неудачную линию."
    cs_narrator "Она посмотрела на мою повязку."
    cs_dv "Сейчас-то хоть рисовать можешь?"
    cs_narrator "Я кивнула."
    cs_ls "Здоровой рукой — вполне. А вот пытаться обнимать турник мне временно запретили."
    if renpy.showing("dv"):
        show dv grin pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Алиса усмехнулась."
    cs_dv "И правильно. Лучше уж рисуй."
    cs_narrator "Я посмотрела на неё."
    cs_ls "Какой необычный способ поддержать художника."
    cs_narrator "Она рассмеялась."
    cs_dv "Не нравится?"
    cs_narrator "Я улыбнулась."
    cs_ls "Наоборот."
    cs_narrator "Некоторое время мы молчали."
    cs_narrator "Алиса снова перебрала струны."
    cs_narrator "Затем неожиданно сказала:"
    cs_dv "Слушай, Соколова. А ты не такая зануда, как я думала."
    cs_narrator "Я замерла."
    cs_narrator "Потом медленно повернулась к ней."
    cs_ls "Алиса, я потрясена."
    cs_narrator "Она прищурилась."
    cs_dv "Чем?"
    cs_ls "Мне только что выдали характеристику, практически равнозначную государственной награде."
    if renpy.showing("dv"):
        show dv laugh pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Алиса рассмеялась."
    cs_dv "Не зазнавайся."
    cs_narrator "Я кивнула."
    cs_ls "Постараюсь."
    cs_narrator "Она посмотрела на свою гитару."
    cs_narrator "Потом на меня."
    cs_dv "Ладно. Если ещё захочешь послушать, заходи."
    cs_narrator "Я удивлённо подняла бровь."
    cs_ls "Серьёзно?"
    cs_narrator "Она пожала плечами."
    cs_dv "А чего нет? Только не мешай репетициям."
    cs_narrator "Я улыбнулась."
    cs_ls "Договорились."
    cs_th "Надо же."
    cs_th "Оказывается, с Алисой тоже можно спокойно разговаривать."
    cs_th "Особенно если слушать её ответы, а не искать повод для следующей колкости."
    return
