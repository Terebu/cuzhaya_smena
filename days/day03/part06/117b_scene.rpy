label cs_day03_117b:
    $ save_name = "Чужая смена — День 3: Просто послушать"
    cs_narrator "Я улыбнулась."
    cs_ls "Звучит хорошо."
    cs_narrator "Алиса посмотрела на меня."
    cs_dv "И всё?"
    cs_narrator "Я кивнула."
    cs_ls "А что ещё требуется? Письменная рецензия?"
    cs_narrator "Она усмехнулась."
    cs_dv "Нет уж, спасибо."
    cs_narrator "Я рассмеялась."
    cs_ls "Тогда считай, что музыкальная комиссия одобрила."
    cs_narrator "Алиса покачала головой."
    cs_narrator "Но тоже улыбнулась."
    cs_narrator "Она вернулась к гитаре."
    cs_narrator "Я ещё немного послушала."
    cs_narrator "Затем отошла к Дарье и Мику."
    cs_th "В конце концов, у Алисы тоже есть право спокойно заниматься своим делом."
    return
