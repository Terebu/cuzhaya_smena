# -*- coding: utf-8 -*-
label cs_day03_119a:
    $ save_name = "Чужая смена — День 3: Разговор двух художниц"
    cs_narrator "Я посмотрела на рисунок ещё раз."
    cs_ls "Слушай, а тебе самой какая часть больше всего нравится?"
    cs_narrator "Тихонова удивилась."
    cs_un "В каком смысле?"
    cs_narrator "Я немного улыбнулась."
    cs_ls "Ну, когда я рисую, почти всегда есть что-то, что получилось именно так, как хотелось. Даже если остальное ещё нужно доделывать."
    cs_narrator "Она задумалась."
    cs_narrator "Потом указала карандашом на центральную часть рисунка."
    cs_un "Наверное, вот здесь."
    cs_narrator "Я наклонилась чуть ближе."
    cs_narrator "Она показала на сцену."
    cs_un "Мне хотелось, чтобы было понятно, что все смотрят на выступление. Но при этом не делать людей просто одинаковыми силуэтами."
    cs_narrator "Я кивнула."
    cs_ls "Да. И у тебя уже получается."
    cs_narrator "Тихонова посмотрела на меня."
    cs_un "Ты правда так думаешь?"
    cs_ls "Конечно. Если хочешь, могу сказать, что бы я попробовала изменить."
    cs_narrator "Она немного помолчала."
    cs_narrator "Потом осторожно кивнула."
    cs_un "Скажи."
    cs_narrator "Я посмотрела на рисунок."
    cs_th "Так."
    cs_th "Главное — не начать лекцию на двадцать минут."
    cs_th "Здесь не художественная академия."
    cs_ls "Я бы попробовала чуть сильнее выделить передний план. Тогда будет лучше чувствоваться расстояние до сцены."
    cs_narrator "Тихонова снова посмотрела на лист."
    cs_un "Темнее сделать?"
    cs_narrator "Я кивнула."
    cs_ls "Может быть. Или добавить немного деталей ближе к зрителю. Но это просто вариант."
    cs_narrator "Она задумалась."
    cs_narrator "Потом осторожно провела несколько линий."
    cs_narrator "Отложила карандаш."
    cs_narrator "Посмотрела ещё раз."
    cs_un "Хм."
    cs_narrator "Я улыбнулась."
    cs_ls "Что?"
    if renpy.showing("un"):
        show un smile pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Она немного улыбнулась."
    cs_un "Кажется, правда лучше."
    cs_narrator "Я кивнула."
    cs_ls "Вот и хорошо."
    cs_narrator "Некоторое время она рассматривала рисунок."
    cs_narrator "Потом спросила:"
    cs_un "А ты что обычно рисуешь?"
    cs_narrator "Я задумалась."
    cs_ls "Разное. Людей, предметы, иногда целые сцены. Больше всего люблю, когда рисунок рассказывает маленькую историю."
    cs_narrator "Она заинтересовалась."
    cs_un "А как это?"
    cs_narrator "Я улыбнулась."
    cs_ls "Например, можно нарисовать обычную комнату. Стол, окно, кружку."
    cs_narrator "Немного помолчала."
    cs_ls "А можно добавить раскрытую книгу, недопитый чай и стул, который кто-то только что отодвинул. И уже возникает ощущение, будто человек сейчас вернётся."
    cs_narrator "Тихонова задумчиво кивнула."
    cs_un "Понимаю."
    if renpy.showing("cs_darya"):
        show cs_darya shy_smile pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья улыбнулась."
    cs_da "Лена любит такие мелочи."
    cs_narrator "Я посмотрела на неё."
    cs_ls "Ты говоришь это так, будто у меня серьёзная зависимость от предметов интерьера."
    cs_narrator "Она рассмеялась."
    cs_da "Я имела в виду, что ты внимательная."
    cs_narrator "Я немного смутилась."
    cs_ls "А. Тогда принимается."
    if renpy.showing("un"):
        show un smile pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Тихонова тихо улыбнулась."
    cs_narrator "Потом снова посмотрела на альбом."
    cs_un "Мне тоже нравится рисовать то, что запоминается."
    cs_narrator "Я кивнула."
    cs_ls "Тогда мы, кажется, в чём-то похожи."
    cs_narrator "Она чуть улыбнулась."
    cs_un "Наверное."
    if cs_friend_un >= 2:
        cs_narrator "Тихонова немного помолчала."
        cs_narrator "Потом осторожно спросила:"
        if renpy.showing("un"):
            show un shy pioneer
            $ cs_presence_stage()
            with cs_sprite_change
        label cs_check_day03_119_invitation:
        cs_un "А ты не хочешь как-нибудь порисовать вместе?"
        cs_narrator "Я заинтересованно посмотрела на неё."
        cs_ls "С удовольствием."
        if renpy.showing("un"):
            show un smile pioneer
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Она улыбнулась."
        cs_un "У меня есть ещё один альбом. И несколько карандашей."
        cs_narrator "Я посмотрела на свою повязку."
        cs_ls "Тогда только без рисования травмированной рукой. Художественный труд у меня сегодня исключительно в щадящем режиме."
        cs_narrator "Тихонова улыбнулась."
        cs_un "Хорошо."
        cs_narrator "Дарья тихо рассмеялась."
        cs_da "Только выберите время, когда Лена не будет выполнять ещё какое-нибудь поручение."
        cs_narrator "Я посмотрела на неё."
        cs_ls "Даша, ты сейчас пытаешься ограничить мою творческую занятость?"
        if renpy.showing("un"):
            show un smile pioneer
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Она улыбнулась."
        cs_da "Наоборот. Помогаю планировать."
        cs_narrator "Тихонова тихо рассмеялась."
        cs_un "Тогда, может, после обеда или завтра?"
        cs_narrator "Я кивнула."
        cs_ls "Давай решим позже. Не хочу обещать и потом исчезнуть по чужим делам."
        if renpy.showing("un"):
            show un smile pioneer
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Она улыбнулась."
        cs_un "Хорошо."
        $ cs_un_sketch_invite_day3 = True
    else:
        cs_narrator "Тихонова осторожно закрыла альбом."
        cs_un "Спасибо за совет."
        cs_narrator "Я улыбнулась."
        cs_ls "Не за что."
        cs_narrator "Немного помолчала."
        cs_ls "Если захочешь ещё что-нибудь показать, буду рада посмотреть."
        cs_narrator "Она кивнула."
        cs_un "Хорошо."
    cs_narrator "Я выпрямилась."
    cs_th "Приятно."
    cs_th "Оказывается, достаточно поговорить с человеком о том, что ему действительно нравится."
    cs_th "И не обязательно предварительно придумывать десять шуток."
    return
