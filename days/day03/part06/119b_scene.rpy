# -*- coding: utf-8 -*-
label cs_day03_119b:
    $ save_name = "Чужая смена — День 3: Не всё нужно комментировать"
    cs_narrator "Я посмотрела на рисунок."
    cs_narrator "Потом на Тихонову."
    cs_narrator "Она уже снова взяла карандаш и, кажется, собиралась продолжить."
    cs_narrator "Я улыбнулась."
    cs_ls "Не буду тебя отвлекать. У тебя хорошо получается."
    cs_narrator "Она подняла голову."
    cs_un "Спасибо."
    cs_narrator "Дарья тоже улыбнулась."
    cs_da "Удачи с рисунком."
    cs_narrator "Тихонова кивнула."
    cs_un "Спасибо."
    cs_narrator "Я уже собиралась уходить, но всё-таки добавила:"
    cs_ls "И не пытайся закончить его любой ценой прямо сейчас. Иногда полезнее отложить и посмотреть свежим взглядом."
    if renpy.showing("un"):
        show un normal pioneer
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Тихонова задумалась."
    cs_narrator "Потом слегка улыбнулась."
    cs_un "Хорошо."
    cs_narrator "Мы попрощались."
    cs_th "Всё-таки у каждого художника должно быть право спокойно порисовать, не выслушивая чужих замечаний."
    cs_th "Даже если замечания ужасно хочется высказать."
    return
