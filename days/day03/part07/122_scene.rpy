# -*- coding: utf-8 -*-
label cs_day03_122:
    $ save_name = "Чужая смена — День 3: Не нужно заполнять каждую паузу"
    stop music fadeout 3.0
    cs_narrator "Мы получили еду."
    cs_narrator "Женя направилась к привычному столу у окна."
    cs_narrator "Я пошла следом."
    cs_narrator "Но прежде чем сесть, остановилась."
    cs_ls "Можно здесь?"
    cs_narrator "Женя посмотрела на свободное место."
    cs_mz "Садись."
    cs_narrator "Я улыбнулась."
    cs_ls "Спасибо."
    cs_narrator "Устроилась так, чтобы не задевать свежую повязку."
    cs_narrator "Женя положила книгу подальше от еды."
    cs_narrator "Мы принялись обедать."
    cs_narrator "Я несколько раз посмотрела в сторону раздачи."
    cs_narrator "Дарьи всё не было."
    cs_th "Хм."
    cs_th "Наверное, Ольга Дмитриевна опять что-то уточняет."
    cs_th "Надеюсь, не требует от Даши письменного обязательства следить за моей рукой."
    cs_narrator "Я посмотрела на тарелку."
    cs_narrator "Потом на Женю."
    cs_narrator "И решила, что ждать нет смысла."
    cs_ls "Ладно."
    cs_narrator "Женя подняла голову."
    cs_mz "Что?"
    cs_ls "Ничего. Просто думала подождать Дашу, но она задержалась."
    cs_narrator "Женя кивнула."
    cs_mz "И?"
    cs_narrator "Я пожала плечами."
    cs_ls "И поем."
    cs_narrator "Она посмотрела на меня."
    cs_mz "Разумно."
    cs_ls "Вот и я так думаю."
    cs_narrator "Я вернулась к обеду."
    cs_narrator "Прошла минута."
    cs_narrator "Потом другая."
    cs_narrator "За соседним столом раздался громкий смех."
    cs_narrator "Кто-то уронил ложку."
    cs_narrator "Где-то позвали Ульяну."
    cs_narrator "А мы продолжали спокойно есть."
    cs_th "Приятно."
    cs_th "Не приходится говорить только ради того, чтобы человек не подумал, будто с тобой что-то не так."
    cs_narrator "Женя наконец отложила ложку."
    cs_narrator "Посмотрела на меня."
    cs_mz "Ты сегодня действительно какая-то тихая."
    cs_narrator "Я подняла глаза."
    cs_ls "Бывает."
    cs_mz "Вчера было иначе."
    cs_narrator "Я задумалась."
    cs_ls "Вчера у меня было больше поводов нервничать."
    cs_narrator "Женя чуть нахмурилась."
    cs_mz "А сегодня уже нет?"
    cs_narrator "Я посмотрела в окно."
    cs_th "Поводы-то никуда не делись."
    cs_th "Автобус не появился."
    cs_th "Дорога по-прежнему ведёт себя так, будто её проектировал человек с весьма своеобразным чувством юмора."
    cs_th "И я всё ещё понятия не имею, что нас ждёт дальше."
    cs_ls "Есть. Просто сегодня я не хочу думать о них каждую минуту."
    cs_narrator "Женя кивнула."
    cs_mz "Понятно."
    cs_narrator "Я слегка улыбнулась."
    cs_ls "И вообще, мне нравится иногда молчать."
    cs_narrator "Она посмотрела на меня с лёгким удивлением."
    cs_mz "Тебе?"
    cs_narrator "Я вздохнула."
    cs_ls "Удивительно, какая у меня сложилась репутация."
    if renpy.showing("cs_zhenya"):
        show cs_zhenya shrug pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Женя усмехнулась."
    cs_mz "Ты сама постаралась."
    cs_narrator "Я кивнула."
    cs_ls "Согласна. Претензий к автору репутации не имею."
    cs_narrator "Она тихо рассмеялась."
    cs_narrator "Потом снова взяла ложку."
    return
