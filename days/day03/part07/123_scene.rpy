# -*- coding: utf-8 -*-
label cs_day03_123:
    $ save_name = "Чужая смена — День 3: Библиотека — это не одиночество"
    cs_narrator "Некоторое время мы снова молчали."
    cs_narrator "Я почти доела котлету."
    cs_narrator "Женя спокойно пила чай."
    cs_narrator "И вдруг мне пришла в голову мысль."
    cs_ls "Слушай, а ты обычно одна обедаешь потому, что так удобнее?"
    cs_narrator "Женя посмотрела на меня."
    cs_mz "В основном."
    cs_narrator "Я кивнула."
    cs_ls "Понятно."
    cs_narrator "Она приподняла бровь."
    cs_mz "И всё?"
    cs_ls "А что ещё?"
    cs_mz "Обычно после таких вопросов начинают объяснять, почему мне непременно нужно сидеть с кем-нибудь."
    cs_narrator "Я немного подумала."
    cs_ls "Я не собиралась."
    cs_narrator "Она посмотрела на меня внимательнее."
    cs_mz "Правда?"
    cs_narrator "Я кивнула."
    cs_ls "Если тебе удобно есть одной, значит, удобно."
    cs_narrator "Немного помолчала."
    cs_ls "Просто хотела понять."
    cs_mz "Зачем?"
    cs_narrator "Я пожала плечами."
    cs_ls "Не люблю делать выводы за другого человека."
    if renpy.showing("cs_zhenya"):
        show cs_zhenya shrug pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Женя усмехнулась."
    cs_mz "А вчера делала."
    cs_narrator "Я посмотрела на неё."
    cs_narrator "Потом вздохнула."
    cs_ls "Вчера я иногда вела себя как полная дурочка."
    cs_narrator "Женя неожиданно фыркнула."
    cs_narrator "Я чуть улыбнулась."
    cs_ls "Сегодня тоже могу. Просто стараюсь выбирать подходящий момент."
    if cs_friend_mz >= 1:
        cs_narrator "Женя негромко рассмеялась."
    else:
        cs_narrator "Женя фыркнула и спрятала улыбку за чашкой."
    cs_narrator "Я довольно кивнула."
    cs_ls "Вот. Значит, всё нормально."
    cs_narrator "Она покачала головой."
    cs_mz "Очень странная у тебя логика."
    cs_ls "Зато иногда работает."
    cs_narrator "Мы немного помолчали."
    cs_narrator "Потом Женя сама спросила:"
    cs_mz "А тебе зачем вообще компания?"
    cs_narrator "Я подняла взгляд."
    cs_ls "В каком смысле?"
    cs_narrator "Она посмотрела в сторону соседнего стола."
    cs_mz "Ты ведь постоянно с кем-то разговариваешь. Со Славей, Семёном, Дашей, Мику…"
    cs_narrator "Я кивнула."
    cs_mz "И при этом говоришь, что любишь тишину."
    cs_narrator "Я немного подумала."
    cs_ls "А разве одно другому мешает?"
    cs_narrator "Женя не ответила сразу."
    cs_narrator "Я продолжила:"
    cs_ls "Мне нравится общаться. Но это не значит, что я хочу делать это круглосуточно."
    cs_narrator "Немного помолчала."
    cs_ls "У меня дома можно было закрыть дверь, сесть за компьютер, порисовать. Или почитать. И никто не спрашивал бы каждые пять минут, почему я такая тихая."
    cs_narrator "Женя кивнула."
    cs_mz "Понимаю."
    cs_ls "А здесь всё время кто-то рядом."
    cs_narrator "Я посмотрела на столовую."
    cs_ls "Это не плохо. Просто иногда утомляет."
    if renpy.showing("cs_zhenya"):
        show cs_zhenya normal pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Женя слегка улыбнулась."
    cs_mz "Мне тоже."
    cs_narrator "Я кивнула."
    cs_ls "Поэтому мне так нравится у тебя в библиотеке."
    cs_narrator "Она посмотрела внимательнее."
    cs_mz "Потому что там тихо?"
    cs_ls "И поэтому тоже."
    cs_narrator "Пауза."
    cs_ls "Там можно просто сидеть и читать. Не нужно постоянно изображать человека, который обязан всех развлекать."
    if renpy.showing("cs_zhenya"):
        show cs_zhenya thoughtful pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Женя немного помолчала."
    cs_mz "А ты считаешь, что обязана?"
    cs_narrator "Я задумалась."
    cs_th "Хороший вопрос."
    cs_th "Причём неприятно точный."
    cs_ls "Иногда мне так кажется."
    cs_narrator "Она посмотрела на меня."
    cs_ls "Когда не знаешь, что сказать, гораздо проще пошутить."
    cs_mz "Даже если шутка не нужна?"
    cs_narrator "Я улыбнулась."
    cs_ls "Особенно тогда."
    cs_narrator "Женя кивнула."
    cs_mz "Бывает."
    cs_narrator "Некоторое время мы просто сидели."
    cs_narrator "Я посмотрела в окно."
    cs_narrator "Потом снова на неё."
    cs_ls "Поэтому, если я иногда буду приходить просто почитать, ты не против?"
    if cs_friend_mz >= 3:
        cs_narrator "Женя посмотрела на меня."
        cs_mz "Соколова, ты уже второй день приходишь ко мне читать."
        cs_narrator "Я кивнула."
        cs_ls "Есть такое."
        cs_mz "И я ещё ни разу тебя не выгнала."
        cs_narrator "Я задумалась."
        cs_ls "Очень убедительная статистика."
        cs_narrator "Она усмехнулась."
        cs_mz "В общем, приходи."
        cs_narrator "Потом немного помолчала."
        cs_mz "И можешь занимать стол возле дальнего окна. Там обычно никто не сидит."
        cs_narrator "Я удивлённо посмотрела на неё."
        cs_ls "Серьёзно?"
        cs_narrator "Она кивнула."
        cs_mz "Да. Только книги потом убирай."
        cs_narrator "Я улыбнулась."
        cs_ls "Договорились."
        if renpy.showing("cs_zhenya"):
            show cs_zhenya glasses_touch pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Женя поправила очки."
        cs_mz "И не воспринимай это как персональный кабинет."
        cs_narrator "Я кивнула."
        cs_ls "Значит, именную табличку пока заказывать рано."
        cs_narrator "Она фыркнула."
        cs_mz "Даже не думай."
        cs_narrator "Я тихо рассмеялась."
        $ cs_pov_begin()
        with cs_sprite_leave
        cs_th "Надо же."
        cs_th "У меня, кажется, появилось собственное место в библиотеке."
        cs_th "Не по документам."
        cs_th "Не по распоряжению вожатой."
        cs_th "Просто потому, что Женя предложила."
        $ cs_mz_quiet_reading_place_day3 = True
    elif cs_friend_mz >= 1:
        cs_narrator "Женя немного подумала."
        cs_mz "Не против. Если будешь спокойно читать, мне это не мешает."
        cs_narrator "Я улыбнулась."
        cs_ls "Хорошо."
        cs_narrator "Она посмотрела на меня."
        cs_mz "Только если понадобится помощь, спрашивай. Не нужно сидеть и гадать, где какая книга."
        cs_narrator "Я кивнула."
        cs_ls "Договорились."
        cs_th "Пожалуй, для Жени это уже довольно серьёзное предложение."
    else:
        cs_narrator "Женя пожала плечами."
        cs_mz "Библиотека для того и существует. Приходи в часы работы, бери книги и читай."
        cs_narrator "Я кивнула."
        cs_ls "Вполне устраивает."
        cs_mz "Только не устраивай там своих выступлений."
        cs_narrator "Я улыбнулась."
        cs_ls "В библиотеке — никаких выступлений."
        cs_narrator "Она кивнула."
        cs_mz "Вот и хорошо."
    $ cs_pov_end()
    with cs_sprite_change
    cs_narrator "Я вернулась к обеду."
    cs_narrator "Несколько секунд мы молчали."
    cs_narrator "А потом Женя неожиданно добавила:"
    cs_mz "И вообще, Соколова…"
    cs_narrator "Я подняла голову."
    cs_ls "Да?"
    if cs_friend_mz >= 1:
        cs_mz "Ты не мешаешь, когда просто сидишь рядом."
    else:
        cs_mz "Если ты спокойно читаешь, мне это не мешает. Правда."
    cs_narrator "Я посмотрела на неё."
    cs_narrator "Она сказала это совершенно обыкновенным тоном."
    cs_narrator "Будто речь шла о расписании библиотеки."
    cs_narrator "Но мне почему-то стало тепло."
    cs_ls "Спасибо."
    cs_narrator "Она кивнула."
    cs_mz "Пожалуйста."
    cs_narrator "Я снова посмотрела в окно."
    $ cs_pov_begin()
    with cs_sprite_leave
    cs_th "Вот и всё."
    cs_th "Иногда даже не требуется ничего особенного."
    cs_th "Достаточно знать, что твоё присутствие кому-то не в тягость."
    return
