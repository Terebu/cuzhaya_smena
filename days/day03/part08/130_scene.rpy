# -*- coding: utf-8 -*-
label cs_day03_130:
    $ save_name = "Чужая смена — День 3: Литературная экспертиза"
    if cs_day03_novel_selected:
        cs_narrator "Роман уже лежал передо мной. Я вернулась к отмеченной странице."
        return
    cs_narrator "Женя закончила что-то записывать."
    cs_narrator "Закрыла тетрадь."
    cs_narrator "Затем посмотрела на меня."
    if cs_mz_friend_on_arrival_day3 >= 2:
        cs_mz "Я тут кое-что для тебя подготовила."
        cs_narrator "Я заинтересованно подняла голову."
        cs_ls "Правда?"
        cs_narrator "Она взяла с края стола две книги."
        cs_narrator "Подошла ко мне."
        cs_narrator "Положила обе передо мной."
        cs_mz "Посмотри."
        cs_narrator "Я перевела взгляд с одной обложки на другую."
        cs_narrator "На первой значилось:"
        cs_narrator "Иван Гончаров. «Обыкновенная история»."
        cs_narrator "Вторая была сборником рассказов."
        cs_narrator "Я осторожно раскрыла первый том."
        cs_narrator "Полистала несколько страниц."
        cs_ls "Почему именно эта?"
        cs_narrator "Женя устроилась возле стола."
        cs_mz "Сегодня мы говорили об историях, где важны люди и их решения. Здесь как раз можно проследить, как человек меняется."
        cs_narrator "Я кивнула."
        cs_mz "Здесь как раз об этом. Человек приезжает в большой город с одними представлениями о жизни, а потом постепенно сталкивается с тем, что всё устроено несколько сложнее."
        cs_narrator "Я посмотрела на обложку."
        cs_th "Хм."
        cs_th "Звучит подозрительно актуально."
        cs_ls "Неплохое начало."
        if renpy.showing("cs_zhenya"):
            show cs_zhenya normal pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Женя слегка улыбнулась."
        cs_mz "Только предупреждаю: книга не самая быстрая."
        cs_narrator "Я усмехнулась."
        cs_ls "Женя, я способна потратить несколько часов на один рисунок. Медленный темп меня не пугает."
        cs_narrator "Она кивнула."
        cs_mz "Тогда попробуй."
        cs_narrator "Я взяла роман."
        cs_ls "Доверюсь твоему вкусу."
        cs_narrator "Она посмотрела на меня чуть внимательнее."
        cs_mz "И не будешь выбирать по обложке?"
        cs_narrator "Я задумалась."
        cs_ls "А можно сначала высказать претензии к её оформлению?"
        cs_narrator "Женя вздохнула."
        cs_mz "Соколова."
        cs_narrator "Я улыбнулась."
        cs_ls "Шучу. Начну с текста."
    elif cs_mz_friend_on_arrival_day3 == 1:
        cs_narrator "Женя подошла к книжному шкафу."
        cs_narrator "Достала несколько томов."
        cs_mz "Хочешь попробовать историю про людей и их решения?"
        cs_narrator "Я кивнула."
        cs_ls "Да."
        cs_narrator "Она протянула мне книгу."
        cs_mz "Тогда попробуй «Обыкновенную историю»."
        cs_narrator "Я посмотрела на обложку."
        cs_ls "Гончаров?"
        cs_mz "Он самый."
        cs_narrator "Я немного улыбнулась."
        cs_ls "Хорошо. А почему именно он?"
        cs_narrator "Женя посмотрела на меня."
        cs_mz "Потому что там люди спорят не только друг с другом, но и с собственными представлениями о жизни."
        cs_narrator "Я задумалась."
        cs_ls "Звучит интересно."
        cs_mz "Тогда читай."
    else:
        cs_narrator "Я подошла к полке с русской классикой."
        cs_narrator "Несколько минут изучала корешки."
        cs_narrator "Затем достала знакомый том."
        cs_narrator "«Обыкновенная история»."
        cs_narrator "Открыла первые страницы."
        cs_narrator "Заинтересовалась."
        cs_narrator "Вернулась к столу Жени."
        cs_ls "Можно почитать эту здесь?"
        cs_narrator "Она взглянула на обложку."
        cs_mz "Можно. Если решишь унести с собой, подойди — запишу выдачу."
        cs_narrator "Я передала ей книгу."
        cs_narrator "Она проверила переплёт и вернула мне том."
        cs_mz "Если не понравится, выберешь другую."
        cs_narrator "Я кивнула."
        cs_ls "Договорились."
    cs_narrator "Я вернулась к своему столу."
    cs_narrator "Положила книгу перед собой."
    cs_narrator "Осторожно перелистнула первую страницу."
    cs_th "Что ж."
    cs_th "Посмотрим, чем ты собираешься меня удивлять, товарищ Гончаров."
    $ cs_day03_novel_selected = True
    $ cs_day03_reading_book_selected = True
    $ cs_day03_reading_book_id = "goncharov_ordinary_story"
    $ cs_day03_reading_book_location = "library_reading_table"
    label cs_check_day03_130_selected:
    pass
    return
