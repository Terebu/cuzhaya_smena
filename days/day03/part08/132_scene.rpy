# -*- coding: utf-8 -*-
label cs_day03_132:
    $ save_name = "Чужая смена — День 3: Славя и трудовая дисциплина"
    cs_narrator "Минут через двадцать дверь снова открылась."
    cs_narrator "Я не сразу подняла голову."
    cs_narrator "Сначала закончила абзац."
    cs_narrator "Положила между страницами закладку."
    cs_narrator "И только после этого посмотрела на вход."
    $ cs_frame_focus(["cs_zhenya", "sl"])
    with cs_sprite_change
    cs_narrator "Славя."
    cs_narrator "Ну конечно."
    cs_narrator "Человек, который, вероятно, даже отдыхает по заранее утверждённому графику."
    cs_sl "Женя, привет!"
    cs_narrator "Женя подняла голову."
    cs_mz "Привет. Что нужно?"
    cs_narrator "Славя подошла к столу."
    cs_sl "Ольга Дмитриевна просила уточнить, какие книги ещё не вернули после прошлой недели."
    cs_narrator "Женя кивнула."
    cs_mz "Сейчас посмотрю."
    cs_narrator "Она открыла журнал."
    cs_narrator "Славя тем временем заметила меня."
    cs_narrator "Улыбнулась."
    cs_sl "О, Лена! Ты здесь!"
    cs_narrator "Я кивнула."
    cs_ls "Привет."
    cs_narrator "Она посмотрела на книгу."
    cs_sl "Читаешь?"
    cs_narrator "Я слегка улыбнулась."
    cs_ls "Не поверишь, но в библиотеке мне иногда приходит в голову именно это занятие."
    cs_narrator "Славя рассмеялась."
    cs_sl "С тобой никогда не знаешь."
    cs_narrator "Я покачала головой."
    cs_ls "Вот уж незаслуженная характеристика."
    cs_narrator "Она посмотрела на мою повязку."
    cs_sl "Рука как?"
    cs_ls "Лучше. Виола сказала, что всё нормально, если не пытаться снова изображать спортсменку."
    cs_narrator "Славя кивнула."
    cs_sl "И правильно."
    cs_narrator "Я задумалась."
    cs_ls "Слушай, у меня предложение."
    cs_narrator "Она заинтересовалась."
    cs_sl "Какое?"
    cs_ls "Давай введём правило: каждый житель лагеря может напоминать мне про локоть не чаще одного раза в день."
    cs_narrator "Славя рассмеялась."
    cs_sl "А если забудешь беречь его?"
    cs_narrator "Я вздохнула."
    cs_ls "Тогда придётся расширять полномочия контролирующих органов."
    cs_narrator "Женя, не отрываясь от журнала, заметила:"
    cs_mz "Я бы сразу установила два напоминания."
    cs_narrator "Я медленно повернулась к ней."
    cs_narrator "Вот это уже организованная коалиция."
    cs_ls "Женя, я вижу, библиотека тоже решила участвовать в надзоре."
    cs_narrator "Она слегка улыбнулась."
    cs_mz "Исключительно в профилактических целях."
    cs_narrator "Славя засмеялась."
    cs_narrator "Я покачала головой."
    cs_ls "Прекрасно. Даже здесь нет спасения от административного аппарата."
    if cs_friend_sl >= 2 and cs_helped_sl_day3:
        cs_narrator "Славя посмотрела на меня чуть внимательнее."
        cs_sl "Кстати, спасибо за сегодняшнюю помощь. Ольга Дмитриевна уже спрашивала, кто помог с инвентарём."
        cs_narrator "Я приподняла бровь."
        cs_ls "Надеюсь, ты сообщила, что у лагеря появился новый высококвалифицированный специалист по подсчёту лент?"
        cs_narrator "Она улыбнулась."
        cs_sl "Сказала, что вы с Дашей очень помогли."
        cs_narrator "Я кивнула."
        cs_ls "Значит, официальная версия даже лучше моей."
        cs_narrator "Славя рассмеялась."
    else:
        cs_narrator "Славя улыбнулась."
        cs_sl "Ладно, не буду тебе мешать."
        cs_ls "Спасибо."
    cs_narrator "Женя нашла нужную страницу."
    cs_narrator "Повернула журнал к Славе."
    cs_narrator "Они несколько минут обсуждали записи."
    cs_narrator "Я снова открыла книгу."
    cs_narrator "Всё-таки приятно смотреть, как люди занимаются совершенно обычными вещами."
    cs_narrator "Без загадок."
    cs_narrator "Без невероятных происшествий."
    cs_narrator "Даже отсутствие двух библиотечных книг здесь пока не является частью великого заговора."
    $ cs_actor_exit(["sl"])
    with cs_sprite_leave
    cs_narrator "Славя вскоре попрощалась."
    cs_narrator "Женя вернулась к работе."
    cs_narrator "Я — к чтению."
    $ cs_reflective_focus()
    with cs_sprite_leave
    return
