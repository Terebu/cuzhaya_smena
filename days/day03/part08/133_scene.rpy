# -*- coding: utf-8 -*-
label cs_day03_133:
    $ save_name = "Чужая смена — День 3: Цена решений"
    play music cs_day_music_home fadein 2.0
    $ renpy.music.set_volume(0.08,delay=1.0,channel="music")
    cs_narrator "Прошёл ещё примерно час."
    cs_narrator "Я постепенно втянулась."
    cs_narrator "История оказалась интереснее, чем показалась на первых страницах."
    cs_narrator "Меня особенно занимало то, как герои объясняли собственные поступки."
    cs_narrator "Иногда очень убедительно."
    cs_narrator "Иногда настолько удобно для себя, что мне хотелось остановить одного из них и спросить:"
    cs_narrator "Мужчина, а вы точно сами себе верите?"
    cs_narrator "Я усмехнулась."
    cs_narrator "И тут услышала знакомый голос."
    $ cs_pov_end()
    with cs_sprite_change
    $ cs_frame_focus(["cs_zhenya"])
    with cs_sprite_change
    cs_mz "Соколова."
    cs_narrator "Я подняла голову."
    cs_narrator "Она стояла возле стола."
    cs_ls "Да?"
    cs_narrator "Женя посмотрела на книгу."
    cs_mz "Ну как?"
    cs_narrator "Я осторожно положила закладку между страницами."
    cs_narrator "Закрыла том."
    cs_ls "Пока нравится."
    cs_narrator "Она приподняла бровь."
    cs_mz "Почему?"
    cs_narrator "Я задумалась."
    cs_ls "Персонажи интересные. Особенно потому, что они совершенно по-разному объясняют себе одни и те же вещи."
    cs_narrator "Женя кивнула."
    cs_mz "И кто тебе больше нравится?"
    cs_narrator "Я немного помолчала."
    cs_ls "Пока никто настолько, чтобы полностью с ним соглашаться."
    cs_narrator "Она слегка улыбнулась."
    cs_mz "Неплохой ответ."
    cs_narrator "Я посмотрела на книгу."
    cs_ls "Мне кажется, Александр слишком уверен, что мир должен оправдать его ожидания."
    cs_narrator "Женя кивнула."
    cs_ls "Но и дядя у него не обязательно прав только потому, что старше и считает себя практичным человеком."
    cs_narrator "Она заинтересованно посмотрела на меня."
    cs_mz "А ты бы кого послушала?"
    cs_narrator "Я задумалась."
    cs_narrator "Прекрасно."
    cs_narrator "Литературный вопрос незаметно превратился в философский."
    cs_ls "Наверное, обоих. А потом постаралась бы не повторять их ошибок."
    if renpy.showing("cs_zhenya"):
        show cs_zhenya shrug pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Женя усмехнулась."
    cs_mz "Легко сказать."
    cs_ls "Очень легко. Именно поэтому я пока говорю, а не демонстрирую."
    cs_narrator "Она тихо рассмеялась."
    cs_narrator "Потом спросила:"
    cs_mz "А что тебе не нравится?"
    cs_narrator "Я посмотрела на обложку."
    cs_narrator "Немного подумала."
    cs_ls "Пока история кажется слишком аккуратной."
    cs_mz "В каком смысле?"
    cs_ls "Я ещё не чувствую, какую цену персонажам придётся заплатить за собственные решения."
    cs_narrator "Она посмотрела на меня внимательнее."
    cs_mz "Тебе обязательно нужна какая-то цена?"
    cs_narrator "Я слегка улыбнулась."
    cs_ls "Не обязательно. Но если человек действительно меняется, обычно ему приходится от чего-то отказываться."
    cs_narrator "Женя ничего не ответила."
    cs_narrator "Я продолжила:"
    cs_ls "От прежних убеждений. От привычной жизни. Иногда от людей."
    cs_narrator "Немного помолчала."
    cs_ls "И после этого уже не всегда получается вернуться туда, где всё начиналось."
    cs_narrator "Женя посмотрела на меня."
    cs_mz "Интересно рассуждаешь."
    cs_narrator "Я пожала плечами."
    cs_ls "Просто люблю такие истории."
    cs_narrator "Она кивнула на роман."
    cs_mz "Тогда дочитай."
    cs_narrator "Я улыбнулась."
    cs_ls "Уже заинтриговала."
    cs_narrator "Женя чуть улыбнулась."
    cs_mz "И никаких подсказок."
    cs_ls "Вот теперь ты говоришь как ответственный представитель книжной индустрии."
    cs_narrator "Она покачала головой."
    cs_narrator "Но улыбалась."
    $ cs_pov_begin()
    with cs_sprite_leave
    cs_narrator "В этот момент я вдруг поймала себя на мысли, что сказала больше, чем собиралась."
    cs_th "Решения имеют цену."
    cs_th "Очень удобная фраза, пока речь идёт о вымышленных героях."
    cs_th "А если подумать о нас с Дашей?"
    cs_th "Мы ведь тоже сделали один совершенно обычный выбор."
    cs_th "Сели в автобус."
    cs_th "Уснули."
    cs_th "А проснулись здесь."
    cs_th "И я до сих пор не знаю, получится ли вернуться."
    cs_narrator "Я посмотрела в окно."
    cs_narrator "На солнечную дорожку."
    cs_narrator "На деревья."
    cs_narrator "На пионеров, проходивших мимо."
    cs_th "Не сейчас."
    cs_th "Соколова, мы договорились."
    cs_th "Сегодня — книги."
    cs_th "Не поиски выхода."
    $ cs_pov_end()
    with cs_sprite_change
    cs_narrator "Женя заметила мою задумчивость."
    cs_mz "Что?"
    cs_narrator "Я повернулась."
    if cs_mz_friend_on_arrival_day3 >= 1:
        cs_ls "Ничего. Просто подумала, что ты удачно выбрала книгу."
    else:
        cs_ls "Ничего. Просто подумала, что удачно взяла именно эту книгу."
    cs_narrator "Она посмотрела на меня."
    cs_mz "Рада слышать."
    return
