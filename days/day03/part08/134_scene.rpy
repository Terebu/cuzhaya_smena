# -*- coding: utf-8 -*-
label cs_day03_134:
    $ save_name = "Чужая смена — День 3: Развилка — разговор о книге"
    cs_narrator "Женя уже собиралась вернуться к рабочему столу. Я посмотрела на книгу, потом на неё. Можно продолжить чтение."
    if cs_mz_friend_on_arrival_day3 >= 1:
        cs_narrator "А можно немного подробнее поговорить о том, почему именно она выбрала эту историю."
    else:
        cs_narrator "А можно подробнее поговорить о том, что ей самой нравится в этой истории."
    cs_narrator "Ведь мне действительно интересно её мнение. Не для того, чтобы понравиться. Просто потому, что мы смотрим на книги немного по-разному."
    return
