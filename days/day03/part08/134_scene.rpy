# -*- coding: utf-8 -*-
label cs_day03_134:
    $ save_name = "Чужая смена — День 3: Развилка — разговор о книге"
    cs_narrator "Женя уже собиралась вернуться к рабочему столу."
    cs_narrator "Я посмотрела на книгу."
    cs_narrator "Потом на неё."
    cs_narrator "Можно продолжить чтение."
    if cs_mz_friend_on_arrival_day3 >= 1:
        cs_narrator "А можно немного подробнее поговорить о том, почему именно она выбрала эту историю."
    else:
        cs_narrator "А можно подробнее поговорить о том, что ей самой нравится в этой истории."
    cs_narrator "Ведь мне действительно интересно её мнение."
    cs_narrator "Не для того, чтобы понравиться."
    cs_narrator "Просто потому, что мы смотрим на книги немного по-разному."
    return
