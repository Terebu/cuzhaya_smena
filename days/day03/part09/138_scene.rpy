# -*- coding: utf-8 -*-
label cs_day03_138:
    $ save_name = "Чужая смена — День 3: Три человека и довольно странная дружба"
    cs_narrator "Некоторое время мы сидели молча."
    cs_narrator "Семён снова посмотрел в сторону деревьев."
    cs_narrator "Дарья поправила юбку."
    cs_narrator "Я осторожно устроила книгу на коленях, чтобы не задеть повреждённый локоть."
    cs_narrator "Вот ведь."
    cs_narrator "Сидим втроём на лавочке в советском пионерлагере."
    cs_narrator "Совершенно обычная картина."
    cs_narrator "Если не учитывать, что ещё совсем недавно все мы жили в других обстоятельствах."
    cs_narrator "И даже не подозревали о существовании друг друга."
    cs_narrator "Семён первым нарушил молчание."
    cs_sy "Ну и как тебе библиотека?"
    cs_narrator "Я повернулась."
    cs_ls "Отлично."
    cs_sy "Женя не выгнала?"
    cs_narrator "Я посмотрела на него с лёгким возмущением."
    cs_ls "Семён, почему вы все считаете, что моё появление в общественном учреждении обязательно заканчивается конфликтом?"
    cs_narrator "Он усмехнулся."
    cs_sy "Есть определённый опыт наблюдений."
    cs_narrator "Дарья тихо рассмеялась."
    cs_narrator "Я задумалась."
    cs_ls "Признаю, статистика за первые два дня несколько испортила мне репутацию."
    cs_narrator "Семён кивнул."
    cs_sy "Несколько?"
    cs_narrator "Я вздохнула."
    cs_ls "Какой же ты сегодня придирчивый."
    cs_narrator "Он улыбнулся."
    cs_sy "Учусь у тебя."
    cs_narrator "Я медленно повернулась к Дарье."
    cs_ls "Вот. Ещё один пострадавший от моего воспитательного воздействия."
    if renpy.showing("cs_darya"):
        show cs_darya shrug pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья покачала головой."
    cs_da "Скоро от тебя начнут защищать весь лагерь."
    cs_narrator "Я кивнула."
    cs_ls "Предлагаю создать комиссию."
    if renpy.showing("cs_semen"):
        show cs_semen relaxed pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Семён рассмеялся."
    cs_narrator "Затем указал на книгу."
    cs_sy "А читаешь что?"
    cs_narrator "Я подняла роман."
    cs_ls "Гончарова. «Обыкновенная история»."
    cs_narrator "Он заинтересовался."
    cs_sy "И как?"
    cs_narrator "Я посмотрела на обложку."
    cs_ls "Пока интересно. Особенно тем, как люди умудряются быть уверенными в собственной правоте, даже когда очевидно противоречат сами себе."
    if renpy.showing("cs_semen"):
        show cs_semen smile pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Семён усмехнулся."
    cs_sy "Звучит жизненно."
    cs_ls "Ещё как."
    cs_narrator "Я чуть улыбнулась."
    if cs_mz_friend_on_arrival_day3 >= 1:
        cs_ls "И самое главное — Женя сама подобрала книгу."
    else:
        cs_ls "Сама нашла на полке. И, кажется, удачно."
    if cs_mz_open_library_invitation_day3:
        if renpy.showing("cs_darya"):
            show cs_darya shy_smile pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Дарья улыбнулась."
        cs_da "Она ещё и разрешила Лене приходить просто посидеть."
        cs_narrator "Семён удивлённо посмотрел на меня."
        cs_sy "Сама?"
        cs_narrator "Я довольно кивнула."
        cs_ls "Именно."
        cs_narrator "Он задумался."
        cs_narrator "Потом усмехнулся."
        cs_sy "Ничего себе. Ты действительно сумела найти с ней общий язык."
        cs_narrator "Я улыбнулась."
        cs_ls "Представь себе. Причём весьма неожиданным способом."
        cs_sy "Каким?"
        cs_ls "Перестала непрерывно разговаривать."
        cs_narrator "Он посмотрел на меня."
        cs_narrator "Затем на Дарью."
        cs_narrator "Потом снова на меня."
        cs_sy "Подожди. То есть ты умеешь?"
        if renpy.showing("cs_darya"):
            show cs_darya amused pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Дарья рассмеялась."
        cs_narrator "Я приложила здоровую руку к груди."
        cs_ls "Знаешь, Семён, сегодня ты уже второй человек, который оскорбляет мои интеллектуальные и социальные способности."
        cs_narrator "Он усмехнулся."
        cs_sy "А первый кто?"
        cs_narrator "Я посмотрела на Дарью."
        cs_ls "Догадайся."
        cs_narrator "Она улыбнулась."
        cs_da "Возражений не имею."
    elif cs_mz_friend_on_arrival_day3 >= 2:
        cs_narrator "Я улыбнулась."
        cs_ls "Она запомнила, какие книги мне нравятся. Даже немного удивительно."
        cs_narrator "Семён кивнул."
        cs_sy "Значит, сдружились."
        cs_narrator "Я немного подумала."
        cs_ls "Думаю, да. Постепенно."
        cs_narrator "Он улыбнулся."
        cs_sy "Хорошо."
    else:
        cs_narrator "Я посмотрела на книгу."
        cs_ls "Пока просто ходим друг к другу на литературные консультации."
        if renpy.showing("cs_semen"):
            show cs_semen smile pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Семён усмехнулся."
        cs_sy "Звучит солидно."
        cs_ls "Спасибо. Стараюсь поддерживать репутацию культурного человека."
    cs_narrator "Семён некоторое время смотрел на меня."
    cs_narrator "Потом вдруг спросил:"
    cs_sy "Слушай, а почему с Женей ты ведёшь себя тихо, а со мной постоянно шутишь?"
    cs_narrator "Я задумалась."
    cs_narrator "Хороший вопрос."
    cs_narrator "И, кажется, вполне заслуженный."
    cs_ls "Наверное, потому что с тобой проще шутить."
    cs_narrator "Он приподнял бровь."
    cs_sy "Очень сомнительный комплимент."
    cs_narrator "Я улыбнулась."
    cs_ls "А я и не сказала, что это комплимент."
    cs_narrator "Дарья тихо рассмеялась."
    cs_narrator "Семён покачал головой."
    cs_narrator "Я немного помолчала."
    cs_narrator "Потом добавила уже спокойнее:"
    cs_ls "Просто ты отвечаешь. Иногда даже лучше, чем я ожидаю."
    cs_narrator "Он усмехнулся."
    cs_sy "Значит, я сам виноват?"
    cs_narrator "Я покачала головой."
    cs_ls "Нет. Не в этом смысле."
    cs_narrator "Посмотрела на него."
    cs_ls "Мне нравится с тобой разговаривать. Но если какие-то шутки тебе неприятны, достаточно сказать."
    cs_narrator "Семён замолчал."
    cs_narrator "Кажется, такого продолжения он не ожидал."
    cs_sy "Я же говорил."
    cs_narrator "Я кивнула."
    cs_ls "Да. И я услышала."
    cs_narrator "Он посмотрел на меня внимательнее."
    cs_narrator "Потом чуть улыбнулся."
    cs_sy "Тогда хорошо."
    cs_narrator "Немного помолчал."
    cs_sy "А то я уже начал думать, что у тебя на меня личная подписка."
    cs_narrator "Я улыбнулась."
    cs_ls "Есть. Но теперь с возможностью настройки уведомлений."
    cs_narrator "Он рассмеялся."
    cs_narrator "Дарья тоже."
    cs_narrator "Вот."
    cs_narrator "Совсем другое дело."
    cs_narrator "Можно шутить и при этом не пытаться загнать человека в угол."
    cs_narrator "Странно, что мне понадобилось столько времени, чтобы окончательно это понять."
    return
