# -*- coding: utf-8 -*-
label cs_day03_147:
    $ save_name = "Чужая смена — День 3: Человек имеет право читать"
    cs_narrator "Первое время Даша ещё перекладывала вещи."
    cs_narrator "Открыла шкаф."
    cs_narrator "Достала чистую рубашку."
    cs_narrator "Положила обратно."
    cs_narrator "Потом вернулась к тетради."
    cs_narrator "Я тем временем читала."
    if cs_mz_friend_on_arrival_day3 >= 2:
        cs_narrator "И с каждой страницей всё сильнее убеждалась, что Женя выбрала произведение не случайно."
    else:
        cs_narrator "И с каждой страницей всё сильнее убеждалась, что удачно взяла именно этот роман."
    cs_narrator "Забавно."
    if cs_mz_day3_honest_book_talk:
        cs_narrator "В библиотеке мы обсуждали с ней то, как люди меняются под воздействием обстоятельств."
    else:
        cs_narrator "В библиотеке я уже успела задуматься о том, как обстоятельства меняют людей."
    cs_narrator "А теперь я читаю о человеке, который пытается примирить собственные идеалы с совершенно другим представлением о жизни."
    cs_narrator "Какое неприятное совпадение."
    cs_narrator "Я перевернула страницу."
    cs_narrator "Дарья отложила тетрадь."
    $ cs_pov_end()
    with cs_sprite_change
    cs_da "Лен."
    cs_narrator "Я не сразу подняла глаза."
    cs_narrator "Сначала дочитала предложение."
    cs_ls "М?"
    cs_da "А если я сейчас куда-нибудь уйду?"
    cs_narrator "Я посмотрела на неё."
    cs_ls "Куда?"
    cs_narrator "Она пожала плечами."
    cs_da "Не знаю. Просто погулять."
    cs_narrator "Я кивнула."
    cs_ls "Хорошо."
    if renpy.showing("cs_darya"):
        show cs_darya serious pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья прищурилась."
    cs_da "И всё?"
    cs_narrator "Я немного подумала."
    cs_ls "А что ещё?"
    cs_narrator "Она посмотрела на книгу."
    cs_narrator "Потом на меня."
    cs_da "Ты даже не спросишь, с кем?"
    cs_narrator "Я улыбнулась."
    cs_ls "Если хочешь рассказать — расскажешь."
    cs_narrator "Она на секунду замолчала."
    cs_da "А если я уйду к Мику?"
    cs_narrator "Я кивнула."
    cs_ls "Тогда передавай привет."
    cs_da "А к Алисе?"
    cs_narrator "Я задумалась."
    cs_ls "Тогда передавай привет, но приготовься к тому, что она спросит, зачем я его передаю."
    if renpy.showing("cs_darya"):
        show cs_darya amused pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья рассмеялась."
    cs_narrator "Потом немного помолчала."
    cs_da "То есть ты правда не против?"
    cs_narrator "Я закрыла книгу пальцем, сохраняя страницу."
    cs_narrator "Посмотрела на неё внимательнее."
    cs_ls "Даш, конечно, не против."
    cs_narrator "Она улыбнулась."
    cs_ls "Мы же не обязаны постоянно ходить вместе. Ты можешь заниматься своими делами, я — своими."
    cs_narrator "Немного помолчала."
    cs_ls "Просто скажи, если собираешься надолго. Чтобы я не начала тебя искать."
    cs_narrator "Дарья кивнула."
    cs_da "Хорошо."
    cs_narrator "Я улыбнулась."
    cs_ls "Иначе придётся организовывать поисковую экспедицию. А после вчерашнего мне подобные мероприятия временно противопоказаны."
    cs_narrator "Она рассмеялась."
    cs_da "Ладно. Договорились."
    cs_narrator "Я снова открыла книгу."
    cs_narrator "Некоторое время мы молчали."
    cs_narrator "Потом Даша неожиданно спросила:"
    cs_da "А если я никуда не пойду?"
    cs_narrator "Я подняла взгляд."
    cs_ls "Тогда останешься здесь."
    cs_da "И не буду тебе мешать?"
    cs_narrator "Я немного удивилась."
    cs_ls "Нет."
    cs_narrator "Она посмотрела на меня."
    cs_narrator "Я продолжила:"
    cs_ls "Мне не нужно, чтобы ты исчезала каждый раз, когда я хочу почитать."
    cs_narrator "Дарья чуть улыбнулась."
    cs_da "Просто ты так увлечённо читаешь."
    cs_narrator "Я посмотрела на книгу."
    cs_narrator "Потом на неё."
    cs_ls "Потому что интересно."
    cs_narrator "Пауза."
    cs_ls "Но твоё присутствие мне не мешает."
    cs_narrator "Она некоторое время молчала."
    cs_narrator "Затем кивнула."
    cs_da "Хорошо."
    cs_narrator "И вернулась к своей тетради."
    if not cs_reflective_shot:
        $ cs_pov_begin()
        with cs_sprite_leave
    cs_narrator "Вот."
    cs_narrator "Всё достаточно просто."
    cs_narrator "Можно сидеть рядом."
    cs_narrator "Не требовать друг от друга постоянного внимания."
    cs_narrator "И при этом совершенно не чувствовать себя одинокими."
    return
