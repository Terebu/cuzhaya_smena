# -*- coding: utf-8 -*-
label cs_day03_148a:
    $ save_name = "Чужая смена — День 3: Музыка, о которой не обязательно рассказывать"
    $ cs_pov_end()
    with cs_sprite_change
    cs_narrator "Я положила закладку между страницами."
    cs_narrator "Закрыла книгу."
    cs_narrator "Дарья заметила движение."
    cs_narrator "Подняла голову."
    cs_da "Всё? Гончаров закончился?"
    cs_narrator "Я посмотрела на неё."
    cs_ls "Нет. Решила, что литературе придётся немного подождать."
    cs_narrator "Она улыбнулась."
    cs_da "Какая честь."
    cs_narrator "Я кивнула."
    cs_ls "Пользуйся моментом. Подобные события происходят не каждый день."
    cs_narrator "Она рассмеялась."
    cs_narrator "Я отложила роман."
    cs_narrator "Посмотрела на тетрадь."
    cs_ls "Как у тебя сегодня прошло с Мику?"
    cs_narrator "Дарья немного удивилась."
    cs_da "Хорошо."
    cs_narrator "Я улыбнулась."
    cs_ls "Это я уже слышала. А подробнее?"
    cs_narrator "Она посмотрела на карандаш."
    cs_narrator "Потом на меня."
    cs_da "Мы сначала ещё раз попробовали то вступление, которое обсуждали утром."
    cs_narrator "Я кивнула."
    cs_ls "То самое, где Мику выбирала между двумя вариантами?"
    cs_da "Да. Потом немного изменили переход."
    cs_narrator "Она задумалась."
    cs_da "И я попыталась вспомнить одну старую мелодию."
    cs_narrator "Я заинтересовалась."
    cs_ls "Получилось?"
    if renpy.showing("cs_darya"):
        show cs_darya shrug pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья пожала плечами."
    cs_da "Не сразу."
    cs_narrator "Она чуть улыбнулась."
    cs_da "Сначала пальцы вообще не хотели слушаться. Потом постепенно вспомнила."
    cs_narrator "Я кивнула."
    cs_ls "Знакомое ощущение. Когда долго не рисуешь, рука тоже начинает вести себя так, будто карандаш ей выдали впервые."
    cs_narrator "Она рассмеялась."
    cs_da "Вот примерно так."
    cs_narrator "Немного помолчала."
    cs_narrator "Потом добавила:"
    cs_da "Странно, конечно. Я думала, что почти всё забыла."
    cs_ls "А оказалось?"
    cs_narrator "Она улыбнулась."
    cs_da "Что не всё."
    cs_narrator "Я посмотрела на неё."
    cs_ls "Тебе ведь действительно нравится играть."
    cs_narrator "Дарья ненадолго задумалась."
    cs_narrator "Затем кивнула."
    cs_da "Да."
    cs_narrator "Пауза."
    cs_da "Просто я очень давно не занималась нормально. И как-то постепенно перестала об этом думать."
    cs_narrator "Я улыбнулась."
    cs_ls "А теперь снова вспомнила."
    cs_da "Получается, так."
    cs_narrator "Я чуть наклонила голову."
    cs_ls "Тогда почему бы не продолжить?"
    cs_narrator "Она посмотрела на меня."
    cs_da "Ты предлагаешь мне заниматься музыкой каждый день?"
    cs_narrator "Я задумалась."
    cs_ls "Если самой хочется."
    cs_narrator "Немного помолчала."
    cs_ls "Только без превращения хобби в обязательный труд. А то я знаю, чем это заканчивается."
    if renpy.showing("cs_darya"):
        show cs_darya shy_smile pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья улыбнулась."
    cs_da "Чем?"
    cs_narrator "Я посмотрела в сторону своего блокнота."
    cs_ls "Сначала рисуешь для удовольствия. Потом начинаешь составлять себе расписание. А потом в один прекрасный день обнаруживаешь, что даже отдых у тебя находится в списке задач."
    if renpy.showing("cs_darya"):
        show cs_darya amused pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья рассмеялась."
    cs_da "Звучит знакомо."
    cs_narrator "Я кивнула."
    cs_ls "Вот именно."
    if cs_friend_mi >= 2 and cs_mi_day3_arrangement_help:
        cs_narrator "Дарья вспомнила что-то."
        cs_da "Кстати, Мику сегодня несколько раз упоминала твоё замечание про мелодию."
        cs_narrator "Я удивилась."
        cs_ls "Серьёзно?"
        cs_narrator "Она кивнула."
        cs_da "Да. Говорила, что сравнение с рисунком помогло ей понять, чего именно она хочет от вступления."
        cs_narrator "Я улыбнулась."
        cs_ls "Надо же. Моё художественное образование оказалось применимо в музыке."
        if renpy.showing("cs_darya"):
            show cs_darya amused pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Дарья рассмеялась."
        cs_da "Похоже на то."
    if cs_dv_music_talk_day3 and cs_friend_dv >= 2:
        cs_narrator "Дарья добавила:"
        cs_da "А Алиса, между прочим, тоже вспоминала тебя."
        cs_narrator "Я подняла бровь."
        cs_ls "Надеюсь, без составления списка моих недостатков?"
        cs_da "Она сказала, что ты хотя бы слушаешь, прежде чем давать советы."
        cs_narrator "Я замолчала."
        cs_narrator "Потом медленно улыбнулась."
        cs_ls "Какая неожиданно высокая оценка."
        cs_narrator "Дарья кивнула."
        cs_da "Для Алисы — очень высокая."
        cs_narrator "Я усмехнулась."
        cs_ls "Надо будет поблагодарить. Желательно так, чтобы она не передумала."
    cs_narrator "Некоторое время мы сидели молча."
    cs_narrator "Дарья снова взяла карандаш."
    cs_narrator "Посмотрела на свои записи."
    cs_narrator "Затем повернулась ко мне."
    cs_da "Спасибо."
    cs_narrator "Я удивилась."
    cs_ls "За что?"
    cs_narrator "Она чуть улыбнулась."
    cs_da "За то, что спросила."
    cs_narrator "Я немного помолчала."
    cs_narrator "Потом улыбнулась в ответ."
    cs_ls "Не за что."
    cs_narrator "Дарья посмотрела на тетрадь."
    cs_da "Просто обычно, когда я говорю, что умею играть, люди сразу начинают просить что-нибудь исполнить."
    cs_narrator "Я задумалась."
    cs_ls "А тебе не всегда хочется?"
    cs_narrator "Она покачала головой."
    cs_da "Не всегда."
    cs_narrator "Я кивнула."
    cs_ls "Понимаю. У художников примерно то же самое."
    cs_narrator "Она улыбнулась."
    cs_da "Серьёзно?"
    cs_ls "Конечно. Стоит кому-нибудь узнать, что умеешь рисовать, как появляется замечательная просьба: «А нарисуй меня»."
    if renpy.showing("cs_darya"):
        show cs_darya amused pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья рассмеялась."
    cs_narrator "Я продолжила совершенно серьёзно:"
    cs_ls "Желательно бесплатно. Желательно за пять минут. И чтобы красиво."
    cs_narrator "Она засмеялась ещё сильнее."
    cs_da "Ужас."
    cs_narrator "Я кивнула."
    cs_ls "Поэтому официально обещаю: не буду требовать концертов по первому запросу."
    cs_narrator "Дарья посмотрела на меня."
    cs_narrator "Улыбнулась."
    cs_da "Договорились."
    cs_narrator "Вот и хорошо."
    cs_narrator "Кажется, мы снова узнали друг о друге что-то важное."
    cs_narrator "Без громких признаний."
    cs_narrator "Просто поговорили о том, что нам нравится."
    return
