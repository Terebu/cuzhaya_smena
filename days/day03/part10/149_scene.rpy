# -*- coding: utf-8 -*-
label cs_day03_149:
    $ save_name = "Чужая смена — День 3: У Гончарова тоже были проблемы с людьми"
    if not cs_reflective_shot:
        $ cs_pov_begin()
        with cs_sprite_leave
    cs_th "Я снова открыла роман."
    cs_th "Несколько минут понадобилось, чтобы вернуться к повествованию."
    cs_th "Сначала я перечитала предыдущий абзац."
    cs_th "Потом ещё один."
    cs_th "Наконец вспомнила, на чём остановилась."
    cs_th "Так."
    cs_th "Продолжаем наблюдать за тем, как люди с совершенно разными представлениями о жизни пытаются убедить друг друга в собственной правоте."
    cs_th "Весьма увлекательное занятие."
    cs_th "Особенно если учесть, что в обычной жизни подобные разговоры часто заканчиваются куда быстрее."
    cs_th "Я перевернула страницу."
    cs_th "В какой-то момент поймала себя на том, что почти спорю с одним из персонажей."
    cs_th "Мысленно, конечно."
    cs_th "Нет, ну прекрасно."
    cs_th "Ты только что сам всё объяснил."
    cs_th "И теперь собираешься сделать ровно то, чего делать не следует."
    cs_th "Я нахмурилась."
    cs_th "Прочитала следующий абзац."
    cs_th "Ага."
    cs_th "Разумеется."
    cs_th "Именно это ты и сделал."
    cs_th "Я тихо выдохнула."
    cs_ls "Ну ты и идиот."
    cs_th "Со стороны окна раздалось:"
    $ cs_pov_end()
    with cs_sprite_change
    cs_da "Кто?"
    cs_th "Я подняла голову."
    cs_th "Дарья смотрела на меня с лёгким интересом."
    cs_ls "Один литературный гражданин."
    cs_th "Она улыбнулась."
    cs_da "Что натворил?"
    cs_th "Я посмотрела на книгу."
    cs_th "Потом на неё."
    cs_ls "Принял крайне сомнительное решение, имея все необходимые условия, чтобы его не принимать."
    if renpy.showing("cs_darya"):
        show cs_darya amused pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_th "Дарья рассмеялась."
    cs_da "Звучит знакомо."
    cs_th "Я прищурилась."
    cs_ls "Это сейчас был намёк на мою вчерашнюю прогулку?"
    cs_th "Она совершенно невинно пожала плечами."
    cs_da "А я ничего такого не говорила."
    cs_th "Я медленно кивнула."
    cs_ls "Понимаю. В этом доме становится всё труднее защищать собственную репутацию."
    if renpy.showing("cs_darya"):
        show cs_darya shy_smile pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_th "Дарья улыбнулась."
    cs_da "Расскажешь, что там случилось?"
    cs_th "Я немного подумала."
    cs_th "Потом покачала головой."
    cs_ls "Лучше когда дочитаю. Не хочу пересказывать половину истории, не зная, к чему она приведёт."
    cs_th "Дарья кивнула."
    cs_da "Хорошо."
    cs_th "Я снова посмотрела на страницу."
    cs_ls "Хотя, если коротко, человек настолько уверен в собственной правоте, что перестаёт замечать очевидные вещи."
    if renpy.showing("cs_darya"):
        show cs_darya thinking pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_th "Дарья задумалась."
    cs_da "И тебе это не нравится?"
    cs_th "Я улыбнулась."
    cs_ls "Как читателю — очень нравится. Как человеку, которому приходится наблюдать последствия, — хочется стукнуть его по голове учебником."
    cs_th "Она рассмеялась."
    cs_da "Желательно не той рукой."
    cs_th "Я посмотрела на повязку."
    cs_th "Потом на неё."
    cs_ls "Даже мои литературные фантазии теперь проходят медицинскую проверку."
    cs_th "Она довольно улыбнулась."
    cs_da "Кто-то же должен."
    cs_th "Я покачала головой."
    if not cs_reflective_shot:
        $ cs_pov_begin()
        with cs_sprite_leave
    cs_th "И снова вернулась к чтению."
    if cs_mz_friend_on_arrival_day3 >= 1:
        cs_th "Всё-таки Женя действительно удачно выбрала роман."
    else:
        cs_th "Всё-таки роман попался удачный."
    if cs_mz_friend_on_arrival_day3 >= 2:
        cs_th "Причём выбрала именно для меня."
        cs_th "Не просто выдала первую попавшуюся книгу."
        cs_th "А запомнила, что мне нравятся истории, в которых персонажи не делятся на хороших и плохих."
    if cs_mz_day3_honest_book_talk:
        cs_th "Интересно будет потом обсудить с ней следующую главу."
        cs_th "Особенно учитывая, что мы уже не сошлись во мнениях по поводу некоторых поступков героев."
        cs_th "Пожалуй, из этого может получиться хороший разговор."
    else:
        cs_th "Надо будет хотя бы сказать ей, чем всё закончится для моего терпения."
        cs_th "Пока что персонажи испытывают его с завидным упорством."
    cs_th "Я перевернула страницу."
    cs_th "Потом следующую."
    cs_th "Постепенно чтение снова захватило всё внимание."
    return
