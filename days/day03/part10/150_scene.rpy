# -*- coding: utf-8 -*-
label cs_day03_150:
    $ save_name = "Чужая смена — День 3: Человек не обязан исчезать, чтобы не мешать"
    if not cs_reflective_shot:
        $ cs_pov_begin()
        with cs_sprite_leave
    stop music fadeout 3.0
    if cs_un_sketch_completed_day3 == False:
        cs_narrator "Прошло ещё довольно много времени."
        cs_narrator "Я успела прочитать несколько глав."
        cs_narrator "За окном постепенно изменилось освещение."
        cs_narrator "Солнечные полосы на полу стали длиннее."
        cs_narrator "Воздух в комнате уже не был таким жарким."
    else:
        cs_narrator "После рисования времени на книгу оставалось немного."
        cs_narrator "Но мне вполне хватило его, чтобы снова погрузиться в историю."
        cs_narrator "Солнце за окном уже начинало клониться к горизонту."
    cs_narrator "В какой-то момент мне захотелось переменить положение."
    cs_narrator "Я чуть повернулась."
    cs_narrator "И почти сразу почувствовала неприятное натяжение в локте."
    cs_narrator "Ай."
    cs_narrator "Прекрасно."
    cs_narrator "Оказывается, даже неподвижное чтение можно организовать с нарушением техники безопасности."
    cs_narrator "Я осторожно выпрямилась."
    cs_narrator "Положила книгу на колени."
    $ cs_pov_end()
    with cs_sprite_change
    cs_narrator "Дарья заметила."
    cs_da "Рука?"
    cs_narrator "Я кивнула."
    cs_ls "Немного затекла."
    cs_narrator "Она посмотрела на меня внимательнее."
    cs_da "Ты засиделась в неудобной позе."
    cs_narrator "Я задумалась."
    cs_ls "Неужели литература признана вредной для здоровья?"
    if renpy.showing("cs_darya"):
        show cs_darya shy_smile pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья улыбнулась."
    cs_da "Нет. Просто не нужно сидеть в одной позе до ужина."
    cs_narrator "Я посмотрела на локоть."
    cs_narrator "Потом на неё."
    cs_ls "Справедливо."
    cs_narrator "Она немного удивилась."
    cs_da "Даже не споришь?"
    cs_narrator "Я осторожно встала."
    cs_ls "А что спорить? Локоть уже высказал собственное мнение."
    if renpy.showing("cs_darya"):
        show cs_darya amused pioneer normal
        $ cs_presence_stage()
        with cs_sprite_change
    cs_narrator "Дарья рассмеялась."
    cs_narrator "Я немного прошлась по комнате."
    cs_narrator "Осторожно размяла плечи, не трогая повязку."
    cs_narrator "Потом остановилась возле окна."
    cs_narrator "Снаружи всё ещё было светло."
    cs_narrator "По дорожке прошли двое пионеров."
    cs_narrator "Где-то вдалеке раздался смех."
    if not cs_reflective_shot:
        $ cs_pov_begin()
        with cs_sprite_leave
    cs_narrator "Странно."
    cs_narrator "Ещё совсем недавно я бы непременно предложила куда-нибудь отправиться."
    cs_narrator "Выйти на площадь."
    cs_narrator "Заглянуть к клубам."
    cs_narrator "Найти Семёна и сообщить ему какую-нибудь чрезвычайно важную глупость."
    cs_narrator "А сейчас мне хотелось просто остаться здесь."
    $ cs_pov_end()
    with cs_sprite_change
    cs_narrator "Я посмотрела на Дарью."
    cs_narrator "Она снова сидела у окна."
    cs_ls "Даш."
    cs_narrator "Она подняла голову."
    cs_da "М?"
    cs_narrator "Я немного помолчала."
    cs_ls "Тебе здесь удобно?"
    cs_narrator "Она посмотрела вокруг."
    cs_narrator "Потом на меня."
    cs_da "В домике?"
    cs_narrator "Я кивнула."
    cs_ls "Ага."
    cs_narrator "Она задумалась."
    cs_da "Уже да."
    cs_narrator "Я улыбнулась."
    cs_ls "Тоже привыкаешь?"
    cs_da "Наверное."
    cs_narrator "Она посмотрела в окно."
    cs_da "Сначала всё казалось чужим. А теперь хотя бы знаешь, где что лежит."
    cs_narrator "Я кивнула."
    cs_ls "И на какую половицу лучше не наступать ночью."
    cs_narrator "Дарья засмеялась."
    cs_da "Именно."
    cs_narrator "Немного помолчала."
    cs_narrator "Потом добавила:"
    cs_da "Хотя иногда всё равно хочется домой."
    cs_narrator "Я посмотрела на неё."
    cs_narrator "Улыбка стала спокойнее."
    cs_ls "Мне тоже."
    cs_narrator "Некоторое время мы молчали."
    cs_narrator "За окном прошёл ветер."
    cs_narrator "Колыхнулась занавеска."
    if not cs_reflective_shot:
        $ cs_pov_begin()
        with cs_sprite_leave
    cs_th "Москва."
    cs_th "Квартира."
    cs_th "Мой компьютер."
    cs_th "Планшет."
    cs_narrator "Привычная комната, в которой каждая вещь находится там, где я её оставила."
    cs_narrator "Ну, почти каждая."
    cs_narrator "Некоторые карандаши, конечно, существовали по собственным законам физики."
    cs_narrator "Я чуть улыбнулась."
    $ cs_pov_end()
    with cs_sprite_change
    cs_da "О чём думаешь?"
    cs_narrator "Я посмотрела на неё."
    cs_ls "О доме."
    cs_narrator "Она кивнула."
    cs_narrator "Я продолжила:"
    cs_ls "Но здесь, знаешь, тоже начинает становиться уютно."
    cs_narrator "Дарья посмотрела вокруг."
    cs_da "Из-за домика?"
    cs_narrator "Я немного задумалась."
    cs_ls "Не только."
    cs_narrator "Посмотрела на книгу."
    cs_narrator "На блокнот."
    cs_narrator "На её тетрадь."
    cs_narrator "Потом снова на Дашу."
    cs_ls "Наверное, потому что здесь можно просто заниматься своими делами."
    cs_narrator "Она чуть улыбнулась."
    cs_da "И тебе никто не мешает."
    cs_narrator "Я кивнула."
    cs_ls "Да."
    cs_narrator "Пауза."
    cs_ls "Хотя дело даже не в этом."
    cs_narrator "Дарья посмотрела внимательнее."
    cs_da "А в чём?"
    cs_narrator "Я немного помолчала."
    cs_narrator "Как бы сказать, чтобы опять не превратить всё в какую-нибудь дурацкую шутку?"
    cs_ls "Мне нравится, что мы можем находиться рядом и не чувствовать необходимости постоянно разговаривать."
    cs_narrator "Дарья несколько секунд смотрела на меня."
    cs_narrator "Затем улыбнулась."
    cs_da "Мне тоже."
    cs_narrator "Я кивнула."
    cs_narrator "Потом добавила:"
    cs_ls "Это даже немного непривычно."
    cs_narrator "Она приподняла бровь."
    cs_da "Почему?"
    cs_narrator "Я задумалась."
    cs_ls "Потому что обычно, когда проводишь с кем-то много времени, рано или поздно начинаешь переживать, что человеку станет скучно."
    cs_narrator "Дарья кивнула."
    cs_ls "А с тобой почему-то не хочется об этом думать."
    cs_narrator "Она улыбнулась чуть мягче."
    cs_da "Мне с тобой не скучно, Лен."
    cs_narrator "Я посмотрела на неё."
    cs_narrator "Потом чуть улыбнулась."
    cs_ls "Даже когда я молчу и читаю Гончарова?"
    cs_narrator "Дарья кивнула."
    cs_da "Даже тогда."
    cs_narrator "Я задумалась."
    cs_narrator "Затем совершенно серьёзно произнесла:"
    cs_ls "Опасное признание. Теперь я могу начать читать ещё чаще."
    cs_narrator "Она рассмеялась."
    cs_da "Переживу."
    cs_narrator "Я тоже улыбнулась."
    cs_narrator "И вернулась к кровати."
    if not cs_reflective_shot:
        $ cs_pov_begin()
        with cs_sprite_leave
    cs_narrator "Вот и хорошо."
    cs_narrator "Не обязательно всё время быть смешной."
    cs_narrator "Не обязательно непрерывно разговаривать."
    cs_narrator "И совершенно необязательно делать из каждой минуты маленькое представление."
    cs_narrator "Иногда достаточно того, что рядом есть человек, с которым спокойно."
    return
