# -*- coding: utf-8 -*-
label cs_day03_154:
    $ save_name = "Чужая смена — День 3: Ужин и последний котлетный ресурс"
    if cs_mz_dinner_friend_on_arrival is None:
        $ cs_mz_dinner_friend_on_arrival = cs_friend_mz
    $ sunset_time()
    $ persistent.sprite_time = "sunset"
    $ cs_day03_darya_destination = "dining_hall"
    $ cs_director_scene("bg ext_dining_hall_near_sunset")
    scene bg ext_dining_hall_near_sunset
    $ cs_frame_focus(["cs_darya"])
    with Dissolve(0.7)
    play ambience "sound/ambiences/camp_center_evening.ogg" fadeout 1.5 fadein 1.5
    play music cs_day_music_home fadeout 2.0 fadein 2.0
    $ renpy.music.set_volume(0.08,delay=1.0,channel="music")
    cs_narrator "К столовой мы подошли вместе с основной волной лагеря. Пионеры постепенно собирались у входа, переговаривались и пытались выяснить, чем сегодня будут кормить. Ульяна уже успела проскочить мимо нас."
    cs_narrator "Причём с такой скоростью, будто объявили чрезвычайное положение и последний котлетный ресурс Советского Союза должен был достаться исключительно самому быстрому. Я проводила её взглядом."
    cs_th "Вот. Настоящая пионерская дисциплина. Никаких сомнений. Никаких промедлений."
    cs_th "Только решительный бросок к общественному питанию."
    cs_narrator "Даша заметила мою улыбку."
    cs_da "Что?"
    cs_narrator "Я кивнула в сторону Ульяны."
    cs_ls "Смотри. Человек совершенно правильно расставил жизненные приоритеты."
    cs_narrator "Она рассмеялась."
    cs_da "А ты будто не хотела ужинать."
    cs_ls "Хотела. Но считаю, что к ужину следует подходить с достоинством."
    cs_narrator "Даша посмотрела на меня."
    cs_da "Ты ещё несколько минут назад спорила с книгой."
    cs_narrator "Я замолчала."
    cs_th "Так. Об этом моменте биографии можно было бы и не вспоминать."
    cs_ls "Это была литературная дискуссия. Прошу не путать с нарушением общественного порядка."
    cs_narrator "Даша покачала головой. Но улыбалась. Мы подошли ближе. Я машинально начала искать знакомых."
    cs_narrator "Славя разговаривала с несколькими пионерами возле входа. Мику оживлённо что-то рассказывала Алисе. Та слушала с таким видом, будто пыталась решить, сколько ещё музыкальных предложений способна выдержать до ужина. Семён стоял немного в стороне."
    cs_narrator "Я заметила его взгляд."
    $ cs_frame_focus(["cs_semen", "cs_darya"])
    with cs_sprite_change
    cs_narrator "Он увидел меня. Прищурился. Я невинно улыбнулась. Он покачал головой."
    cs_th "Прекрасно. Теперь человеку достаточно просто увидеть меня, чтобы начать подозревать нарушение собственного душевного спокойствия."
    if cs_friend_se >= 2 and cs_se_day3_personal_talk:
        cs_narrator "Семён неожиданно сам поднял руку."
        cs_sy "Соколова! Без представлений сегодня?"
        cs_narrator "Я остановилась. Посмотрела на него."
        cs_ls "Вообще-то я сейчас в отпуске от культурно-массовой деятельности."
        cs_narrator "Он усмехнулся."
        cs_sy "Вот и отлично."
        cs_ls "Но если руководство лагеря потребует, придётся вернуться на сцену."
        if renpy.showing("cs_semen"):
            show cs_semen smile pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Семён рассмеялся."
        cs_sy "Даже не надейся."
        cs_narrator "Я улыбнулась."
        cs_th "Надо же. Он уже сам начинает разговор. Причём без предварительной попытки сбежать."
    else:
        cs_narrator "Семён коротко кивнул нам. Я ответила тем же."
        cs_th "Не буду сегодня испытывать его терпение. У человека тоже должен быть выходной."
    $ cs_actor_exit(["cs_semen"])
    with cs_sprite_leave
    cs_narrator "А потом я увидела знакомые очки. Женя. Она стояла немного в стороне от входа. С книгой под мышкой."
    cs_narrator "И терпеливо ждала, когда основная толпа наконец перестанет выяснять, кто пойдёт первым. Я сразу замедлила шаг. Даша проследила за моим взглядом. Улыбнулась."
    cs_da "Нашла?"
    cs_ls "Ага."
    cs_da "Пойдём поздороваемся?"
    cs_narrator "Я посмотрела на Женю."
    cs_ls "Конечно."
    cs_narrator "Даша чуть усмехнулась."
    cs_da "И никаких торжественных речей?"
    cs_ls "Даша, неужели ты считаешь, что я неспособна просто поздороваться с человеком?"
    cs_narrator "Она посмотрела на меня."
    cs_da "Ты действительно хочешь, чтобы я ответила?"
    cs_narrator "Я вздохнула."
    cs_ls "Вопрос снимается."
    cs_narrator "Мы направились к Жене."
    if not cs_reflective_shot:
        $ cs_pov_begin()
        with cs_sprite_leave
    cs_th "Вообще-то за сегодняшний день я действительно стала спокойнее. Не потому, что перестала любить шутить. Просто постепенно начала понимать, кому какие шутки нравятся. Семёну можно устроить небольшой спектакль, если не перегибать."
    cs_th "С Алисой иногда лучше сразу говорить по существу. Мику с удовольствием поддержит практически любую тему. А Женя…"
    cs_narrator "Я слегка улыбнулась."
    cs_th "Женя предпочитает, чтобы рядом с ней не пытались непрерывно устраивать цирк. Вполне разумное требование."
    return
