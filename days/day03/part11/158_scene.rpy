# -*- coding: utf-8 -*-
label cs_day03_158:
    $ save_name = "Чужая смена — День 3: Не нужно быть двумя разными людьми"
    if cs_mz_dinner_friend_on_arrival >= 1:
        cs_narrator "Некоторое время мы снова молчали. Потом Женя неожиданно спросила:"
        cs_mz "Слушай, Соколова."
        cs_narrator "Я подняла взгляд."
        cs_ls "Да?"
        cs_narrator "Она немного задумалась."
        cs_mz "А ты всегда такая?"
        cs_narrator "Я приподняла бровь."
        cs_ls "Какая именно?"
        cs_mz "Разная."
        cs_narrator "Я остановилась. Посмотрела на неё."
        cs_ls "В каком смысле?"
        cs_narrator "Женя пожала плечами."
        cs_mz "То молчишь по полчаса, то устраиваешь представление на всю площадь."
        cs_ls "А. Вот ты о чём."
        if renpy.showing("cs_darya"):
            show cs_darya shy_smile pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Даша улыбнулась."
        cs_da "Я ей сегодня то же самое говорила."
        cs_narrator "Я посмотрела на неё."
        cs_ls "Прекрасно. Меня обсуждают всем столом."
        if renpy.showing("cs_zhenya"):
            show cs_zhenya shrug pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Женя усмехнулась."
        cs_mz "Не уходи от вопроса."
        cs_narrator "Я улыбнулась. Потом немного помолчала."
        cs_th "Вообще-то вопрос нормальный. И ответ у меня вполне простой."
        cs_ls "Наверное, да. Я всегда такой была."
        cs_narrator "Женя посмотрела внимательнее."
        cs_ls "Просто с разными людьми мне комфортно вести себя по-разному."
        cs_narrator "Она кивнула."
        cs_mz "То есть со мной тебе хочется молчать?"
        cs_ls "Иногда."
        cs_narrator "Потом добавила:"
        cs_ls "А иногда разговаривать. Например, о книгах."
        cs_narrator "Женя чуть улыбнулась."
        cs_ls "Главное, что я не чувствую необходимости постоянно придумывать, чем тебя развлечь."
        cs_narrator "Она посмотрела на меня."
        cs_mz "И правильно."
        cs_ls "Вот именно."
        cs_narrator "Даша задумчиво посмотрела на нас."
        cs_da "А с Семёном?"
        cs_narrator "Я усмехнулась."
        cs_ls "С Семёном иногда очень сложно удержаться."
        cs_narrator "Женя приподняла бровь."
        cs_mz "Почему?"
        cs_narrator "Я немного подумала."
        cs_ls "Он умеет отвечать так, что любая шутка становится в два раза смешнее."
        if renpy.showing("cs_darya"):
            show cs_darya amused pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Даша рассмеялась. Женя тоже улыбнулась."
        cs_mz "И ты этим пользуешься?"
        cs_ls "Иногда."
        cs_narrator "Потом добавила спокойнее:"
        if cs_se_day3_personal_talk:
            cs_ls "Но сегодня мы нормально поговорили. И договорились, что некоторые темы больше не трогаем."
        else:
            cs_ls "Но если вижу, что ему неприятно, останавливаюсь. Некоторые темы мы больше не трогаем."
        cs_narrator "Женя посмотрела на меня."
        cs_mz "Это правильно."
        cs_ls "Я тоже так думаю."
        cs_narrator "Немного помолчала."
        cs_ls "Всё-таки шутка должна быть смешной не только тому, кто её придумал."
        if renpy.showing("cs_darya"):
            show cs_darya shy_smile pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Даша улыбнулась."
        cs_da "Вот это уже разумно."
        cs_narrator "Я посмотрела на неё."
        cs_ls "Пожалуйста, не удивляйся каждый раз, когда я произношу что-то разумное."
        if renpy.showing("cs_zhenya"):
            show cs_zhenya shrug pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Женя усмехнулась."
        cs_mz "Тогда придётся делать это чаще."
        cs_narrator "Я замолчала. Медленно повернула к ней голову."
        cs_ls "Так. Подожди."
        cs_narrator "Она подняла бровь."
        cs_mz "Что?"
        cs_narrator "Я прищурилась."
        cs_ls "Ты сейчас опять меня подколола."
        cs_narrator "Она спокойно отпила чай."
        cs_mz "Возможно."
        cs_narrator "Даша не выдержала и рассмеялась. Я посмотрела на неё."
        cs_ls "Ты видишь, что происходит?"
        cs_da "Вижу."
        cs_ls "Я пришла в библиотеку за книгами. А в результате меня теперь поддевает сама библиотекарь."
        if renpy.showing("cs_zhenya"):
            show cs_zhenya normal pioneer normal
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Женя улыбнулась."
        cs_mz "Можешь написать жалобу."
        cs_narrator "Я замерла. Потом медленно кивнула."
        cs_ls "Отличная идея. Кому подавать?"
        cs_narrator "Женя совершенно невозмутимо ответила:"
        cs_mz "Мне."
        cs_narrator "Даша закрыла лицо ладонью. Я несколько секунд смотрела на Женю. Потом рассмеялась."
        cs_th "Вот ведь. И ведь совершенно не заметишь заранее, когда она решит пошутить."
        if cs_mz_hug_allowed_day3:
            cs_narrator "Женя посмотрела на меня чуть внимательнее."
            cs_mz "И, кстати…"
            cs_narrator "Я повернулась."
            cs_ls "Да?"
            cs_narrator "Она ненадолго замолчала."
            cs_mz "Насчёт того, что было перед ужином."
            cs_narrator "Я сразу стала чуть серьёзнее."
            cs_ls "Что-то не так?"
            cs_narrator "Она покачала головой."
            cs_mz "Нет. Просто… не думай, что я теперь буду обниматься с тобой каждый раз."
            cs_ls "Конечно."
            cs_narrator "Она кивнула."
            cs_mz "Хорошо."
            cs_narrator "Я помолчала."
            cs_ls "Спасибо, что разрешила."
            cs_narrator "Женя опустила взгляд на чай. Потом едва заметно улыбнулась."
            cs_mz "Не за что."
            cs_th "Вот. На этом и остановимся. Некоторые вещи становятся лучше именно тогда, когда не пытаешься немедленно превратить их в привычку."
        cs_narrator "Мы снова вернулись к ужину. И я вдруг поняла, что за сегодняшний день Женя стала разговаривать со мной гораздо свободнее. Не потому, что перестала любить тишину. И не потому, что я научилась идеально подстраиваться под её настроение."
        cs_narrator "Просто между нами постепенно появилось доверие. Она уже могла первой задать вопрос. Пошутить. Не согласиться."
        cs_narrator "И даже иногда сама продолжить разговор."
        cs_th "Пожалуй, это куда интереснее, чем просто добиться от человека улыбки."
    else:
        cs_narrator "Мы спокойно ужинали. Женя иногда отвечала на короткие вопросы, затем снова возвращалась к тарелке."
        cs_th "Не обязательно превращать каждую встречу в откровенный разговор. Пока достаточно того, что она не против нашей компании."
    return
