# -*- coding: utf-8 -*-
label cs_day03_164:
    $ save_name = "Чужая смена — День 3: Обнаружение подозрительной деятельности"
    $ cs_director_scene("bg ext_square_sunset")
    scene bg ext_square_sunset
    $ cs_frame_focus([])
    with Dissolve(0.7)
    cs_narrator "Я почти дошла до развилки, когда заметила две знакомые фигуры. Семён. И Славя. Они стояли у дорожки неподалёку от площади и о чём-то разговаривали."
    cs_narrator "Славя держала небольшой лист бумаги. Семён показывал на какую-то строчку. Судя по всему, обсуждали очередное поручение. Вполне нормальное лагерное дело."
    cs_narrator "Совершенно безобидная ситуация."
    cs_th "Так. Семён. Славя. Разговаривают."
    cs_th "В отсутствие меня."
    cs_narrator "Я остановилась. Посмотрела на них. Потом ещё раз."
    cs_th "Нет."
    cs_th "Конечно, можно спокойно пройти мимо. Я взрослый, разумный человек. Мне двадцать два года. У меня есть художественные навыки, жизненный опыт и способность принимать взвешенные решения."
    cs_narrator "Пауза."
    cs_th "Но ведь это Семён."
    cs_narrator "Я невольно улыбнулась."
    cs_th "Ладно. Одна шутка. Только одна."
    $ cs_frame_focus(["cs_semen", "sl"])
    with cs_sprite_change
    cs_narrator "Я направилась к ним."
    cs_ls "О-о-о."
    cs_narrator "Семён услышал меня первым. Обернулся. Увидел. И моментально изменился в лице."
    cs_sy "Нет."
    cs_narrator "Славя подняла голову."
    cs_sl "Что?"
    cs_narrator "Я остановилась перед ними. Приложила здоровую руку к груди. И с выражением глубоко оскорблённой женщины посмотрела на Семёна."
    cs_ls "Семён…"
    cs_narrator "Он закрыл глаза."
    cs_sy "Соколова, только не начинай."
    if cs_friend_se >= 2 and cs_se_day3_personal_talk:
        cs_narrator "Я трагически вздохнула."
        cs_ls "Стоило мне оставить тебя буквально на несколько часов…"
        cs_narrator "Славя заинтересованно посмотрела на нас."
        cs_sl "Что случилось?"
        cs_narrator "Я медленно перевела на неё взгляд."
        if cs_friend_sl >= 1:
            cs_ls "Славя, я думала, мы подруги."
        else:
            cs_ls "Славя, я ведь пришла с миром."
        cs_narrator "Она моргнула. Потом посмотрела на Семёна. И, кажется, начала понимать, что происходит."
        cs_sl "Лен, ты сейчас опять шутишь?"
        cs_narrator "Я прикрыла глаза."
        cs_ls "Моё сердце разбито, а она спрашивает, шучу ли я."
        cs_narrator "Семён вздохнул."
        cs_sy "Мы обсуждаем завтрашние поручения."
        cs_narrator "Я посмотрела на бумагу в руках Слави, потом на него."
        cs_ls "Конечно."
        cs_sy "Что «конечно»?"
        cs_ls "Очень удобное объяснение."
        if renpy.showing("sl"):
            show sl smile pioneer
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Славя улыбнулась."
        cs_sl "Лена, мы правда сверяем список работ."
        cs_narrator "Я повернулась к ней."
        cs_ls "И ты тоже участвуешь в этом заговоре?"
        cs_narrator "Она рассмеялась."
        cs_sl "Если заговор заключается в том, чтобы завтра никто не забыл принести инвентарь, тогда да."
        cs_narrator "Я замерла. Потом медленно кивнула."
        cs_ls "Вот как. Значит, всё гораздо серьёзнее, чем я думала."
        cs_narrator "Семён посмотрел на Славю."
        cs_sy "Я же говорил, что с ней невозможно разговаривать нормально."
        cs_narrator "Я приподняла бровь."
        if cs_se_day3_personal_talk:
            cs_ls "Семён, сегодня мы с тобой уже вполне нормально разговаривали."
        else:
            cs_ls "Семён, иногда мы с тобой вполне нормально разговариваем."
        cs_narrator "Он задумался."
        cs_sy "Было дело."
        cs_ls "Вот видишь. Значит, проблема возникает только тогда, когда ты попадаешь в подозрительные обстоятельства."
        if renpy.showing("sl"):
            show sl laugh pioneer
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Славя рассмеялась. Семён посмотрел на меня."
        cs_sy "Какие ещё подозрительные обстоятельства?"
        cs_narrator "Я указала на Славю."
        cs_ls "Другая девушка. Вечер. Секретные документы."
        cs_narrator "Славя посмотрела на листок, потом на меня."
        cs_sl "Лена, здесь список, кто завтра носит инвентарь."
        cs_narrator "Я несколько секунд молчала. Затем серьёзно ответила:"
        cs_ls "Особенно изощрённое прикрытие."
        cs_narrator "Славя засмеялась. Семён покачал головой."
    else:
        cs_ls "Ладно, без представления. Не буду мешать вашему совещанию."
        cs_narrator "Славя показала листок, а Семён кивнул. Я не стала продолжать шутку."
    if cs_friend_se >= 2 and cs_se_day3_personal_talk:
        cs_narrator "Семён вдруг усмехнулся."
        cs_sy "Ладно, Соколова. Раз уж ты застала нас на месте преступления, придётся признаться."
        cs_narrator "Я удивлённо подняла бровь."
        cs_ls "Ого. Добровольное признание?"
        cs_narrator "Он кивнул."
        cs_sy "Да. Мы пытались понять, почему Ольга Дмитриевна записала одно и то же поручение два раза."
        cs_narrator "Славя снова посмотрела на бумагу."
        cs_sl "Между прочим, это действительно проблема."
        cs_ls "Так. Получается, расследование всё-таки имеет предмет."
        cs_narrator "Семён улыбнулся."
        cs_sy "Только не тот, на который ты надеялась."
        cs_ls "Бывает. Следователь обязан быть готовым к неожиданностям."
    else:
        cs_narrator "Семён посмотрел на меня."
        cs_sy "Ладно, посмеялись. А теперь можно мы закончим?"
        cs_narrator "Я помолчала. Потом кивнула."
        cs_ls "Конечно. Не буду мешать."
        cs_narrator "Он удивлённо посмотрел на меня."
        cs_sy "Серьёзно?"
        cs_ls "Серьёзно. Я вообще-то за книгой иду."
        if renpy.showing("sl"):
            show sl smile pioneer
            $ cs_presence_stage()
            with cs_sprite_change
        cs_narrator "Славя улыбнулась."
        cs_sl "Тогда не задерживаем."
    cs_narrator "Я посмотрела на Семёна, потом на Славю. И задумалась."
    cs_th "Вообще-то они действительно заняты делом. А я уже несколько минут устраиваю здесь маленькую театральную постановку. Но раз уж подошла, можно хотя бы узнать, что именно у них не сходится."
    if not cs_reflective_shot:
        $ cs_pov_begin()
        with cs_sprite_leave
    return
