# -*- coding: utf-8 -*-
label cs_day03_178:
    $ save_name = "Чужая смена — День 3: Развилка — о чём стоит говорить ночью"
    cs_narrator "Мы почти дошли до поворота к домикам."
    cs_narrator "Я смотрела на дорожку."
    cs_narrator "На её руку, лежавшую рядом с моей."
    cs_narrator "На свет фонаря впереди."
    cs_narrator "И вдруг поняла, что могу сказать Даше то, о чём думала в библиотеке."
    cs_narrator "Не обязательно."
    cs_narrator "Можно оставить этот вечер таким, какой он есть."
    cs_narrator "Но, может быть, именно сейчас она меня поймёт."
    if not cs_reflective_shot:
        $ cs_pov_begin()
        with cs_sprite_leave
    cs_th "Мы обе оказались здесь."
    cs_th "Обе скучаем по дому."
    cs_th "И обе понемногу привыкаем к лагерю, хотя иногда даже не хотим себе в этом признаваться."
    return
