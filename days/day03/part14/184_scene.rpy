# -*- coding: utf-8 -*-
label cs_day03_184:
    $ save_name = "Чужая смена — День 3: Два независимых спальных государства"
    $ cs_director_scene("cs_house_lena_darya_int_night")
    scene cs_house_lena_darya_int_night
    $ cs_frame_focus([])
    with Dissolve(0.7)
    cs_narrator "Мы по очереди переоделись, давая друг другу спокойно отвернуться, и сложили форму на стуле."
    cs_narrator "Я расправила свою постель."
    cs_narrator "Даша занялась своей."
    cs_narrator "Некоторое время мы молчали."
    cs_narrator "Потом она посмотрела на меня."
    cs_da "Лен."
    cs_narrator "Я подняла голову."
    cs_ls "Да?"
    cs_narrator "Она немного улыбнулась."
    cs_da "Спасибо за сегодняшний день."
    cs_narrator "Я удивилась."
    cs_ls "За что именно?"
    cs_narrator "Она пожала плечами."
    cs_da "За всё понемногу."
    cs_narrator "Потом добавила:"
    cs_da "За то, что можно было и поговорить, и просто посидеть рядом. И что за твоими шутками всё-таки слышно тебя."
    cs_narrator "Я немного помолчала."
    cs_ls "Мне тоже понравилось."
    cs_narrator "Она улыбнулась."
    cs_narrator "Я посмотрела на наши кровати."
    cs_ls "Знаешь, даже когда мы сегодня молчали, я не чувствовала себя одиноко."
    cs_narrator "Даша кивнула."
    cs_da "И было хорошо."
    cs_narrator "Я улыбнулась."
    cs_ls "Очень."
    if cs_da_day3_shared_silence or cs_da_day3_quiet_walk:
        cs_narrator "Дарья посмотрела на меня чуть внимательнее."
        cs_da "Мне особенно понравилось, что ты не пыталась заполнить каждую паузу."
        cs_narrator "Я задумалась."
        cs_ls "Да. Оказывается, отсутствие непрерывного разговора не является нарушением правил совместного проживания."
        cs_narrator "Она рассмеялась."
        cs_da "Представляешь?"
        cs_narrator "Я улыбнулась."
        cs_ls "Придётся пересмотреть устав."
    else:
        cs_narrator "Дарья посмотрела на окно."
        cs_da "Иногда просто приятно знать, что рядом есть знакомый человек."
        cs_narrator "Я кивнула."
        cs_ls "Согласна."
    cs_narrator "Я подошла к выключателю."
    cs_ls "Свет выключать?"
    cs_narrator "Даша кивнула."
    cs_da "Давай."
    $ cs_director_scene("cs_house_lena_darya_int_sleep_night")
    scene cs_house_lena_darya_int_sleep_night
    $ cs_frame_focus([])
    with Dissolve(0.7)
    cs_narrator "Я выключила лампу."
    cs_narrator "Осторожно добралась до своей кровати."
    cs_narrator "Легла, стараясь не задеть локоть."
    cs_narrator "Даша устроилась напротив."
    cs_narrator "Несколько минут мы молчали."
    cs_narrator "Потом из темноты раздалось:"
    cs_da "Лен."
    cs_ls "М?"
    cs_da "Спокойной ночи."
    cs_narrator "Я улыбнулась."
    cs_ls "Спокойной, Даш."
    cs_narrator "Немного помолчала."
    cs_narrator "Потом добавила:"
    cs_ls "Если ночью кто-нибудь из нас украдёт чужое одеяло, прошу немедленно уведомить пострадавшую сторону."
    cs_narrator "Дарья тихо рассмеялась."
    cs_da "Лена, мы спим отдельно."
    cs_narrator "Я задумалась."
    cs_ls "Тогда риск международного конфликта минимален."
    cs_narrator "Она снова засмеялась."
    cs_narrator "Потом в комнате стало тихо."
    cs_th "Вот и всё."
    cs_th "Сегодня мы спим отдельно."
    cs_th "И это совершенно нормально."
    cs_th "Потому что между нами уже есть кое-что важнее одного совместного вечера."
    cs_th "Возможность говорить друг другу правду."
    cs_narrator "Я закрыла глаза."
    return
