# -*- coding: utf-8 -*-
label cs_day03_188:
    $ save_name = "Чужая смена — День 3: Договор на одно одеяло"
    stop music fadeout 4.0
    cs_narrator "Прошло несколько минут."
    cs_narrator "Даша почти не двигалась."
    cs_narrator "Я постепенно успокоилась."
    cs_narrator "Наконец почувствовала, что действительно начинаю засыпать."
    cs_narrator "И тут она тихо спросила:"
    cs_da "Лен."
    cs_narrator "Я сонно откликнулась."
    cs_ls "М?"
    cs_da "Только одеяло на себя целиком не перетягивай."
    cs_narrator "Я открыла глаза."
    cs_narrator "Посмотрела на край одеяла."
    cs_narrator "Потом на неё."
    cs_ls "Вот как."
    cs_narrator "Она улыбнулась."
    cs_da "Что?"
    cs_narrator "Я задумалась."
    cs_ls "То есть мы всё-таки возвращаемся к территориальным спорам."
    cs_narrator "Даша тихо рассмеялась."
    cs_da "Лена…"
    cs_narrator "Я осторожно поправила одеяло так, чтобы нам обеим было удобно."
    cs_ls "Всё. Конфликт урегулирован."
    cs_narrator "Она улыбнулась."
    cs_da "Спасибо."
    cs_narrator "Я кивнула."
    cs_ls "Пожалуйста."
    cs_narrator "Немного помолчала."
    cs_narrator "Потом добавила:"
    cs_ls "Но если ночью одеяло окажется на моей стороне, прошу считать это непреднамеренным изменением границ."
    cs_narrator "Даша рассмеялась в подушку."
    cs_da "Всё, спи уже."
    cs_narrator "Я улыбнулась."
    cs_ls "Есть."
    cs_narrator "Она чуть сжала мою руку."
    cs_narrator "Я повернулась на бок. Даша осторожно придвинулась сзади, оставив моей перевязанной руке свободное место."
    $ cs_director_scene("cs_cg_lena_darya_shared_sleep_night")
    scene cs_cg_lena_darya_shared_sleep_night
    $ cs_frame_focus([])
    with Dissolve(0.7)
    $ cs_da_shared_sleep_cg_seen_day3 = True
    cs_narrator "Я закрыла глаза."
    cs_th "Вот и всё."
    cs_th "Первый раз с момента попадания в «Совёнок» я засыпаю рядом с Дашей."
    cs_th "Не потому, что так было написано в каком-то плане."
    cs_th "Не потому, что кто-то из нас обязан был согласиться."
    cs_th "Просто сегодня мы обе этого захотели."
    cs_narrator "Я прислушалась к её дыханию."
    cs_narrator "Постепенно мысли стали путаться."
    cs_th "Завтра будет новый день."
    cs_th "Новые разговоры."
    cs_th "Возможно, новые вопросы."
    cs_th "И, наверное, ещё немало всего, к чему я пока совершенно не готова."
    cs_th "Но сейчас…"
    cs_th "Сейчас хорошо."
    cs_narrator "Я улыбнулась, уже почти засыпая."
    cs_narrator "И больше ничего не сказала."
    return
