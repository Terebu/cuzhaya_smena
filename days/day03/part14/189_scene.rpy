# -*- coding: utf-8 -*-
label cs_day03_189:
    $ save_name = "Чужая смена — День 3: Третий день закончился"
    cs_narrator "За окном продолжалась обычная летняя ночь."
    cs_narrator "Ветер шевелил листья."
    cs_narrator "Где-то далеко слышались сверчки."
    cs_narrator "Иногда едва заметно скрипели деревянные стены домика."
    cs_narrator "Ничего необычного."
    cs_narrator "Ничего тревожного."
    cs_narrator "Просто старое здание, которому давно пора привыкнуть к ночным перепадам температуры."
    cs_th "Третий день."
    cs_th "И, пожалуй, впервые за всё время я действительно почувствовала себя здесь не только случайной гостьей."
    cs_th "У меня появилась прочитанная книга, к которой хочется вернуться в разговоре."
    if cs_un_sketch_completed_day3:
        cs_th "Рисунки, которые хочется закончить."
    else:
        cs_th "Идеи для рисунков, которые хочется попробовать."
    cs_th "Люди, которых хочется увидеть завтра."
    cs_th "И Даша."
    if cs_da_shared_bed_day3:
        cs_th "Она спит рядом."
        cs_th "И мне почему-то кажется, что сейчас совершенно не важно, как именно мы называем то, что между нами происходит."
    else:
        cs_th "Она спит на своей кровати."
        cs_th "И даже на расстоянии нескольких шагов я знаю, что мы не чужие друг другу."
    cs_th "Всё ещё хочется домой."
    cs_th "В Москву."
    cs_th "В свою комнату."
    cs_th "К привычным вещам."
    cs_th "К собственной жизни."
    cs_th "Но, кажется, за эти дни здесь тоже появилась маленькая её часть."
    cs_narrator "Я уже почти не различала собственные мысли."
    cs_th "Пусть завтра всё будет хотя бы немного понятнее."
    cs_narrator "За окном шелестели листья."
    cs_narrator "Лагерь спал."
    cs_narrator "И вскоре уснула я."
    stop music fadeout 2.0
    stop ambience fadeout 2.0
    $ cs_director_scene("black")
    scene black
    $ cs_frame_focus([])
    with Dissolve(0.7)
    show text "Конец третьего дня" at truecenter
    with Dissolve(1.0)
    $ renpy.pause(2.0)
    hide text
    with Dissolve(1.0)
    return
