# -*- coding: utf-8 -*-
label cs_day06_01:
    $ save_name = "Чужая смена — День 6: Утро без записей"
    $ cs_d6_room("cs_house_lena_darya_int_day",['cs_darya'])
    $ cs_d6_costume("pajamas")
    cs_narrator "Я проснулась в своей кровати."
    cs_narrator "Вчера мы сидели у Ольги Дмитриевны."
    cs_narrator "Женя записывала, Тихонова рисовала, Семён пытался вспомнить, что ему сказали у автобуса."
    cs_narrator "Я ещё помнила карандаш в пальцах."
    cs_narrator "Теперь вместо карандаша у меня был угол одеяла."
    $ cs_d6_focus("ls")
    cs_ls "Даш."
    cs_narrator "Она уже сидела на соседней кровати и смотрела на дверь."
    $ cs_d6_focus("da")
    cs_da "Помню."
    $ cs_d6_focus("da")
    cs_da "Домик Ольги."
    cs_da "Надпись."
    cs_da "Часы."
    cs_narrator "Я выдохнула и опустила ноги на пол."
    $ cs_d6_focus("ls")
    cs_ls "Хорошо."
    cs_ls "Значит, с ума сходим по предварительной записи."
    cs_ls "Вдвоём."
    $ cs_d6_think()
    cs_narrator "Даша потянулась за формой."
    cs_narrator "Пальцы у неё дрожали; она уронила галстук, выругалась вполголоса и подняла его."
    $ cs_rev_sfx("sound/sfx/drawer_rattle.ogg",0.3)
    cs_narrator "Я проверила стол."
    cs_narrator "Потом полку и ящик тумбочки."
    cs_narrator "Вчерашних листов нигде не было."
    cs_narrator "Обычный блокнот лежал на месте, но последних записей в нём не оказалось."
    $ cs_d6_focus("ls")
    cs_ls "У тебя что-нибудь осталось?"
    cs_narrator "Даша вытряхнула карманы на покрывало."
    $ cs_d6_focus("da")
    cs_da "Ничего со вчерашнего вечера."
    $ cs_d6_cg("cs_cg_day06_blank_pages_morning")
    cs_narrator "Я ещё раз пролистала блокнот."
    cs_narrator "Дальше шли чистые страницы."
    $ cs_d6_focus("ls")
    cs_ls "Прекрасно."
    cs_ls "Даже уборку за нами сделали."
    cs_narrator "Шутка получилась так себе."
    cs_narrator "Даша не улыбнулась."
    $ cs_d6_focus("da")
    cs_da "Ты помнишь, как мы вышли от Ольги?"
    cs_narrator "Я остановилась."
    $ cs_d6_think()
    cs_th "Мы ведь не выходили."
    cs_th "Во всяком случае, я этого не помнила."
    $ cs_d6_think()
    cs_th "Я помнила, как мы продолжили писать, а потом всех резко потянуло в сон."
    cs_th "Фонарь на столе, Дашину руку у моего рукава."
    cs_th "Дальше — утро в нашей комнате."
    $ cs_d6_focus("ls")
    cs_ls "Нет."
    cs_ls "А ты?"
    cs_narrator "Она покачала головой."
    $ cs_d6_costume("pioneer")
    $ cs_d6_room("cs_house_lena_darya_int_day",['cs_darya'])
    cs_narrator "Я быстро оделась."
    cs_narrator "Галстук завязался с первой попытки — хоть какой-то навык из лагеря пригодился."
    $ cs_d6_focus("ls")
    cs_ls "Сначала Семён."
    cs_ls "Потом Ольга и Виола."
    $ cs_d6_focus("da")
    cs_da "И записи."
    $ cs_d6_focus("da")
    cs_da "Сравним, пока ничего не перепутали."
    cs_narrator "Я оторвала два листа и протянула ей один."
    $ cs_d6_focus("ls")
    cs_ls "Каждый пишет своё."
    cs_ls "Не подглядывать, это контрольная."
    $ cs_d6_focus("da")
    cs_da "За списывание отправят домой?"
    $ cs_d6_focus("ls")
    cs_ls "Не заманивай."
    $ cs_d6_think()
    cs_narrator "Мы потратили несколько минут на короткие списки."
    cs_narrator "У обеих были остановившиеся часы, пропавшая карточка и слова на двери: «ПЕРВЫЙ ИЛИ ВТОРАЯ. ДО РАССВЕТА»."
    cs_narrator "Больше всего мне хотелось немедленно найти Семёна."
    cs_narrator "Но после этих двух листов я хотя бы понимала, что именно собираюсь у него спрашивать."
    $ cs_d6_room("bg ext_house_of_mt_day",['cs_darya'])
    $ cs_d6_think()
    cs_th "К домику вожатой мы дошли быстро, без вчерашних метаний по дорожкам."
    cs_th "По пути я успела поздороваться со Славей и пропустить Ульяну с полотенцем на плече."
    cs_narrator "Никто не выглядел человеком, который провёл ночь в компании голоса за дверью."
    $ cs_rev_knocks(2)
    cs_narrator "Ольга Дмитриевна открыла после второго стука."
    $ cs_d6_allowed = ['cs_darya', 'cs_semen', 'mt']
    $ cs_d6_focus("mt")
    cs_mt "Девочки?"
    cs_mt "Что случилось?"
    cs_narrator "За её спиной Семён возился со шнурками."
    cs_narrator "Увидел нас и замер, держа ботинок в руках."
    $ cs_d6_focus("sy")
    cs_sy "Вы тоже?"
    cs_narrator "Я отодвинула от лица прядь волос."
    $ cs_d6_focus("ls")
    cs_ls "Если ты сейчас спросишь про завтрак, я расстроюсь."
    cs_narrator "Он посмотрел на дверь изнутри."
    $ cs_d6_focus("sy")
    cs_sy "Надпись исчезла."
    $ cs_d6_room("bg int_house_of_mt_day",['cs_darya', 'cs_semen', 'mt'])
    $ cs_rev_sfx("sound/sfx/door_squeak_light.ogg",0.3)
    cs_narrator "Я вошла."
    cs_narrator "На двери была только старая царапина возле ручки."
    $ cs_d6_focus("ls")
    cs_ls "Помнишь, что там было?"
    cs_narrator "Семён повторил обе строки."
    cs_narrator "Потом сам заговорил про карточку и Женину тетрадь."
    cs_narrator "Я поймала себя на том, что улыбаюсь."
    $ cs_d6_focus("sy")
    cs_sy "Что?"
    $ cs_d6_focus("ls")
    cs_ls "Ничего."
    cs_ls "Рада тебя видеть."
    $ cs_d6_focus("sy")
    cs_sy "Мы вчера виделись."
    $ cs_d6_focus("ls")
    cs_ls "Вот именно."
    cs_ls "И хотелось бы сохранить эту хорошую традицию."
    cs_narrator "Ольга Дмитриевна закрыла дверь."
    $ cs_d6_focus("mt")
    cs_mt "Теперь объясните мне."
    cs_narrator "На столе не было ни нашей стопки бумаг, ни термоса."
    cs_narrator "Я спросила, куда она убрала записи."
    $ cs_d6_focus("mt")
    cs_mt "Какие записи?"
    cs_narrator "Я посмотрела на Дашу."
    cs_narrator "Та положила перед вожатой свой лист."
    cs_narrator "Мы рассказали по очереди."
    cs_narrator "Коротко: кто был в домике, что произошло с карточкой, какие слова появились на двери."
    cs_narrator "Семён начал описывать голос, но Ольга остановила его жестом."
    $ cs_d6_focus("mt")
    cs_mt "Подождите."
    cs_mt "На этом месте…"
    cs_narrator "Она коснулась края стола."
    $ cs_d6_focus("mt")
    cs_mt "Здесь стоял фонарь."
    cs_narrator "Я не стала подсказывать."
    $ cs_d6_focus("mt")
    cs_mt "И кто-то просил освободить место для тетради."
    $ cs_d6_focus("mt")
    cs_mt "Женя?"
    $ cs_d6_focus("ls")
    cs_ls "Да."
    $ cs_d6_think()
    cs_narrator "Ольга села."
    cs_narrator "Несколько секунд смотрела на голую столешницу, потом попросила наши листы."
    cs_narrator "До подробностей она так и не добралась."
    cs_narrator "Помнила свет фонаря и тесноту возле стола; надпись оставалась для неё чужим рассказом."
    $ cs_d6_focus("mt")
    cs_mt "Я поговорю с Виолой."
    $ cs_d6_focus("mt")
    cs_mt "А вы пока позавтракайте."
    $ cs_d6_focus("ls")
    cs_ls "Сначала заглянем к Жене."
    cs_narrator "Ольга подняла глаза."
    $ cs_d6_focus("ls")
    cs_ls "В библиотеку."
    $ cs_d6_focus("ls")
    cs_ls "Освоила наконец безопасные достопримечательности."
    $ cs_d6_focus("mt")
    cs_mt "После библиотеки."
    cs_narrator "Я согласилась."
    cs_narrator "Спорить с завтраком у меня оснований не было."
    cs_narrator "Семён наконец натянул ботинки и вышел с нами."
    $ cs_d6_room("bg int_library_day",['cs_darya', 'cs_semen', 'cs_zhenya'])
    cs_narrator "Женя сидела за столом с открытой тетрадью."
    cs_narrator "Перед ней лежали библиотечные карточки."
    $ cs_d6_focus("mz")
    cs_mz "Если вы опять за альбомом, его здесь нет."
    $ cs_d6_focus("ls")
    cs_ls "Мы поговорить."
    cs_narrator "Она перевела взгляд с меня на Дашу и закрыла тетрадь пальцем, оставив закладку."
    cs_narrator "Я уже хотела перечислить все события ночи, но остановилась."
    $ cs_d6_focus("ls")
    cs_ls "Ты вчера вечером была у Ольги."
    cs_ls "Что-нибудь помнишь после отбоя?"
    $ cs_d6_focus("mz")
    cs_mz "Что должна была вернуться в домик."
    $ cs_d6_focus("ls")
    cs_ls "А вернулась?"
    cs_narrator "Женя нахмурилась."
    $ cs_d6_focus("mz")
    cs_mz "Наверное."
    cs_narrator "Она посмотрела на свои записи и снова открыла тетрадь."
    cs_narrator "Последняя страница была чистой."
    $ cs_d6_focus("mz")
    cs_mz "Странно."
    cs_mz "Мне казалось, я здесь писала."
    $ cs_d6_focus("ls")
    cs_ls "Что именно?"
    $ cs_d6_focus("mz")
    cs_mz "Если бы знала, не сидела бы с таким лицом."
    $ cs_d6_focus("ls")
    cs_ls "Справедливое замечание."
    $ cs_rev_sfx("sound/sfx/paper_bag.ogg",0.22)
    cs_narrator "Я положила рядом наши листы, но не развернула к ней."
    label cs_check_d6_choice_1:
    menu:
        "Сначала запиши своё. Мы подождём":
            $ cs_d6_choose(1,0)
            if cs_d6_before("mz") >= 4:
                cs_narrator "Женя помолчала и достала карандаш."
                cs_narrator "Женя написала: «Ты уже выбирал»."
                cs_narrator "Остановилась, посмотрела на Семёна, потом добавила время — 23:59."
                $ cs_d6_focus("mz")
                cs_mz "Это с карточки."
                $ cs_d6_focus("mz")
                cs_mz "Я переписывала, когда она исчезла."
                cs_narrator "Я развернула к ней свой лист."
                cs_narrator "Строки совпали."
                cs_narrator "Женя отложила карандаш."
                $ cs_d6_focus("mz")
                cs_mz "Остальное путается."
                cs_mz "Помню фонарь."
                cs_mz "И что ты просила не уходить."
                $ cs_d6_focus("ls")
                cs_ls "Этого уже немало."
                $ cs_d6_mz_independent = True
            else:
                if cs_d6_before("mz") >= 1:
                    cs_narrator "Женя провела карандашом по краю листа."
                    $ cs_d6_focus("mz")
                    cs_mz "Стол у Ольги помню."
                    cs_mz "Мы что-то писали."
                    cs_mz "А что — не могу сказать."
                    $ cs_d6_focus("ls")
                    cs_ls "Людей помнишь?"
                    $ cs_d6_focus("mz")
                    cs_mz "Тебя, Дашу."
                    cs_mz "Семён возле двери."
                    cs_mz "Может, просто потому, что он там живёт."
                    cs_narrator "Я попросила записать и это, отдельно от догадок."
                    cs_narrator "Потом показала свой лист."
                    $ cs_d6_focus("mz")
                    cs_mz "Знакомо."
                    cs_mz "Но я не уверена, что вспомнила бы сама."
                    $ cs_d6_focus("ls")
                    cs_ls "Тогда так и отметим."
                else:
                    $ cs_d6_focus("mz")
                    cs_mz "Не помню."
                    cs_mz "И если сейчас прочту твой рассказ, потом уже не разберу, что вспомнила сама."
                    cs_narrator "Я убрала листы."
                    $ cs_d6_focus("ls")
                    cs_ls "Хорошо."
                    cs_ls "Можешь просто записать, что у тебя было последним?"
                    $ cs_d6_focus("mz")
                    cs_mz "Это могу."
                    cs_narrator "Она написала несколько строк и придвинула лист ко мне."
                    $ cs_d6_focus("mz")
                    cs_mz "Я не обещаю, что поверю."
                    $ cs_d6_focus("ls")
                    cs_ls "От тебя пока и не требуется."
            cs_narrator "Даша придержала лист, пока Женя делала последнюю пометку."
            $ cs_d6_focus("da")
            cs_da "Так и оставим."
            $ cs_d6_focus("da")
            cs_da "Где не уверена, поставь вопрос."
            $ cs_d6_focus("mz")
            cs_mz "Я и без тебя умею вести записи."
            $ cs_d6_focus("ls")
            cs_ls "Тогда нам повезло."
            $ cs_d6_focus("ls")
            cs_ls "Мы пока только терять их научились."
            cs_narrator "Женя фыркнула и впервые за утро посмотрела на нас без раздражения."
        "У нас мало времени. Вот что было":
            $ cs_d6_choose(1,1)
            cs_narrator "Я развернула перед ней листы."
            $ cs_d6_focus("ls")
            cs_ls "Прочти."
            cs_ls "Может, так быстрее."
            cs_narrator "Женя пробежала глазами строки и положила карандаш."
            $ cs_d6_focus("mz")
            cs_mz "Теперь я уже не проверю, вспомнила бы сама."
            cs_narrator "Я посмотрела на её пустую страницу."
            $ cs_d6_focus("ls")
            cs_ls "Да."
            cs_ls "Поторопилась."
            $ cs_d6_focus("mz")
            cs_mz "Не в первый раз."
            cs_mz "Ладно, оставь копию."
    label cs_check_d6_choice_1_done:
    $ cs_d6_room("bg ext_dining_hall_near_day",['cs_darya', 'cs_semen', 'mt', 'cs_zhenya', 'un', 'sl', 'dv', 'mi'])
    $ cs_d6_think()
    cs_narrator "У столовой мы встретили остальных."
    cs_narrator "Мику пыталась одновременно поправить лямку сумки и объяснить Славе, что ничего не потеряла."
    cs_narrator "Судя по лицу Слави, объяснения уже повторялись."
    cs_narrator "Алиса стояла рядом с гитарой."
    cs_narrator "Тихонова ждала чуть поодаль, держа альбом прижатым к груди."
    cs_narrator "Я не стала собирать всех в кружок и объявлять очередную катастрофу."
    cs_narrator "Спросила по одному, кто как добрался вчера до домика."
    cs_narrator "Те, кто не был с нами у Ольги, помнили свой обычный вечер."
    cs_narrator "У остальных дорога до домиков выпадала из рассказа."
    $ cs_d6_focus("sl")
    cs_sl "Может, все просто устали?"
    $ cs_d6_focus("da")
    cs_da "Может."
    $ cs_d6_focus("da")
    cs_da "Поэтому и спрашиваем, а не решаем заранее."
    cs_narrator "Алиса посмотрела на листы в моей руке."
    $ cs_d6_focus("dv")
    cs_dv "И что, до завтрака будете опрашивать?"
    $ cs_d6_focus("ls")
    cs_ls "Только особо опасных свидетелей."
    cs_ls "Ты первая свободна."
    $ cs_d6_focus("dv")
    cs_dv "Спасибо, гражданка начальник."

    if cs_d6_before("sl") >= 4:
        if cs_d5_slavya_present:
            $ cs_d6_focus("sl")
            cs_sl "Плед на колени положили."
            cs_sl "А чай почти никто не пил."
            $ cs_d6_focus("ls")
            cs_ls "Ты помнишь?"
            $ cs_d6_focus("sl")
            cs_sl "Не всё."
            cs_sl "Я собиралась убрать кружки и почему-то боялась отойти от стола."
            cs_narrator "Она остановилась, пытаясь вспомнить дальше."
            $ cs_d6_focus("ls")
            cs_ls "Хватит пока."
            cs_ls "Это уже помогло."
        else:
            $ cs_d6_focus("sl")
            cs_sl "Я ночью там не была."
            cs_sl "Но ты сейчас совсем бледная."
            cs_sl "Пойдём поедим, потом расскажешь."
    if cs_d6_before("dv") >= 4:
        if cs_d5_alisa_present:
            cs_narrator "Алиса отвела меня на шаг от двери."
            $ cs_d6_focus("dv")
            cs_dv "Было что-то на двери у Ольги."
            cs_dv "Я оттуда уйти хотела, а потом осталась."
            $ cs_d6_focus("ls")
            cs_ls "Что было написано?"
            $ cs_d6_focus("dv")
            cs_dv "Не помню."
            cs_dv "Только твоё лицо."
            $ cs_d6_focus("ls")
            cs_ls "Если ещё что-нибудь вспомнишь, скажешь?"
            $ cs_d6_focus("dv")
            cs_dv "Скажу."
            cs_dv "Только не бегай за мной каждые пять минут."
        else:
            $ cs_d6_focus("dv")
            cs_dv "Ночью меня с вами не было."
            cs_dv "А автобус проверить — это можно."
            cs_dv "Только без очередного допроса."
    if cs_d6_before("mi") >= 4:
        if cs_d5_miku_present:
            $ cs_d6_focus("mi")
            cs_mi "Я возле стола сидела."
            cs_mi "И боялась, что сейчас кого-нибудь не станет."
            cs_narrator "Она посмотрела на Семёна, потом на Дашу."
            $ cs_d6_focus("mi")
            cs_mi "Но не знаю, почему."
            $ cs_d6_focus("da")
            cs_da "Пока все здесь."
            cs_da "Давай с этого начнём."
        else:
            $ cs_d6_focus("mi")
            cs_mi "В домике я ночью не была."
            cs_mi "Но если вам сейчас нужна помощь, скажите."
    cs_narrator "Она потянулась к двери."
    cs_narrator "Я уже собиралась идти следом, когда Тихонова тронула меня за рукав."
    $ cs_d6_focus("un")
    cs_un "Вчера мы рисовали у Ольги?"
    $ cs_d6_focus("ls")
    cs_ls "Ты рисовала."
    cs_ls "Остальные портили бумагу словами."
    cs_narrator "Лена раскрыла альбом."
    cs_narrator "На чистом листе торчал маленький след от карандаша — она, видимо, уже пыталась что-то начать."
    $ cs_d6_focus("un")
    cs_un "Я не помню рисунок."
    $ cs_d6_focus("ls")
    cs_ls "Тогда не будем придумывать."
    cs_narrator "Она взглянула на меня, словно ждала другого ответа."
    if cs_d6_before("un") >= 4:
