# -*- coding: utf-8 -*-
label cs_day06_02:
    $ save_name = "Чужая смена — День 6: Сборы"
    cs_narrator "Ольга Дмитриевна вошла, когда я уже доедала кашу."
    $ cs_d6_focus("mt")
    cs_mt "Ребята, внимание."
    cs_mt "Сегодня после обеда отъезд."
    cs_mt "Вещи соберите заранее, домики сдайте до половины второго."
    cs_narrator "Я опустила ложку."
    cs_narrator "Через стол на меня смотрел Семён."
    $ cs_d6_focus("sy")
    cs_sy "У всех?"
    $ cs_d6_focus("mt")
    cs_mt "У большинства."
    cs_mt "Соколова и Даша уезжают завтра, отдельным рейсом."
    cs_mt "С ними останемся мы с Виолой."
    cs_narrator "Мику что-то уронила под стол."
    cs_narrator "Алиса спросила, во сколько приедет автобус."
    cs_narrator "Ольга ответила, потом стала объяснять про багаж."
    cs_narrator "Я повернулась к Даше."
    $ cs_d6_focus("ls")
    cs_ls "У меня шестой день, у него седьмой."
    $ cs_d6_focus("da")
    cs_da "Мы приехали позже."
    $ cs_d6_focus("ls")
    cs_ls "Да."
    cs_ls "Просто надеялась, что хотя бы уезжать будем все вместе."
    cs_narrator "Даша подвинула ко мне кружку."
    $ cs_d6_focus("da")
    cs_da "Сначала спросим про рейс."
    cs_narrator "Мы дождались, пока Ольга закончит объявление, и подошли к ней у выхода."
    cs_narrator "Маршрут был обычный."
    cs_narrator "Водитель знакомый."
    cs_narrator "Наш завтрашний отъезд, по её словам, уже стоял в расписании."
    cs_narrator "Я попросила показать список."
    cs_narrator "Внизу действительно значились две фамилии и завтрашняя дата."
    cs_narrator "Бумага выглядела старой, с загнутым краем."
    cs_narrator "Это ничего не доказывало, но хотя бы список не возник у меня на глазах."
    $ cs_d6_focus("ls")
    cs_ls "Можно проверить автобус, когда приедет?"
    cs_narrator "Ольга посмотрела на Дашу, потом на меня."
    $ cs_d6_focus("mt")
    cs_mt "Вместе со мной."
    cs_mt "Без представления для всего отряда."
    $ cs_d6_focus("ls")
    cs_ls "Даже маленького?"
    $ cs_d6_focus("mt")
    cs_mt "Лена."
    $ cs_d6_focus("ls")
    cs_ls "Хорошо."
    cs_ls "Документы, водитель, маршрут."
    cs_ls "Очень скучное представление."
    $ cs_d6_room("cs_camp_path_day",['cs_darya'])
    cs_narrator "После завтрака лагерь занялся сборами."
    cs_narrator "На крыльцах появились сумки, в умывальниках выстроилась очередь, из одного домика уже третий раз выносили забытое полотенце."
    cs_narrator "До обеда оставался свободный час."
    cs_narrator "Успеть в три места сразу не получится; надо выбрать, кому помочь."
    label cs_check_d6_choice_2:
    menu:
        "Помочь Славе закончить сборы":
            $ cs_d6_choose(2,0)
            $ cs_d6_room("bg ext_square_day",['cs_darya', 'sl'])
            cs_narrator "Возле площади Славя пыталась пересчитать мешки с бельём и одновременно отвечала на вопросы со всех сторон."
            $ cs_d6_allowed = ['cs_darya', 'sl']
            $ cs_d6_focus("ls")
            cs_ls "Тебе помочь?"
            cs_narrator "Она выпрямилась."
            $ cs_d6_focus("sl")
            cs_sl "Правда?"
            cs_sl "Отнесёшь вот эти к складу?"
            cs_sl "Только не тяжёлый."
            $ cs_d6_focus("ls")
            cs_ls "Спасибо, что не доверяешь мне грузоподъёмность."
            $ cs_d6_focus("sl")
            cs_sl "Я твоему локтю не доверяю."
            $ cs_d6_think()
            cs_narrator "Я взяла лёгкую связку."
            cs_narrator "Даша подхватила вторую."
            $ cs_d6_think()
            cs_th "До обеда всё равно надо было чем-то заняться."
            cs_th "Смотреть на дорогу и мешать Семёну собираться — занятие увлекательное, но бесполезное."
            $ cs_d6_room("cs_storage_int_day",['cs_darya', 'sl'])
            cs_narrator "На складе Славя обнаружила недостающую наволочку."
            $ cs_d6_room("cs_storage_ext_day",['cs_darya', 'sl'])
            cs_narrator "Мы вернулись за ней, потом помогли отнести коробку с кружками."
            cs_narrator "Работа оказалась простой и даже приятной: взяла, донесла, поставила."
            cs_narrator "Никаких неизвестных голосов в конце задания."
            $ cs_d6_focus("sl")
            cs_sl "Спасибо."
            $ cs_d6_focus("sl")
            cs_sl "Теперь успею сама собраться."
            $ cs_d6_focus("ls")
            cs_ls "Обращайся."
            cs_ls "Сегодня я полезный человек примерно до обеда."
            cs_narrator "Она улыбнулась и побежала к домику."
        "Помочь Алисе с гитарой и сумками":
            $ cs_d6_choose(2,1)
            $ cs_d6_room("bg ext_musclub_day",['cs_darya', 'dv'])
            cs_narrator "Алиса пыталась одновременно удержать гитару и застегнуть сумку."
            $ cs_d6_focus("ls")
            cs_ls "Давай подержу."
            cs_narrator "Она посмотрела на мою руку."
            $ cs_d6_focus("dv")
            cs_dv "Только ничего не урони."
            $ cs_d6_focus("ls")
            cs_ls "Спасибо за доверие."
            cs_ls "Почти тронута."
            $ cs_d6_think()
            cs_narrator "Я взяла чехол здоровой рукой."
            cs_narrator "Даша помогла со второй сумкой."
            cs_narrator "До домика дошли без потерь."
            cs_narrator "Алиса всё-таки забыла ремень, пришлось вернуться."
            $ cs_d6_focus("ls")
            cs_ls "Без нас бы уехала без половины вещей."
            $ cs_d6_focus("dv")
            cs_dv "Без тебя я бы меньше отвлекалась."
            $ cs_d6_focus("ls")
            cs_ls "Но скучнее."
            cs_narrator "Она усмехнулась и забрала чехол."
            $ cs_d6_focus("dv")
            cs_dv "Ладно."
            cs_dv "Спасибо."
        "Забрать с Мику вещи из клуба":
            $ cs_d6_choose(2,2)
            $ cs_d6_room("bg int_musclub_day",['cs_darya', 'mi'])
            cs_narrator "Мику складывала ноты сразу в три стопки и уже путалась, какую собиралась взять."
            $ cs_d6_focus("ls")
            cs_ls "Эту оставляем?"
            $ cs_d6_focus("mi")
            cs_mi "Да."
            cs_mi "Нет, подожди, тут второй лист от той песни."
            cs_narrator "Я села рядом."
            $ cs_d6_focus("ls")
            cs_ls "Хорошо."
            cs_ls "Ты говоришь, мы раскладываем."
            cs_ls "Две минуты без самостоятельного творчества."
            cs_narrator "Даша нашла бечёвку."
            cs_narrator "Мы перевязали стопку для клуба и собрали дорожную папку."
            $ cs_d6_focus("mi")
            cs_mi "Я думала, не успею."
            $ cs_d6_focus("ls")
            cs_ls "Успела."
            cs_ls "Теперь можно вспоминать, что забыла."
            cs_narrator "Она засмеялась и тут же проверила карманы."
    label cs_check_d6_choice_2_done:
    $ cs_d6_room("bg ext_library_day",['cs_darya', 'un'])
    if cs_d6_un_private:
        $ cs_d6_think()
        cs_narrator "Даша на минуту задержалась с Тихоновой."
        cs_narrator "Я отошла к двери библиотеки."
        cs_narrator "Вернувшись, Даша сказала только, что Лена пока не хочет обсуждать ночь со мной."
        cs_narrator "Подробностей я не стала спрашивать."
    if cs_d6_before("un") >= 1:
        if cs_d6_un_private:
            cs_narrator "Мы встретились у библиотечной скамейки."
            cs_narrator "К ночным событиям я не возвращалась."
        else:
            cs_narrator "Тихонова ждала нас на скамейке у библиотеки."
            cs_narrator "Я села рядом, оставив ей место."
            cs_narrator "Даша устроилась на краю скамейки и достала наши листы."
            $ cs_d6_focus("ls")
            cs_ls "Про вчерашний рисунок?"
            cs_narrator "Лена кивнула."
            cs_narrator "Она снова попыталась восстановить домик Ольги: окно, стол, стулья."
            cs_narrator "На середине остановилась."
            $ cs_d6_focus("un")
            cs_un "Не получается."
            cs_un "Всё путается."
            $ cs_d6_focus("ls")
            cs_ls "Тогда хватит на сегодня."
            $ cs_d6_focus("un")
            cs_un "Но вы хотите понять, что произошло."
            $ cs_d6_focus("ls")
            cs_ls "Хотим."
            cs_ls "А вымученный рисунок нам чем поможет?"
            cs_narrator "Она провела ластиком по линии и закрыла альбом."
        if cs_d5_un_day6_sketch_offer:
            if cs_d6_un_private:
                cs_narrator "Тихонова сама раскрыла альбом."
                $ cs_d6_focus("un")
                cs_un "Мы же обещали порисовать."
                cs_un "Давайте только без разговоров про ночь?"
                $ cs_d6_focus("ls")
                cs_ls "Конечно."
                $ cs_d6_focus("ls")
                cs_ls "Я вообще-то собиралась воспользоваться тем, что рядом есть человек с нормальными карандашами."
                $ cs_d6_cg("cs_cg_day06_drawing_by_library")
                cs_narrator "Мы посидели минут десять."
                cs_narrator "Я набросала её руку на обложке альбома, она — Дашу, которая делала вид, что не позирует."
                $ cs_d6_room("bg ext_library_day",['cs_darya', 'un'])
                cs_narrator "Перед уходом Тихонова задержалась."
                $ cs_d6_sketch_done = True
            else:
                cs_narrator "Я спросила про вчерашнюю договорённость порисовать вместе."
                cs_narrator "Лена посмотрела на меня чуть удивлённо."
                $ cs_d6_focus("un")
                cs_un "Ты всё ещё хочешь?"
                $ cs_d6_focus("ls")
                cs_ls "Я вообще-то собиралась воспользоваться тем, что рядом есть человек с нормальными карандашами."
                $ cs_d6_cg("cs_cg_day06_drawing_by_library")
                cs_narrator "Мы посидели минут десять."
                cs_narrator "Я набросала её руку на обложке альбома, она — Дашу, которая делала вид, что не позирует."
                $ cs_d6_room("bg ext_library_day",['cs_darya', 'un'])
                cs_narrator "Перед уходом Тихонова задержалась."
                $ cs_d6_sketch_done = True
        else:
            cs_narrator "Я не стала задерживать её с альбомом."
            $ cs_d6_focus("ls")
            cs_ls "Успеешь собраться?"
            $ cs_d6_focus("un")
            cs_un "Почти всё готово."
            cs_narrator "Лена провела пальцем по углу обложки."
        $ cs_d6_focus("un")
        cs_un "Если завтра снова увидишь там похожую на меня девушку… не думай сразу, что это я."
        cs_narrator "Я убрала карандаш."
        $ cs_d6_focus("ls")
        cs_ls "Не буду."
        cs_ls "И подходить не стану."
        $ cs_d6_focus("un")
        cs_un "Даже если позовёт."
        $ cs_d6_focus("ls")
        cs_ls "Особенно если позовёт."
        cs_ls "У меня уже был такой экскурсовод."
        cs_narrator "Лена слабо улыбнулась, но продолжала смотреть серьёзно."
        $ cs_d6_focus("un")
        cs_un "Я не знаю, кого ты видела."
        $ cs_d6_focus("ls")
        cs_ls "Я тоже."
        cs_ls "Поэтому не будем выдавать тебя за ответ на все вопросы."
        cs_narrator "Лена посмотрела на закрытый альбом."
        $ cs_d6_focus("un")
        cs_un "И сначала спроси про старый лагерь."
        cs_un "Что я о нём помню."
        cs_un "Не беги следом только потому, что похожа."
        $ cs_d6_focus("da")
        cs_da "Вопрос не волшебный пароль."
        $ cs_d6_focus("da")
        cs_da "Если ответит, это ещё ничего не докажет."
        $ cs_d6_focus("un")
        cs_un "Знаю."
        cs_un "Но хоть остановится и подумает."
        cs_narrator "Я подняла ладонь."
        $ cs_d6_focus("ls")
        cs_ls "Уже думаю."
        cs_ls "И никуда за незнакомой собой не пойду."
        cs_narrator "Она кивнула и пошла собираться."
    else:
        cs_narrator "У библиотеки мы встретили Тихонову с собранной сумкой."
        $ cs_d6_focus("ls")
        cs_ls "Что-нибудь ещё вспомнила?"
        $ cs_d6_focus("un")
        cs_un "Нет."
        cs_un "И если опять увидишь там похожую девушку — не принимай её за меня."
        $ cs_d6_focus("ls")
        cs_ls "Помню."
        cs_ls "Подходить не стану."
        if cs_d5_un_day6_sketch_offer:
            $ cs_d6_focus("un")
            cs_un "Вчера я обещала порисовать."
            cs_un "Но сейчас не хочу."
            $ cs_d6_focus("ls")
            cs_ls "Хорошо."
            cs_ls "Не будем через силу."
    $ cs_d6_room("bg ext_library_day",['cs_darya', 'cs_zhenya'])
    cs_narrator "Женю мы нашли у библиотеки."
    cs_narrator "Она проверяла окна, Даша придержала ей дверь."
    cs_narrator "Я показала на конверт."
    $ cs_d6_focus("ls")
    cs_ls "Если всё это исчезнет ещё раз, обидно будет."
    $ cs_d6_focus("mz")
    cs_mz "Значит, повторите записи."
    $ cs_d6_focus("ls")
    cs_ls "Очень хотелось бы какой-нибудь способ полегче."
    $ cs_d6_focus("mz")
    cs_mz "Можешь запомнить."
    cs_mz "Весит меньше бумаги."
    cs_narrator "Мы улыбнулись друг другу."
    if cs_d6_mz_listened:
        cs_narrator "Она дала нам чистый лист и показала, как разделить его: «видели сами», «услышали от других», «предполагаем»."
        $ cs_d6_focus("ls")
        cs_ls "А раздел «понятия не имеем»?"
        $ cs_d6_focus("mz")
        cs_mz "Это весь остальной лист."
        if cs_friend_mz >= 4:
            $ cs_d6_focus("mz")
            cs_mz "Одинаковые фамилии ещё ничего не решают."
            cs_mz "Смотри, один ли это список или разные документы."
            cs_narrator "Женя добавила в памятку поля: год, номер смены, заголовок, страница."
            $ cs_d6_focus("ls")
            cs_ls "То есть меньше радостно кричать и больше переписывать?"
            $ cs_d6_focus("mz")
            cs_mz "Ты удивительно быстро понимаешь, когда хочешь."
            $ cs_d6_archive_guide = True
    else:
        $ cs_d6_think()
        cs_narrator "Я сама разделила чистый лист на факты и предположения."
        cs_narrator "Женя проверила только, не перепутаны ли наши копии."
    cs_narrator "Я сложила бумагу в конверт."
    if cs_d5_zhenya_address or (cs_friend_mz >= 4 and cs_d6_mz_listened and not cs_d5_asked_address):
        if cs_d5_zhenya_address:
            $ cs_d6_focus("ls")
            cs_ls "Твой адрес остался на вчерашнем листе."
            cs_ls "Запишешь ещё раз?"
            $ cs_d6_focus("mz")
            cs_mz "Запишу."
            cs_mz "Держи отдельно от остального."
        else:
            $ cs_d6_focus("ls")
            cs_ls "Если захочешь, можешь оставить адрес."
            cs_narrator "Женя сама взяла карандаш."
        $ cs_d6_focus("mz")
        cs_mz "Только без обещаний найти меня завтра утром."
        $ cs_d6_focus("ls")
        cs_ls "Завтра утром я занята."
        cs_ls "У меня отъезд из странного места."
        $ cs_d6_focus("mz")
        cs_mz "Вот сначала уедь."
        cs_narrator "Лист с адресом я убрала отдельно от заметок."
        $ cs_d6_mz_address_received = True
    else:
        cs_narrator "Перед уходом я спросила про адрес."
        $ cs_d6_focus("mz")
        cs_mz "Пока не хочу."
        cs_narrator "Я кивнула и убрала чистый лист."
        $ cs_d6_focus("ls")
        cs_ls "Хорошо."
        cs_ls "Это не обязательная часть проводов."
        $ cs_d6_focus("mz")
        cs_mz "Вот и договорились."
    $ cs_d6_room("cs_house_lena_darya_ext_day",['cs_darya', 'cs_semen'])
    cs_narrator "Семён нашёл меня у нашего домика."
    cs_narrator "Даша сидела на крыльце и зашивала оторвавшуюся пуговицу на форме; я бесполезно держала нитки."
    $ cs_d6_focus("ls")
    cs_ls "Собрался?"
    cs_narrator "Он поднял маленькую сумку."
    $ cs_d6_focus("sy")
    cs_sy "Как видишь."
    $ cs_d6_focus("ls")
    cs_ls "Завидую людям, у которых вся жизнь помещается в ручную кладь."
    $ cs_d6_focus("sy")
    cs_sy "Ты здесь тоже без гардеробной."
    $ cs_d6_focus("ls")
    cs_ls "Поэтому и завидую."
    cs_ls "У меня вынужденная скромность."
    if cs_d6_before("se") >= 4:
        cs_narrator "Он усмехнулся и сел на нижнюю ступеньку."
        cs_narrator "Некоторое время мы молчали."
        cs_narrator "Потом Семён спросил:"
        $ cs_d6_focus("sy")
        cs_sy "А если автобус окажется обычным?"
    else:
        if cs_d6_before("se") >= 1:
            $ cs_d6_focus("ls")
            cs_ls "Хочешь поговорить до посадки?"
            cs_narrator "Семён сел на ступеньку."
            cs_narrator "Даша отложила рубашку."
            $ cs_d6_focus("sy")
            cs_sy "А если автобус окажется обычным?"
        else:
            cs_narrator "Семён остался возле крыльца."
            cs_narrator "Мы с Дашей спросили, что он думает о рейсе."
            $ cs_d6_focus("sy")
            cs_sy "Я всё помню."
            cs_sy "И карточку, и надпись."
            cs_sy "Но сегодня еду."
            $ cs_d6_focus("ls")
            cs_ls "Автобус всё равно проверим?"
            $ cs_d6_focus("sy")
            cs_sy "Конечно."
            cs_sy "А если он обычный?"
    label cs_check_d6_choice_3:
    menu:
        "Проверим автобус, а решишь ты":
            $ cs_d6_choose(3,0)
            if cs_d5_semyon_agency:
                $ cs_d6_focus("ls")
                cs_ls "Как и вчера: проверим вместе, а решишь ты."
                cs_ls "Я помню нашу договорённость."
            $ cs_d6_focus("ls")
            cs_ls "Тогда решишь, ехать или нет."
