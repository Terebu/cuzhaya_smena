# -*- coding: utf-8 -*-
label cs_day06_07:
    $ save_name = "Чужая смена — День 6: Лишний прибор"
    $ cs_d6_room("bg ext_house_of_mt_sunset",['cs_darya', 'mt', 'cs'])
    cs_narrator "Ольга ушла в столовую первой."
    cs_narrator "Мы с Дашей задержались, чтобы вернуть колоду Виоле, потом подошли все вместе."
    $ cs_d6_room("bg int_dining_hall_sunset",['cs_darya', 'mt', 'cs'])
    cs_narrator "На большом столе у окна стояли тарелки."
    cs_narrator "Рядом лежал хлеб, в кружках темнел компот."
    cs_narrator "Я остановилась у двери."
    $ cs_d6_focus("ls")
    cs_ls "Ольга Дмитриевна, мы кого-то ждём?"
    $ cs_d6_focus("mt")
    cs_mt "Нет."
    cs_mt "Садитесь, остынет."
    $ cs_d6_focus("ls")
    cs_ls "А почему мест пять?"
    cs_narrator "Она обернулась к столу."
    cs_narrator "Мы некоторое время молча смотрели на посуду."
    cs_narrator "Пересчитывать вслух не понадобилось."
    $ cs_d6_focus("mt")
    cs_mt "Я на четверых ставила."
    cs_narrator "Виола подошла ближе."
    $ cs_d6_focus("vi")
    cs_vi "Могла отвлечься."
    $ cs_d6_focus("mt")
    cs_mt "Могла."
    $ cs_d6_think()
    cs_th "Это было хорошее объяснение."
    cs_th "Я бы с удовольствием на нём остановилась."
    $ cs_d6_think()
    cs_th "Только за последние дни у хороших объяснений появилась неприятная привычка заканчиваться раньше самих событий."
    cs_narrator "Пятое место находилось с торца стола."
    cs_narrator "Обычный стул, полная тарелка супа, кусок хлеба."
    $ cs_d6_cg("cs_cg_day06_fifth_place_intact")
    stop music fadeout 1.0
    cs_narrator "Даша дотронулась до моего рукава."
    $ cs_d6_focus("da")
    cs_da "Садимся?"
    label cs_check_d6_choice_4:
    menu:
        "Записать, как всё стоит, и спокойно поесть":
            $ cs_d6_choose(4,0)
            cs_narrator "Я достала из конверта чистый лист."
            $ cs_d6_focus("ls")
            cs_ls "Минуту."
            cs_ls "Запишу, как было, и отстану."
            $ cs_d6_focus("vi")
            cs_vi "От чего именно?"
            $ cs_d6_focus("ls")
            cs_ls "Очень надеюсь, что от лишней посуды."
            cs_narrator "Я записала время, пять приборов, полную тарелку на свободном месте."
            cs_narrator "Даша посмотрела на хлеб и кивнула: целый кусок."
            cs_narrator "Ольга не возражала."
            cs_narrator "Села напротив Виолы и подвинула мне соль."
            cs_narrator "Я убрала лист в конверт."
            cs_narrator "Мы наконец начали есть."
        "Не будем снова себя накручивать. Садимся":
            $ cs_d6_choose(4,1)
            cs_narrator "Я отодвинула себе стул."
            $ cs_d6_focus("ls")
            cs_ls "Садимся."
            cs_ls "Если Ольга поставила лишнее, суп от этого хуже не станет."
            cs_narrator "Даша села рядом."
            cs_narrator "Пятое место осталось с торца."
    label cs_check_d6_choice_4_done:
    cs_narrator "Разговор шёл про завтрашний отъезд."
    cs_narrator "Во сколько вставать, где оставить ключи, успеем ли позавтракать до рейса."
    cs_narrator "Я спросила, нельзя ли взять в дорогу хлеб."
    $ cs_d6_focus("mt")
    cs_mt "Можно."
    $ cs_d6_focus("ls")
    cs_ls "Отлично."
    cs_ls "Один пункт выживания решён."
    $ cs_d6_focus("mt")
    cs_mt "Лена, ехать недолго."
    $ cs_d6_focus("ls")
    cs_ls "Вчера у нас минута не заканчивалась."
    cs_ls "Я теперь с запасом."
    cs_narrator "Даша легонько толкнула меня коленом под столом."
    cs_narrator "Я поняла и сменила тему."
    cs_narrator "Стала рассказывать, как Виола учила меня играть в карты через унижение."
    $ cs_d6_focus("vi")
    cs_vi "Через практику."
    $ cs_d6_focus("ls")
    cs_ls "Я чувствовала иначе."
    cs_narrator "Ольга улыбнулась."
    cs_narrator "Даша потянулась за хлебом."
    cs_narrator "И тогда у свободного места тихо звякнула ложка."
    $ cs_rev_sfx("sound/sfx/knock_glass.ogg",0.22)
    cs_narrator "Я подняла голову."
    cs_narrator "Остальные тоже."
    cs_narrator "Ложка лежала возле тарелки."
    cs_narrator "Стул оставался пустым."
    $ cs_d6_focus("da")
    cs_da "Я стол задела."
    $ cs_d6_focus("da")
    cs_da "Когда хлеб брала."
    cs_narrator "Я кивнула и продолжила есть."
    $ cs_d6_think()
    cs_th "На этот раз объяснение не только выглядело хорошим — у него ещё был свидетель."
    $ cs_d6_cg("cs_cg_day06_fifth_place_changed")
    cs_narrator "Я доела раньше остальных и потянулась за компотом."
    cs_narrator "Пятое место снова попало в поле зрения."
    cs_narrator "Хлеб лежал ближе к тарелке."
    cs_narrator "На одном краю не хватало кусочка."
    cs_narrator "Я поставила кружку."
    $ cs_d6_focus("ls")
    cs_ls "Даш."
    cs_ls "Посмотри, пожалуйста."
    cs_narrator "Она повернулась и замолчала."
    $ cs_d6_focus("ls")
    cs_ls "Кто-нибудь оттуда хлеб брал?"
    cs_narrator "Ольга покачала головой."
    cs_narrator "Виола убрала свою кружку и подошла к торцу стола."
    if cs_d6_place_recorded:
        cs_narrator "Я достала утренний конверт."
        cs_narrator "Лист с записью лежал сверху."
        cs_narrator "Хлеб был целым."
        cs_narrator "Мы обе на него смотрели."
        $ cs_d6_think()
        cs_th "Теперь край неровный, словно его откусили."
        cs_th "Супа тоже, кажется, стало меньше, но уровень я не отметила, поэтому про суп говорить не стала."
        cs_narrator "Виола внимательно осмотрела стол и пол."
        $ cs_d6_focus("vi")
        cs_vi "Крошек немного."
        cs_vi "Можно было отломить."
        $ cs_d6_focus("mt")
        cs_mt "Кто?"
        cs_narrator "Никто не ответил."
        cs_narrator "Я записала: «У хлеба не хватает куска. Никто из четверых не признаёт, что брал»."
        cs_narrator "Рука вдруг стала неловкой, буквы полезли друг на друга."
        cs_narrator "Я положила карандаш и несколько раз разжала пальцы."
        cs_narrator "Даша осталась возле меня."
        $ cs_d6_focus("da")
        cs_da "Хватит пока."
        cs_narrator "Я кивнула."
        $ cs_d6_think()
        cs_th "Пугаться, оказывается, гораздо проще, когда у тебя нет аккуратной записи о том, что именно изменилось."
    else:
        $ cs_d6_focus("ls")
        cs_ls "Хлеб таким был?"
        cs_narrator "Даша наклонилась к тарелке."
        $ cs_d6_focus("da")
        cs_da "Не знаю."
        cs_da "Я не смотрела."
        cs_narrator "Ольга тоже не смогла вспомнить."
        cs_narrator "Виола сказала, что кусок мог отломиться ещё на кухне."
        cs_narrator "Я медленно села обратно."
        $ cs_d6_focus("ls")
        cs_ls "Надо было сначала посмотреть."
        $ cs_d6_focus("da")
        cs_da "Теперь уже не проверим."
        cs_da "Запишем, что есть сейчас."
    cs_narrator "Ольга предложила убрать лишнюю посуду."
    cs_narrator "Я уже собиралась попросить оставить до утра, но посмотрела на суп и передумала."
    $ cs_d6_focus("ls")
    cs_ls "Приборы оставим на подносе?"
    cs_ls "Без еды."
    cs_ls "Только пусть никто не переставляет до завтра."
    $ cs_d6_focus("mt")
    cs_mt "Я сама поставлю на раздаточный стол."
    $ cs_d6_focus("mt")
    cs_mt "Запиши, если тебе так спокойнее."
    $ cs_d6_cg("cs_cg_day06_fifth_place_tray")
    $ cs_d6_fifth_tray_locked = True
    cs_narrator "Я записала."
    cs_narrator "Пятую ложку положили рядом с кружкой, тарелку вымыли и поставили дном вверх."
    cs_narrator "Еду убрали."
    $ cs_d6_room("bg ext_dining_hall_near_sunset",['cs_darya', 'mt', 'cs'])
    cs_narrator "Из пустой столовой мы вышли вместе."
    cs_narrator "Ольга заперла дверь и оставила ключ у себя."
    cs_narrator "На дорожке она остановилась."
    $ cs_d6_focus("mt")
    cs_mt "Если что-то услышите."
    $ cs_d6_focus("da")
    cs_da "Позовём."
    cs_narrator "Я ещё раз посмотрела на окна."
    cs_narrator "Никакого лица в стекле не появилось."
    cs_narrator "Но возвращаться за дополнительными доказательствами мне уже не хотелось."
    $ cs_d6_focus("ls")
    cs_ls "Нас четверо."
    cs_narrator "Виола посмотрела на меня."
    $ cs_d6_focus("vi")
    cs_vi "Мы все здесь."
    $ cs_d6_think()
    cs_th "Это прозвучало лучше, чем любое заверение, что нам просто показалось."
    return
