# -*- coding: utf-8 -*-

image cs_cg_d7_cabin_before_dawn = im.Scale(cs_path("cg/cg/cg_d07_cabin_before_dawn.png"), 1920, 1080)
define cs_d7_departure_note = "«Вышла на круг по лагерю. Вернусь к восьми, в столовую одна не полезу. Л.»"

label cs_day07_01:
    $ cs_d7_scene("cs_house_lena_darya_int_night")
    scene cs_house_lena_darya_int_night with dissolve
    $ cs_d7_ambience("sound/ambiences/int_cabin_night.ogg")
    stop music fadeout 2.0
    pause 0.5
    cs_narrator "Я проснулась сама, ещё до того, как за окном посветлело."
    cs_narrator "Никто не шумел, и кошмаров не было — просто сработала обычная московская привычка."
    cs_narrator "Дома я почти всегда открываю глаза минут за пять до будильника и просто лежу, пока не надо вставать."
    cs_narrator "Здесь будильника не было."
    cs_narrator "На тумбочке стояли маленькие механические часы, и они тикали так громко, будто пытались доказать, что честно работают."
    cs_narrator "Пару секунд я просто лежала на спине и смотрела в дощатый потолок."
    cs_narrator "В лагере стояла странная тишина."
    cs_narrator "За шесть дней я уже привыкла, что с самого утра кто-нибудь обязательно хлопает дверью в соседнем домике, бежит к умывальникам, кричит через дорожку или тащит что-нибудь гремящее."
    cs_narrator "Сегодня за окном не было ничего."
    cs_narrator "Только птицы иногда перекликались в соснах, да ветки чуть шуршали."
    cs_narrator "Все уехали вчера."
    cs_narrator "Семён, Славя, Алиса, Мику, Женя, Тихонова — их автобус скрылся за поворотом после обеда."
    cs_narrator "Сейчас было такое чувство, будто мы с Дашей остались в пустой мастерской после занятий, когда все уже разошлись, а мы забыли закрыть окно."
    cs_narrator "Через тонкие занавески на пол падала бледная серая полоса света."
    cs_narrator "Слишком холодный свет для лета, больше похожий на ноябрьское утро у меня дома."
    cs_narrator "В комнате было прохладно, пахло хвоей, старыми досками и чуть сырой травой с улицы."
    cs_narrator "На стуле у стены лежали вещи, которые мы разобрали ещё вечером."
    cs_narrator "Пионерский галстук я убрала в сумку до сна, чтобы утром не искать его по всей комнате."
    cs_narrator "Там же, на самом дне под кофтой, лежал плотный конверт с нашими выписками из документов старого лагеря за 1963, 1968, 1970 и 1971 годы и обычный блокнот с карандашом."
    cs_narrator "Всякая мелочёвка, которую я успела набрать за неделю, пока валялась по карманам и углам сумки."
    cs_narrator "Соберу потом, перед выходом."
    cs_narrator "Я потянулась под одеялом и машинально согнула левую руку, чтобы проверить локоть."
    cs_narrator "Не болит."
    cs_narrator "Вообще никак — даже когда сгибаешь резко, ничего не тянет."
    cs_narrator "Повязку я сняла раньше, кожа под ней полностью затянулась, и от ссадины не осталось даже красного следа."
    cs_narrator "Я хмыкнула про себя."
    cs_narrator "Вчера Виола для порядка заставила согнуть руку и запретила любые спортивные подвиги, а Славя честно сказала, что моему локтю не верит."
    cs_narrator "Приятно хотя бы в последний день смены проснуться нормальным человеком, у которого ничего не ноет."
    cs_narrator "Захотелось пробежаться."
    cs_narrator "Не для того, чтобы снова что-нибудь высматривать или проверять замки."
    cs_narrator "Просто за шесть дней спина и плечи затекли от вечной напряжённости, а голова устала крутить одни и те же вопросы по кругу."
    cs_narrator "Хотелось на полчаса выйти на пустые дорожки, размяться и спокойно посмотреть на лагерь, пока солнце не начало печь."
    if cs_da_shared_bed_day3 and cs_da_love_confession_day3:
        cs_narrator "Я повернула голову."
        cs_narrator "Рядом, уткнувшись лбом мне в плечо, ровно дышала Даша."
        cs_narrator "Одна прядь сбилась ей на щёку, губы были чуть приоткрыты, а рука лежала у меня на талии поверх футболки."
        cs_narrator "Пальцы слабо держались за ткань, будто она и во сне проверяла, на месте ли я."
        cs_narrator "Ещё неделю назад от одной мысли, что кто-то спит со мной на одной узкой кровати и держит за рубашку, я бы сразу напряглась."
        cs_narrator "Придумала бы три веских повода встать пораньше и сбежала на крыльцо, пока не стало слишком неловко."
        cs_narrator "Сейчас сбегать не хотелось."
        cs_narrator "Хотелось убрать прядь с её лица, но я не стала — побоялась разбудить."
        cs_narrator "Вчерашний вечер вымотал её не меньше моего, пусть поспит ещё хотя бы час."
        cs_narrator "Я начала выбираться по сантиметру, стараясь вообще не качать кровать."
        cs_narrator "Осторожно приподняла её тёплую ладонь, подсунула под неё свёрнутый край одеяла и тихо сползла к краю матраса."
        $ cs_rev_sfx("sound/sfx/bed_squeak1.ogg", 0.18)
        cs_narrator "Пружины всё-таки скрипнули."
        cs_narrator "Даша нахмурилась, пробурчала что-то неразборчивое — кажется, «оставь свет» — и, подтянув одеяло к подбородку, свернулась клубком."
        cs_narrator "Я выдохнула, поправила угол пледа и только потом пошла к стулу за одеждой."
    else:
        cs_narrator "Я повернула голову к соседней кровати."
        cs_narrator "Даша спала, замотавшись в одеяло так плотно, что наружу торчали только растрёпанная макушка и кончик носа."
        cs_narrator "Днём она всегда держалась ровно, могла одной фразой остановить любую мою сомнительную идею и с абсолютно серьёзным лицом спорить про упавшую тумбочку в старом корпусе."
        cs_narrator "Во сне всё это куда-то девалось, и сразу было видно, как сильно она устала за последние два дня."
        cs_narrator "На её тумбочке стояла пустая кружка из-под вчерашней воды и валялась тонкая резинка для волос."
        cs_narrator "Обычный домашний бардак человека, с которым за неделю успеваешь сжиться настолько, что уже не раздражаешься от чужих вещей в комнате."
        cs_narrator "Я аккуратно откинула одеяло и спустила ноги на прохладный пол."
        show cs_cg_d7_cabin_before_dawn with dissolve
        $ cs_rev_sfx("sound/sfx/wood_floor_squeak.ogg", 0.18)
        cs_narrator "Знакомая половица прямо у ножки кровати, как назло, сухо скрипнула."
        cs_narrator "Я замерла на месте и посмотрела на Дашу, уже ожидая услышать сонное «Соколова, ты куда на ночь глядя»."
        cs_narrator "Но она только вздохнула, перевернулась лицом к стене и продолжила спать."
        hide cs_cg_d7_cabin_before_dawn with dissolve
        cs_narrator "Я мысленно поставила себе плюс за скрытность и тихо пошла к стулу."
    cs_narrator "Белую футболку и чёрные спортивные шорты я нашла на ощупь, не включая лампу."
    cs_narrator "Одевалась быстро и тихо, стараясь не разбудить Дашу."
    cs_narrator "Кроссовки взяла в левую руку за задники — шнуроваться буду уже на крыльце, чтобы не шуршать тут в темноте."
    cs_narrator "На столе у окна лежала та самая тонкая книга из библиотеки с бумажной закладкой на первой странице."
    $ cs_rev_sfx("sound/sfx/paper_bag.ogg", 0.12)
    cs_narrator "Перед выходом я остановилась у стола, оторвала от блокнота уголок бумаги и быстро написала записку."
    cs_narrator "[cs_d7_departure_note]"
    cs_narrator "Прижала записку краем пустой кружки на самом видном месте, чтобы Даша не дёргалась, если проснётся раньше меня."
    cs_narrator "Я ещё раз глянула на свой рюкзак у стены — молния застёгнута, лямки не перекручены."
    cs_narrator "Поймала себя на мысли, что за эту неделю почти забыла, как пахнет нормальная акварель или обычный маркер, зато наизусть выучила, где скрипит каждая доска в этом домике."
    cs_narrator "У двери я на секунду обернулась, проверяя, не забыла ли чего."
    $ cs_rev_sfx("sound/sfx/door_squeak_light.ogg", 0.18)
    cs_narrator "Осторожно отвела задвижку и придержала ручку, чтобы петли не скрипнули."
    $ cs_d7_scene("cs_house_lena_darya_ext_day")
    scene cs_house_lena_darya_ext_day with dissolve
    $ cs_d7_ambience("sound/ambiences/forest_day.ogg")
    cs_narrator "Я вышла наружу, в прохладную тишину последнего утра."
    cs_narrator "Утро оказалось свежим и совсем тихим."
    jump cs_day07_02
