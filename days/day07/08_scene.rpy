# -*- coding: utf-8 -*-

label cs_day07_08:
    $ cs_d7_scene("cs_house_lena_darya_int_day")
    scene cs_house_lena_darya_int_day with dissolve
    $ cs_d7_ambience("sound/ambiences/int_cabin_day.ogg")
    cs_narrator "К одиннадцати мы вернулись в домик."
    cs_narrator "В комнате уже стояло то самое пустое эхо, какое всегда появляется на съёмной квартире или в гостинице за пару часов до выезда."
    cs_narrator "Когда мы только приехали сюда в начале смены, всё вокруг казалось казённым и чужим: старые тумбочки, жёсткие одеяла, скрипящая половица у кровати."
    cs_narrator "А стоило убрать с полок кружки и сложить одежду, как домик сразу стал выглядеть пустым и каким-то непривычно тихим."
    $ cs_d7_hide_portraits()
    show cs_cg_d7_packing with dissolve
    $ cs_rev_sfx("sound/sfx/paper_bag.ogg", 0.12)
    cs_narrator "Мы раскрыли сумки на кроватях и начали собираться без спешки."
    cs_narrator "Проверили каждый ящик, заглянули под подушки и под кровати, чтобы не забыть какую-нибудь мелочь."
    cs_narrator "Даша пересчитывала носки и тихо ворчала, что лагерная форма после стирки вообще не хочет складываться ровно, а я проверяла список вещей так, будто нам предстоял перелёт с двумя пересадками."
    cs_narrator "Я аккуратно убрала в рюкзак плотный конверт с нашими выписками и копиями, которые мы только что сверили с Ольгой."
    cs_narrator "Рядом положила блокнот, простой карандаш и сложенный пионерский галстук."
    cs_narrator "Потом на пару минут остановилась, глядя на кровать, где рядом с одеждой лежали те несколько мелких вещей, которые успели накопиться за шесть дней."

    if cs_d6_un_sketch_received:
        cs_narrator "Между двумя чистыми листами, чтобы не размазались карандашные штрихи, лежал утренний набросок Даши, который Лена Тихонова отдала мне вчера у ступенек автобуса."
        cs_narrator "Линии были тонкие, чуть неуверенные у плеч, но взгляд Даши — тот самый прищур, когда она делает вид, что вообще не позирует — Тихонова схватила очень точно."
        cs_narrator "Я проложила лист плотной обложкой блокнота и убрала в середину сумки, чтобы не помялся."
    if cs_d6_sl_badge_received:
        cs_narrator "В ладони блеснул аккуратный значок от Слави."
        cs_narrator "Обычная лагерная мелочь, но я сразу вспомнила вчерашнее утро, беготню со складом, пропавшую наволочку и то, как легко она умеет превращать любой бардак в простое понятное дело."
        cs_narrator "Я приколола значок к внутреннему карману рюкзака, чтобы не потерять."
    if cs_d6_dv_pick_received:
        cs_narrator "В боковом кармашке сумки звякнул потёртый медиатор Алисы — с чуть стёртым краем и мелкой царапиной посередине."
        cs_narrator "Единственная вещь в моём рюкзаке, которая вообще не вписывалась в аккуратные стопки."
        cs_narrator "Я покрутила его в пальцах, усмехнулась, вспомнив наше короткое прощание у ворот («и вам тут не сдохнуть от скуки, Соколова»), и сунула обратно."
    if cs_d6_mi_music_received:
        cs_narrator "В блокноте вместо закладки лежал сложенный вдвое листок с нотами и списком песен от Мику."
        cs_narrator "Мелкий, быстрый почерк — строчки лезли друг на друга точно так же, как она сама тараторит в разговоре."
        cs_narrator "Даже сейчас, глядя на этот листок, казалось, что рядом снова кто-то бодро рассказывает три истории сразу."
    if cs_d6_mz_address_received:
        cs_narrator "В отдельном кармане сумки, подальше от лагерных выписок, лежал листок с адресом Жени."
        cs_narrator "Ровные, угловатые буквы без единой помарки."
        cs_narrator "Я ещё раз проверила, не надорвался ли уголок, и про себя повторила улицу и номер дома — на случай, если бумага всё-таки пропадёт."
    if cs_d6_se_address_received:
        cs_narrator "Рядом с ним лежал сложенный вдвое листок с адресом Семёна, который он сунул мне перед посадкой со словами «чтобы не начала опять требовать»."
        cs_narrator "Даша, заметив бумажку у меня в руке, усмехнулась и кивнула."
        cs_da "Если он правда живёт в Москве, мы просто обязаны к нему заехать и посмотреть, как он там устроился."
        cs_da "Только без предупреждения не пойдём — а то он нас в дверь не пустит."
    hide cs_cg_d7_packing with dissolve
    $ cs_rev_sfx("sound/sfx/paper_bag.ogg", 0.1)
    cs_narrator "Я застегнула молнию на рюкзаке."
    cs_narrator "Звук вышел резким и каким-то окончательным."
    cs_narrator "Даша сделала то же самое со своей сумкой, и мы обе на пару секунд замерли посреди пустой комнаты."
    cs_narrator "Кровати были ровно заправлены, тумбочки пустые, шторы чуть шевелились от сквозняка."
    cs_narrator "В комнате вдруг стало неловко тихо — как на вокзале за пятнадцать минут до поезда, когда всё уже собрано, а говорить вроде и не о чем."
    show cs_darya neutral pioneer at cs_darya_normal_center with dissolve
    if cs_da_shared_bed_day3 and cs_da_love_confession_day3:
        cs_narrator "Даша поставила сумку у кровати, выпрямилась и посмотрела на меня."
        cs_narrator "Вся её обычная ирония куда-то делась — было видно, что она правда переживает."
        cs_da "Соколова…"
        cs_narrator "Начала она тихо и на секунду отвела глаза к окну."
        cs_da "Можно один глупый вопрос, пока мы ещё здесь?"
        cs_ls "Задавай."
        cs_ls "Сегодня без оценок."
        cs_da "А если там, дома, мы обе проснёмся, и всё это… ну, рассыплется?"
        cs_da "Или окажется, что это работало только здесь, в этом странном июле, а в январе мы станем двумя чужими людьми в разных районах Москвы?"
        cs_narrator "У меня внутри на секунду сжалось — точно так же, как вчера вечером, когда я боялась спросить, не проснёмся ли мы снова в этих кроватях."
        cs_narrator "Я шагнула к ней и взяла за обе руки."
        cs_narrator "Пальцы у неё были чуть прохладными, хотя на улице уже стояла жара."
        cs_ls "Не рассыплется."
        cs_narrator "Сказала я ровно."
        cs_ls "Ты настоящая, я настоящая, и это не выдумка лагеря."
        cs_ls "Я тебя найду, Даша."
        cs_ls "И ты меня найдёшь."
        cs_ls "Я не хочу тебя терять — ни здесь, ни в две тысячи двадцать шестом."
        cs_narrator "Она посмотрела на меня, потом медленно выдохнула, будто с плеч сняли тяжёлый рюкзак, и коротко улыбнулась."
        cs_narrator "Шагнула ближе и на пару секунд уткнулась лбом мне в плечо."
        cs_narrator "Я обняла её за спину и просто постояла так, слушая, как ровно она дышит."
    else:
        cs_narrator "Даша присела на край застёгнутой сумки и оглядела пустые полки тумбочки."
        cs_da "Странное чувство, правда?"
        cs_narrator "Сказала она негромко."
        cs_da "Неделю назад я знать не знала, кто такая Лена Соколова."
        cs_da "Ехала себе в зимнем автобусе, думала про свои дела."
        cs_da "А сейчас сижу и ловлю себя на том, что вообще не представляю, как вернусь в обычный московский понедельник без твоих язвительных комментариев."
        cs_narrator "Я усмехнулась, на этот раз спокойно, без привычной колючести."
        cs_ls "Мои язвительные комментарии отлично работают и в мессенджерах, Еретикова."
        cs_narrator "Я помолчала секунду и добавила уже серьёзно."
        cs_ls "Если честно, я сама не хочу, чтобы эта неделя закончилась просто пустым окном."
        cs_ls "Так что не теряйся, ладно?"
        cs_da "Даже не рассчитывай."
        cs_narrator "Ответила Даша, вставая."
        cs_da "Кто ещё будет следить, чтобы ты не полезла в очередной подозрительный подвал?"
    hide cs_darya with dissolve
    cs_narrator "Мы отнесли сумки к самой двери, чтобы потом не бегать за ними впопыхах."
    cs_narrator "До обеда оставалось почти сорок минут — как раз хватит сходить на пристань, как мы вчера и договаривались."
    jump cs_day07_09
