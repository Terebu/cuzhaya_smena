# -*- coding: utf-8 -*-

label cs_day07_09:
    $ cs_d7_scene("cs_camp_path_day")
    scene cs_camp_path_day with dissolve
    $ cs_d7_ambience("sound/ambiences/forest_day.ogg")
    $ cs_rev_music(cs_music_purrple_gentle_breeze, 0.14, 2.0, loop=False)
    cs_narrator "К полудню солнце окончательно разогрело воздух."
    cs_narrator "На тропинке к берегу пахло сухой хвоей, тёплым песком и водой."
    cs_narrator "В прошлые дни на пляже вечно кто-то орал, брызгался, спорил у лодочной станции, и спокойно посидеть здесь получалось только к вечеру."
    $ cs_d7_scene("bg ext_boathouse_day")
    scene bg ext_boathouse_day with dissolve
    $ cs_d7_ambience("sound/ambiences/lake_shore_day.ogg")
    cs_narrator "Сейчас вокруг было совсем тихо — только вдалеке трещали кузнечики да тихо плескалась вода о деревянные сваи."
    cs_narrator "Мы вышли на пристань."
    if cs_da_shared_bed_day3 and cs_da_love_confession_day3:
        $ cs_d7_hide_portraits()
        show cs_cg_d7_pier_romance with dissolve
    else:
        $ cs_d7_hide_portraits()
        show cs_cg_d7_pier_friendship with dissolve
    cs_narrator "Доски уже хорошо нагрелись, и когда мы сели на край, свесив ноги вниз, тепло сразу почувствовалось через ткань."
    cs_narrator "Вчера мы кидали здесь плоские камни и считали отскоки."
    cs_narrator "Сегодня камни искать не хотелось."
    cs_narrator "Хотелось просто посидеть, посмотреть на широкую, почти ровную воду, в которой отражалось чистое летнее небо без единого облака, и никуда не торопиться."
    cs_da "Ну что."
    cs_narrator "Заговорила первой Даша, щурясь от бликов на воде."
    cs_da "Поскольку я человек практичный, давай без киношных надежд, что мы случайно столкнёмся на улице."
    cs_da "Нормальный план, как мы находим друг друга в Москве две тысячи двадцать шестого года."
    cs_ls "Слушаю."
    cs_narrator "Отозвалась я."
    cs_ls "Тем более что случайные встречи на остановках у нас уже однажды закончились пионерлагерем."
    cs_narrator "Даша коротко фыркнула и качнула ногами над водой."
    cs_da "Вот именно."
    cs_da "Повторять не хочется."
    cs_da "Запоминай: Дарья Еретикова, Москва."
    cs_da "У меня есть публичный профиль — аудитория там живая, так что по имени и фамилии я выскочу почти сразу, особенно если добавишь пару моих рабочих тем."
    cs_da "В описании висит открытый контакт в мессенджере."
    cs_da "Если вдруг проснёмся без бумажек и без новых номеров в телефоне, просто вбиваешь меня в поиск и пишешь кодовую фразу, чтобы я поняла, что это не очередной бот."
    cs_ls "И какая у нас кодовая фраза?"
    cs_da "Например, про завтрак на четверых или про то, как ты проиграла Виоле в карты дважды подряд."
    cs_ls "Про карты я бы предпочла вообще забыть."
    cs_narrator "Сухо заметила я."
    cs_ls "Но «завтрак на четверых» годится."
    cs_ls "И твоё вчерашнее обещание неделю ничего не откладывать я тоже запомнила."
    cs_da "Отлично."
    cs_da "Значит, не отверчусь."
    cs_da "А если я первая тебя найду?"
    cs_da "У тебя вообще открытые сообщения есть, или ты сидишь в режиме секретного бункера?"
    cs_ls "В режиме умеренной недоступности."
    cs_narrator "Призналась я."
    cs_ls "Но я напишу первая."
    cs_ls "Обещаю не отсиживаться за чаем и не думать три дня, как поздороваться."
    cs_narrator "На пару минут мы замолчали."
    cs_narrator "По воде пробежал лёгкий ветер, смазав ровное отражение сосен на том берегу, и где-то далеко над рекой пролетела белая чайка."
    cs_narrator "Даша посмотрела вдаль и чему-то усмехнулась."
    cs_da "Смешно всё-таки."
    cs_narrator "Сказала она тише."
    cs_da "Вспомни тот январский автобус."
    cs_da "Две хмурые, замёрзшие незнакомки, каждая в своих мыслях, обе уверены, что сейчас спокойно доедут по делам."
    cs_da "А в итоге сидим здесь посреди лета и договариваемся, как не потеряться в собственном городе."
    cs_ls "Если бы мне в тот день сказали, что через неделю я буду сидеть на деревянном пирсе и всерьёз планировать поход в гости к парню из спального района, я бы вызвала себе врача."
    cs_da "Хорошо, что у нас под рукой уже была Виола."
    cs_narrator "Я посмотрела на неё сбоку."
    cs_narrator "Свет от воды падал ей на щёку и подбородок мягким светлым рефлексом, делая лицо чуть спокойнее, чем обычно."
    cs_narrator "Повторять вчерашний длинный разговор о том, кто что подумал при первой встрече, смысла не было — мы и так всё сказали."
    cs_narrator "Важно было другое, гораздо проще: человек рядом на этих нагретых досках давно перестал быть случайной попутчицей из того странного автобуса или удобной напарницей для проверки старых папок."
    cs_narrator "Я точно знала, что, как только открою глаза в Москве, первым делом буду искать именно её."
    if cs_da_shared_bed_day3 and cs_da_love_confession_day3:
        cs_narrator "Даша тихо сдвинула ладонь по доске, нашла мою руку и переплела пальцы."
        cs_narrator "Через секунду её голова легла мне на плечо."
        cs_narrator "От волос пахло солнцем и простым лагерным шампунем."
        cs_narrator "Мы посидели так несколько минут — без слов, без шуток, просто слушая, как плещется вода под пристанью."
        cs_narrator "И мне впервые за долгое время совсем не хотелось, чтобы эти минуты быстрее кончились."
        cs_da "Не забудь написать, Соколова."
        cs_narrator "Шепнула она, не поднимая головы."
        cs_ls "Не забуду, Даш."
    else:
        cs_narrator "Даша легонько толкнула меня плечом и покосилась с привычной усмешкой:"
        cs_da "Только одно условие, Соколова."
        cs_da "Когда найдёшь меня в Москве, не начинай встречу со слов «у меня есть три гипотезы о природе автобуса»."
        cs_da "Сначала мы пьём нормальный кофе и едим что-нибудь горячее."
        cs_ls "Обещаю."
        cs_narrator "Честно сказала я."
        cs_ls "Гипотезы пойдут только ко второму стакану."
    $ cs_rev_sfx("sound/sfx/dinner_horn_processed.ogg", 0.24)
    cs_narrator "Издалека, со стороны площади, донёсся негромкий сигнал — Ольга звала на последний обед."
    cs_narrator "Мы переглянулись, одновременно выдохнули и встали с пристани."
    cs_narrator "Я последний раз глянула на широкую светлую воду."
    $ cs_d7_scene("cs_camp_path_day")
    scene cs_camp_path_day with dissolve
    $ cs_d7_ambience("sound/ambiences/forest_day.ogg")
    cs_narrator "Потом пошла за Дашей вверх по тропинке."
    stop music fadeout 1.8
    jump cs_day07_10
