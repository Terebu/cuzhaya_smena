# -*- coding: utf-8 -*-

label cs_epilogue_03:
    $ cs_d7_scene("cs_bg_epi_lena_kitchen")
    scene cs_bg_epi_lena_kitchen with dissolve
    $ cs_d7_ambience(cs_lena_apartment_ambience)
    window show dissolve
    cs_narrator "Ждать чуда под дверью было бы глупо — в Москве никто сам в домофон не звонит, если не знает номера квартиры."
    cs_narrator "Я залила кипятком чай в кружке, перетащила ноутбук на кухонный стол и открыла поиск."
    cs_narrator "«Дарья Еретикова Москва»."
    cs_narrator "Первая страница выдала обычный мусор: пара полных тёзок, старый закрытый профиль, чья-то учебная работа пятилетней давности."
    cs_narrator "Внутри на секунду неприятно похолодело — а вдруг я правда всё это придумала?"
    cs_narrator "Вдруг в «Совёнке» голова просто собрала случайное имя из памяти, и никакой Даши с публичным профилем на самом деле нет?"
    cs_narrator "Я сделала глоток горячего чая, заставила себя не дёргаться и добавила в запрос пару конкретных рабочих тем, о которых Даша упоминала в лагере."
    cs_narrator "Обновила страницу."
    cs_narrator "Открыла вторую ссылку — не то."
    cs_narrator "Кликнула на третью — и пальцы на тачпаде замерли."
    cs_narrator "На экране открылся публичный профиль с живой аудиторией."
    cs_narrator "На аватарке — она."
    cs_narrator "В зимнем свитере, с тем самым прищуром и чуть насмешливым выражением лица, без лагерной формы и без летнего загара, но ошибиться было невозможно."
    cs_narrator "В шапке висела короткая ироничная подпись, последний пост вышел два дня назад, а внизу стояла открытая ссылка на рабочий контакт в мессенджере."
    cs_narrator "Сердце вдруг застучало быстрее — совсем не так спокойно, как утром на пробежке."
    cs_narrator "Я открыла чат."
    cs_narrator "Мигающий курсор в пустой строке ввода казался куда страшнее подвала в старом корпусе."
    cs_narrator "Что вообще писать девушке, с которой вы неделю делили домик, если она откроет сообщение и решит, будто ей пишет какая-то городская сумасшедшая?"
    cs_narrator "Я набрала одну фразу, стёрла."
    cs_narrator "Набрала вторую, снова стёрла."
    cs_narrator "Потом вспомнила наш разговор на пристани — и написала коротко, ровно так, как мы договаривались:"
    cs_narrator "«Если ты сегодня проснулась не в июле, помнишь завтрак на четверых и обещала неделю ничего не откладывать — ответь. Лена Соколова»."
    cs_narrator "Нажала «Отправить» и откинулась на спинку стула."
    cs_narrator "Прошло десять секунд."
    cs_narrator "Двадцать."
    cs_narrator "Тридцать."
    cs_narrator "Сообщение стало прочитанным — две синие галочки."
    cs_narrator "И тишина."
    cs_narrator "Я уже успела прикинуть три варианта, как сбежать с позором: от «Извините, я ошиблась чатом» до удаления аккаунта."
    cs_narrator "На сорок пятой секунде сверху наконец появилось: «печатает…»."
    cs_narrator "Ответ прилетел тремя короткими сообщениями подряд:"
    cs_narrator "«СОКОЛОВА.»"
    cs_narrator "«Ты настоящая. Я последние полчаса сижу на кровати и пытаюсь понять, не поехала ли у меня крыша.»"
    cs_narrator "«Не смей никуда пропадать. Через сорок минут у выхода из метро, я скидываю точку. Я уже натягиваю ботинки.»"
    cs_narrator "Я выдохнула так громко, что сама себя услышала."
    cs_narrator "Быстро натянула тёплый свитер, накинула пуховик и обмотала шарф."
    $ cs_d7_scene("cs_bg_epi_morning_street")
    scene cs_bg_epi_morning_street with dissolve
    $ cs_d7_ambience(cs_wind)
    cs_narrator "Я выскочила из подъезда на январский ветер."
    $ cs_rev_music(cs_music_purrple_gentle_breeze, 0.12, 2.0, loop=False)
    $ cs_d7_ambience(cs_path("audio/epilogue/metro_platform.ogg"), 0.19)
    $ cs_d7_scene("cs_bg_epi_metro_platform")
    scene cs_bg_epi_metro_platform with dissolve
    pause 0.45
    $ cs_d7_scene("cs_epilogue_travel")
    $ cs_rev_sfx(cs_path("audio/epilogue/metro_doors_close.ogg"), 0.19)
    scene cs_epilogue_travel with dissolve
    pause 0.85
    $ cs_d7_ambience(cs_path("audio/epilogue/metro_wagon.ogg"), 0.17)
    cs_narrator "Вся дорога в метро прошла как-то странно, на автопилоте."
    cs_narrator "В вагоне было душно, люди уткнулись в телефоны, за окном мелькали тёмные стены тоннеля."
    show cs_cg_epi_metro_reflection with dissolve
    cs_narrator "Я смотрела на своё отражение в стекле и ловила себя на том, что нервничаю: одно дело — переписаться в чате, и совсем другое — встретиться вживую посреди обычной зимней Москвы."
    cs_narrator "Осталось ли между нами то, что было в лагере?"
    cs_narrator "Не станет ли вдруг неловко, когда нет никаких загадок, а вокруг просто метро, а мы — две девушки в пуховиках?"
    $ cs_d7_scene("cs_bg_epi_metro_escalator")
    $ cs_d7_ambience(cs_path("audio/epilogue/metro_escalator.ogg"), 0.18)
    scene cs_bg_epi_metro_escalator with dissolve
    pause 0.5
    $ cs_d7_scene("cs_bg_epi_metro_exit")
    $ cs_d7_ambience(cs_wind)
    scene cs_bg_epi_metro_exit with dissolve
    $ cs_rev_music(cs_music_purrple_dancing_dandelions, 0.16, 2.0, loop=False)
    cs_narrator "Я вышла из вестибюля минут на пять раньше."
    cs_narrator "Мороз сразу щипал щёки, пахло снегом, реагентами и кофе из ларька у перехода."
    cs_narrator "Прохожие спешили мимо, пряча носы в шарфы."
    cs_narrator "Я отошла чуть в сторону от толпы, сунула руки в карманы и стала смотреть на тех, кто шёл от перехода."
    cs_narrator "И вдруг увидела её."
    cs_narrator "Даша шла со стороны перехода — в тёплой зимней куртке, с большим шарфом, из-под которого выбивались знакомые пряди, и с красными от ветра щеками."
    cs_narrator "Заметив меня, она сбавила шаг."
    cs_narrator "На пару секунд между нами повисла неловкая пауза: обе встали в трёх метрах друг от друга, проверяя глазами, правда ли это не глюк."
    show cs_epi_darya thoughtful winter at cs_ep_actor_center with dissolve
    show cs_epi_darya surprised winter with cs_sprite_change
    cs_da "Соколова?"
    cs_narrator "Спросила она чуть хрипло от мороза."
    cs_ls "Еретикова."
    cs_narrator "Ответила я."
    show cs_epi_darya soft_smile winter with cs_sprite_change
    cs_ls "Поздравляю, ты не вымышленный персонаж."
    cs_narrator "Она коротко, чуть нервно засмеялась."
    if cs_ep_romance:
        $ cs_d7_hide_portraits()
        show cs_cg_epi_metro_reunion_romance with dissolve
        cs_narrator "Последние три шага Даша сделала почти бегом и обняла меня так крепко, что мой шарф сбился набок, а холодный воротник её куртки прижался прямо к моей щеке."
        cs_narrator "Я не успела ничего пошутить — просто обняла её в ответ и уткнулась лицом ей в плечо."
        cs_da "Нашла."
        cs_narrator "Выдохнула она мне прямо в ухо."
        cs_narrator "Голос чуть дрогнул."
        cs_da "Сказала на пристани, что найдёшь — и правда нашла."
        cs_ls "Я же обещала."
        cs_narrator "Ответила я тихо, не торопясь её отпускать."
        cs_ls "Да и ты ответила в первую минуту."
        cs_ls "Засчитывается в «неделю без откладывания»."
        cs_narrator "Она чуть отстранилась, не убирая рук с моих плеч, внимательно посмотрела мне в глаза — будто окончательно убеждалась, что это правда я, — и коротко, тепло коснулась губами моего виска."
        cs_da "Пошли в тепло."
        cs_narrator "Сказала она, перехватывая мою ладонь в варежке."
        cs_da "А то мы сейчас тут окоченеем, и вся наша встреча закончится простудой."
    else:
        $ cs_d7_hide_portraits()
        show cs_cg_epi_metro_reunion_friend with dissolve
        cs_narrator "Даша сделала два шага вперёд, на секунду замерла, будто прикидывая, как себя вести, а потом махнула рукой и крепко обняла меня за плечи."
        cs_da "Ну здравствуй, Соколова из двадцать шестого года!"
        cs_narrator "Выдохнула она, отстраняясь и с облегчением улыбаясь."
        cs_da "Честно, я до последней секунды боялась, что сейчас подойду, а ты посмотришь на меня как на городскую сумасшедшую и спросишь, кто я такая."
        cs_ls "Если бы я ничего не помнила, я бы не разыскивала тебя по открытым каналам в девять утра."
        cs_narrator "Ответила я."
        cs_da "Справедливо."
        cs_da "Хотя в твоём стиле было бы найти меня просто из научного любопытства."
        cs_da "Пойдём в кофейню за углом?"
        cs_da "У меня пальцы уже не гнутся."
    $ cs_d7_scene("cs_epilogue_coffee")
    $ cs_d7_ambience(cs_path("audio/epilogue/coffee_shop.ogg"), 0.12)
    scene cs_epilogue_coffee with dissolve
    stop music fadeout 1.8
    cs_narrator "Мы зашли в маленькую кофейню в двух шагах от метро, взяли два больших стакана горячего кофе, по круассану и сели за угловой столик у запотевшего окна."
    cs_narrator "Пока разматывали шарфы, расстёгивали куртки и грели пальцы о тёплый картон, первые минуты всё ещё казались немного странными — кофемашина шипела слишком громко, а за стеклом ехали обычные московские машины."
    show cs_cg_epi_darya_coffee with dissolve
    cs_ls "У меня в карманах пусто."
    cs_narrator "Сказала я первой, ставя стакан на стол."
    cs_ls "Ни конверта с выписками, ни записей, ни бумажек."
    cs_ls "У тебя так же?"
    cs_da "Абсолютно."
    cs_narrator "Кивнула Даша, отламывая кусок круассана."
    cs_da "Проснулась у себя, телефон заряжен, за окном январь, никаких летних вещей."
    cs_da "Я даже в шкаф заглянула на всякий случай — вдруг там висит пионерский галстук."
    cs_da "Не висит."
    cs_da "Но я помню всё до мелочей."
    cs_da "Даже как ты в старом корпусе уронила ту несчастную коробку и с каменным лицом сказала, что пострадала только твоя самооценка."
    cs_ls "Между прочим, коробка стояла на самом краю."
    cs_ls "Это была очевидная недоработка тумбочки."
    cs_da "А ещё помню, как ты в шестой день с гордым видом побила карту Виолы не той мастью и пыталась взять её убедительностью."
    cs_ls "Еретикова, мы договаривались не вспоминать позорные моменты моей биографии до второго стакана кофе."
    cs_narrator "Даша легко рассмеялась и сделала большой глоток."
    cs_da "Знаешь, что самое странное?"
    cs_narrator "Сказала она чуть тише, помешивая кофе деревянной палочкой."
    cs_da "Я позвонила своим ещё до того, как ты написала."
    cs_da "Всё нормально, никто меня не терял."
    cs_da "А внутри всё равно такое чувство, будто я вернулась из очень долгой поездки и наконец-то встретила единственного человека, который был там со мной."
    cs_ls "Понимаю."
    cs_narrator "Ответила я."
    cs_ls "Утром в квартире было так тихо, что мне впервые захотелось поскорее оттуда уйти."
    if cs_d7_voice_shared:
        cs_narrator "Даша чуть посерьёзнела и посмотрела на меня поверх стакана."
        cs_da "Слушай… а тот голос, который ты слышала утром у библиотеки?"
        cs_da "Сегодня ничего такого не было?"
        cs_ls "Нет."
        cs_narrator "Я качнула головой."
        cs_ls "Ни дома, ни в метро."
        cs_ls "Полная тишина."
        cs_ls "И пусть так и остаётся."
        cs_da "Поддерживаю."
        cs_da "Хватит с нас загадок на ближайшие лет десять."
    else:
        hide cs_cg_epi_darya_coffee with dissolve
        cs_narrator "Я посмотрела в запотевшее окно кофейни на прохожих в шапках и проезжающие машины."
        cs_narrator "Утренний голос у библиотеки остался там, за вчерашним днём."
        show cs_cg_epi_darya_coffee with dissolve
    cs_narrator "Мы допили кофе почти до дна, и обе одновременно подумали об одном и том же."
    cs_narrator "Если мы обе настоящие, обе проснулись в январе 2026 года и помним каждую мелочь смены — значит, те, кто уехал на день раньше нас, тоже никуда не пропали."
    $ cs_ep_found_dasha = True
    jump cs_epilogue_04
