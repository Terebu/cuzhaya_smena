# -*- coding: utf-8 -*-

label cs_epilogue_04:
    if not renpy.showing("cs_epilogue_coffee"):
        $ cs_d7_scene("cs_epilogue_coffee")
        scene cs_epilogue_coffee with dissolve
        $ cs_d7_ambience(cs_path("audio/epilogue/coffee_shop.ogg"), 0.12)
    if not renpy.showing("cs_cg_epi_darya_coffee"):
        $ cs_d7_hide_portraits()
        show cs_cg_epi_darya_coffee with dissolve
    cs_narrator "Даша первой сказала вслух то, о чём мы обе думали последние пять минут."
    cs_narrator "Покрутила в руках пустой стакан, прищурилась и посмотрела на меня:"
    cs_da "Ну что, Соколова."
    cs_da "Мы с тобой друг друга проверили."
    cs_da "Теперь главный вопрос смены: проверяем, есть ли наш Сёмочка в реальной Москве?"
    cs_ls "Проверяем."
    cs_narrator "Ответила я сразу."
    cs_ls "Если я сегодня его не увижу своими глазами, я до конца зимы буду гадать, не остался ли он в том автобусе."
    cs_da "Только договоримся заранее: если он правда здесь, не начинай с допроса и не доставай блокнот на пороге."
    cs_da "Он и в лагере от тебя иногда хотел спрятаться за ближайшим кустом."
    cs_ls "Клевета, Еретикова."
    cs_ls "Мы вполне мирно попрощались."
    cs_ls "Он даже не сбежал, когда я его обняла."
    if cs_d6_se_address_received:
        cs_narrator "Я достала телефон и открыла карту."
        cs_narrator "В шестой день у ступенек автобуса Семён сунул мне сложенный листок со словами «чтобы не начала опять требовать»."
        cs_narrator "Бумага осталась в лагере, но я дважды перечитывала адрес, когда складывала вещи в седьмой день."
        cs_narrator "Улица, номер дома, корпус, квартира — всё всплыло в памяти целиком, без пробелов."
        cs_narrator "Я вбила адрес в поиск и нажала «Найти»."
        cs_narrator "Через секунду на карте загорелась красная точка."
        cs_narrator "Обычный московский спальный район на окраине, типовая панелька."
        cs_narrator "Сорок минут на метро и ещё пара остановок на автобусе."
        cs_ls "Адрес настоящий."
        cs_narrator "Сказала я, поворачивая экран к Даше."
        cs_ls "Дом стоит, подъезды на месте, этаж высокий."
        $ cs_rev_sfx("sound/sfx/knock_glass.ogg", 0.14)
        cs_narrator "Даша присвистнула и отставила стакан."
        cs_da "Значит, не наврал наш хиккикомори."
        cs_da "Ну что, едем?"
        cs_da "Только давай по дороге зайдём в пекарню и купим что-нибудь к чаю."
        cs_da "Прийти к человеку без предупреждения, да ещё и с пустыми руками — это уже какой-то рейд налоговой."
        cs_ls "Согласна."
        cs_ls "Тем более если он правда живёт так, как рассказывал, к чаю у него в лучшем случае найдётся пара пакетиков сахара."
        cs_narrator "Даша нашла профиль Семёна по имени и району, и я написала ему, что мы собираемся в гости."
        cs_narrator "Он ответил, когда мы уже одевались: «Заходите, только дайте мне двадцать минут»."
        cs_narrator "Мы собрались и вышли на мороз."
    else:
        cs_narrator "Адреса у нас не было, а тыкать пальцем в карту наугад смысла не имело."
        cs_narrator "Я достала телефон, Даша разблокировала свой, и наш угловой столик в кофейне на полчаса превратился в маленький штаб."
        cs_ls "Так, по методу Жени."
        cs_narrator "Сказала я, подтягивая к себе салфетку."
        cs_ls "Что мы о нём точно знаем?"
        cs_ls "Имя, примерный возраст, технический вуз, привычка сидеть по ночам на старых форумах и вечное ворчание про спальный район и автобусы."
        cs_da "Не густо для двенадцатимиллионного города."
        cs_narrator "Честно сказала Даша, но тут же начала вбивать варианты в поиск."
        cs_da "Ладно, давай пробовать через ники и старые площадки."
        cs_narrator "Первые двадцать минут не дали вообще ничего: десятки закрытых профилей, заброшенные страницы и однофамильцы, которые к нашему Семёну не имели никакого отношения."
        cs_narrator "Я уже начала думать, что без бумажки мы сегодня так и останемся ни с чем, как вдруг Даша резко выпрямилась и ткнула пальцем в свой экран:"
        cs_da "Соколова, стой!"
        cs_da "Смотри сюда."
        cs_narrator "Я наклонилась к её телефону."
        cs_narrator "На старом техническом форуме и в привязанном профиле на фриланс-бирже совпало всё: имя, возраст, тот самый вуз и знакомая, чуть усталая манера отшучиваться."
        cs_narrator "В районной ветке нашёлся и свежий комментарий про вечные зимние пробки на маршруте № 410."
        cs_narrator "В шапке фриланс-профиля висел открытый контакт в мессенджере."
        cs_ls "Обалдеть."
        cs_narrator "Выдохнула я."
        cs_ls "Ты только что сделала работу за целую библиотеку."
        cs_da "Просто умею искать живых людей."
        cs_narrator "Усмехнулась Даша."
        cs_da "Пиши ему."
        cs_da "Только помягче, чтобы он телефон в окно не выкинул."
        cs_narrator "Я открыла чат и написала коротко: «Совёнок. Прощание у ворот и автобус. Если ты это помнишь — скинь адрес, мы с Дашей в Москве и хотели бы убедиться, что ты не приснился. Лена Соколова»."
        cs_narrator "Ответ пришёл через три минуты."
        cs_narrator "Сначала — короткое, совершенно растерянное: «Вы серьёзно?! Это не розыгрыш?»"
        cs_narrator "Я быстро ответила про «Сёмочку» и маленькую ручную кладь."
        cs_narrator "Через десять секунд в чат прилетели улица, номер дома, подъезд и квартира с припиской: «Если это правда вы — приезжайте. Только предупреждаю, я не убирался»."
    call cs_epilogue_choose_contact from cs_ep_final_contact_return
    $ cs_d7_scene("cs_bg_epi_semen_yard_day")
    scene cs_bg_epi_semen_yard_day with dissolve
    $ cs_d7_ambience(cs_wind)
    cs_narrator "По дороге мы забежали в магазин и взяли коробку свежего печенья и пачку нормального листового чая."
    cs_narrator "До нужного двора мы добрались уже ближе к полудню."
    cs_narrator "Заснеженные шестнадцатиэтажки, расчищенная дворником узкая дорожка, засыпанные снегом машины вдоль бордюра — самый обычный, ничем не примечательный зимний спальный район."
    $ cs_d7_scene("cs_bg_epi_landing")
    $ cs_d7_ambience(cs_path("audio/ambience/lena_apartment_winter.mp3"), 0.10)
    scene cs_bg_epi_landing with dissolve
    cs_narrator "В подъезде оказалось прохладно."
    cs_narrator "Мы вызвали лифт и поднялись на высокий этаж."
    $ cs_rev_sfx(cs_path("audio/epilogue/lift_chime.ogg"), 0.18)
    cs_narrator "Лифт мягко звякнул."
    cs_narrator "Перед нами была обычная металлическая дверь с чуть потёртым номером."
    cs_narrator "Мы переглянулись с Дашей."
    cs_narrator "Она коротко кивнула, и я нажала кнопку звонка."
    $ cs_rev_sfx("sound/sfx/door_bell.ogg", 0.22)
    pause 0.55
    jump cs_epilogue_05
