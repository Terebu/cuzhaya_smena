# -*- coding: utf-8 -*-

label cs_epilogue_06:
    if cs_ep_guest == 'sl':
        cs_narrator "Не успела я даже открыть рот для первого едкого замечания, как из-за двери на кухню выглянула Славя."
        cs_narrator "На ней были мягкий светлый вязаный свитер и обычные синие джинсы, а две знакомые золотистые косы были аккуратно перекинуты через плечо."
        cs_narrator "Без пионерской формы она выглядела чуть взрослее и совсем по-домашнему — не как кто-то из летнего сна, а как обычная девушка, которая зашла с зимней улицы и уже успела обжиться на чужой кухне."
        show cs_epi_semen neutral home at cs_ep_actor_right
        show cs_epi_slavya soft_smile casual at cs_ep_actor_left
        hide cs_epi_darya
        with dissolve
        sl "Лена!"
        sl "Даша!"
        show cs_epi_slavya surprised casual with cs_sprite_change
        sl "Вот это встреча!"
        cs_narrator "Она вытерла руки о кухонное полотенце и быстро шагнула к нам."
        sl "Семён говорил, что вы можете объявиться, но я до последнего не верила, что мы все вот так соберёмся в одном подъезде."
        show cs_epi_slavya soft_smile casual with cs_sprite_change
        sl "Проходите скорее, чайник как раз на плите."
        cs_narrator "Она коротко и крепко обняла сначала Дашу, потом меня — так просто, будто вчера мы не прощались у лагерных ворот, а просто разошлись по домам после пар."
        cs_ls "Привет, Славя."
        cs_narrator "Улыбнулась я."
        cs_ls "Сразу к главному вопросу: пропавшую наволочку со склада у себя в сумке не нашла?"
        show cs_epi_slavya thoughtful casual with cs_sprite_change
        sl "Нет, обошлось без заговора."
        cs_narrator "Рассмеялась она."
        sl "Я проверила первым делом, когда проснулась."
        sl "Зато нашла здесь кое-что гораздо интереснее."
        $ cs_d7_hide_portraits()
        show cs_cg_epi_semen_cleanup_slavya with dissolve
        cs_narrator "Я сделала шаг в комнату, по привычке готовясь к санитарной проверке — и реально замерла."
        cs_narrator "То, что на первый взгляд казалось обычной берлогой Семёна, на деле уже было почти полностью приведено в нормальный вид."
        cs_narrator "Коробки из-под доставки не валялись по полу, а были аккуратно сплющены и сложены ровной стопкой у двери на вынос."
        cs_narrator "Стол перед широкоформатным монитором оказался расчищен, кабели Type-C собраны и перетянуты стяжкой, одежда убрана в шкаф, а по центру комнаты блестел свежевымытый пол."
        cs_narrator "Семён стоял у окна с двумя кружками и выглядел так, будто только что пережил вежливое, но совершенно неизбежное стихийное бедствие."
        cs_sy "Я сам собирался разобрать, честно!"
        cs_narrator "Поспешно оправдался он, глядя на нас."
        cs_sy "Просто Славя нашла меня ещё утром, зашла на полчаса поговорить, увидела угол со шнурами и пакетами с маркетплейсов и за пять минут составила план работ из четырёх пунктов."
        cs_sy "С ней же спорить бесполезно — она не ругается, она просто берёт тряпку и смотрит так, что тебе самому стыдно сидеть."
        sl "Не преувеличивай, Семён."
        cs_narrator "Мягко рассмеялась Славя, забирая у меня пакет с печеньем и унося его на кухню."
        sl "Мы просто навели базовый порядок, чтобы было куда поставить кружки."
        sl "И ты сам почти всё вынес на балкон, я только подсказала, с чего начать."
        cs_sy "«Подсказала»."
        cs_narrator "Пробормотал Семён, но без злости."
        cs_sy "Вы бы видели, как она раскладывала мои провода по длине."
        cs_narrator "Я из чистого упрямства всё-таки прошлась глазами по комнате."
        cs_narrator "Подоконник — чистый."
        cs_narrator "Заглянула за ножку компьютерного стола, прищурилась, посмотрела под край дивана."
        cs_narrator "Да, глубоко под мебелью ещё лежала тонкая полоска пыли, куда швабра просто не дотянулась."
        cs_narrator "Я открыла рот, потом закрыла его, сложила руки на груди и честно посмотрела на вернувшуюся из кухни Славю:"
        cs_ls "Ладно, Славя."
        cs_ls "Сдаюсь."
        cs_ls "Я честно искала, к чему придраться, и нашла только пыль под диваном, но объявлять из-за неё санитарное бедствие уже неприлично."
        cs_ls "Санэпидемстанция сегодня остаётся без работы."
        cs_da "Семён, тебе дико повезло, что она пришла раньше Соколовой."
        cs_narrator "Авторитетно сказала Даша."
        cs_da "Лена бы тебя ещё заставила составить опись всех пакетов по датам заказа."
        $ cs_d7_scene("cs_bg_epi_semen_clean")
        scene cs_bg_epi_semen_clean with dissolve
        $ cs_ep_room_clean = True
        show cs_epi_semen neutral home at cs_ep_actor_right
        show cs_epi_slavya soft_smile casual at cs_ep_actor_left
        hide cs_epi_darya
        with dissolve
        $ cs_rev_sfx("sound/sfx/broom_sweep.ogg", 0.14)
        cs_narrator "Семён убрал швабру в угол и вдруг стал чуть серьёзнее, без обычной защитной усмешки:"
        show cs_epi_semen soft_smile home with cs_sprite_change
        cs_sy "Если честно, я рад, что она пришла."
        show cs_epi_semen sad home with cs_sprite_change
        cs_sy "Я утром проснулся, посидел час перед выключенным монитором и уже решил, что снова останусь тут один и всё это мне просто привиделось."
        show cs_epi_semen soft_smile home with cs_sprite_change
        cs_sy "А потом Славя позвонила в дверь — и всё как-то встало на место."
        cs_narrator "Славя тепло улыбнулась ему, потом повернулась к нам:"
        if cs_d6_help == 'sl':
            sl "Спасибо тебе за вчерашнее утро, Лен."
            sl "Без вас с Дашей я бы и правда не успела собраться до автобуса."
            sl "А теперь пошлите на кухню — чайник уже свистит, и можно наконец нормально поговорить."
        else:
            sl "Хорошо, что вы приехали."
            sl "А теперь на кухню, пока чайник не выкипел."
    elif cs_ep_guest == 'dv':
        cs_narrator "Из комнаты донёсся негромкий ленивый аккорд — кто-то перебирал струны без комбика, проверяя строй."
        cs_narrator "Я шагнула за порог и сразу увидела Алису."
        cs_narrator "Она сидела, закинув ногу на ногу, на диване — единственном более-менее чистом островке посреди всего этого январского завала."
        cs_narrator "На ней были тёмное свободное худи с потёртым принтом и чёрные джинсы, а рыжие волосы всё так же были собраны в два знакомых хвоста."
        cs_narrator "Рядом с ней, прямо среди коробок доставки и пакетов с маркетплейсов, приткнулся мягкий гитарный чехол."
        show cs_epi_semen neutral home at cs_ep_actor_right
        show cs_epi_alisa neutral casual at cs_ep_actor_left
        hide cs_epi_darya
        with dissolve
        show cs_epi_alisa soft_smile casual with cs_sprite_change
        dv "О, явились не запылились!"
        cs_narrator "Алиса усмехнулась, откладывая гитару на подлокотник и задирая подбородок."
        dv "А я думала, Семён заливает, когда сказал, что Соколова его и в Москве из-под земли достанет."
        cs_ls "Привет, Двачевская."
        cs_narrator "Отозвалась я, невольно улыбаясь."
        cs_ls "Гитара всё-таки доехала отдельным местом багажа?"
        dv "Естественно."
        dv "Я же не брошу инструмент."
        show cs_epi_alisa thoughtful casual with cs_sprite_change
        dv "Хотя, честно говоря, когда я сегодня утром проснулась у себя дома и увидела её в углу, меня на пару минут реально переклинило."
        dv "Потом нашла контакты этого деятеля, приехала проверить, не поехала ли у меня крыша — а он тут сидит, как будто и не уезжал никуда."
        cs_narrator "Семён, пользуясь паузой, попробовал незаметно задвинуть ногой под стол шуршащий пакет с маркетплейса, но пакет предательски затрещал на всю комнату."
        show cs_epi_semen surprised home with cs_sprite_change
        cs_sy "Эй, я предупреждал, что у меня рабочий беспорядок!"
        dv "Рабочий беспорядок — это когда на столе лежит медиатор, пара тетрадей и шнур от комбика."
        cs_narrator "Спокойно отрезала Алиса, потом перевела насмешливый взгляд на меня."
        show cs_epi_alisa angry casual with cs_sprite_change
        dv "Только сразу предупреждаю, Соколова: в домработницы я к нему не нанималась."
        dv "Я свой угол у дивана расчистила, чтобы было куда сесть и чехол поставить."
        dv "Весь остальной полигон — ваши с ним разборки."
        cs_ls "Справедливое разделение труда."
        cs_narrator "Сказала я, снимая тёплый свитер и оставаясь в тонкой кофте."
        cs_ls "По крайней мере, честно."
        cs_ls "Значит, объявляю санэпидемстанцию."
        cs_ls "Даша, бери пакеты для мусора на кухне."
        cs_ls "Семён, ты отвечаешь за стол, узел проводов Type-C и пустые кружки."
        cs_ls "И даже не пытайся сделать вид, что у тебя срочный рабочий созвон."
        cs_sy "Погодите, вы же вообще-то в гости пришли!"
        cs_narrator "Слабо запротестовал Семён, отступая к компьютерному креслу."
        cs_ls "В гости приходят туда, где видно пол, Сёмочка."
        cs_narrator "Ответила я."
        cs_ls "А у тебя тут археологический слой с декабря."
        cs_da "Не ной, Семён."
        cs_narrator "Подбодрила его Даша, уже возвращаясь из кухни с рулоном чёрных мешков."
        cs_da "Зато к вечеру найдёшь, куда положил вторую зарядку."
        cs_da "Давай, я начну с угла у шкафа."
        cs_narrator "Семён обречённо вздохнул и взялся за стол."
        cs_narrator "Алиса сначала просто наблюдала за нашей уборкой с дивана, лениво дёргая одну струну и подкидывая едкие шуточки про «отряд специального назначения»."
        $ cs_rev_sfx("sound/sfx/paper_bag.ogg", 0.16)
        cs_narrator "Но когда я проходила мимо неё с раскрытым мешком, она всё-таки фыркнула, наклонилась, подхватила две пустые коробки из-под пиццы и банку от энергетика возле своего чехла и метко закинула всё прямо в пакет:"
        show cs_epi_alisa soft_smile casual with cs_sprite_change
        dv "Ладно, только чтобы ты не начала читать мне лекцию про санитарию, товарищ инспектор."
        dv "Свою зону я держу в чистоте."
        $ cs_d7_hide_portraits()
        show cs_cg_epi_semen_cleanup_alisa
        with dissolve
        cs_narrator "Даша протёрла стол, я собрала обёртки с пола, а Семён подхватил полные пакеты."
        $ cs_d7_scene("cs_bg_epi_semen_clean")
        scene cs_bg_epi_semen_clean with dissolve
        $ cs_ep_room_clean = True
        $ cs_d7_hide_portraits()
        show cs_cg_epi_guest_alisa with dissolve
        cs_narrator "Через полчаса комната перестала выглядеть как пункт выдачи заказов, мешки переехали в прихожую, а Семён, вытирая лоб, плюхнулся в кресло."
        cs_narrator "Алиса снова взяла гитару, покрутила колок и тихо сыграла короткий цепкий рифф — не на показ, а просто проверяя звук в обычной комнате."
        dv "В «Совёнке» струны были хуже."
        cs_narrator "Заметила она, глядя на гриф."
        dv "Слушайте, у нас на следующей неделе репетиция на точке."
        dv "Если не боитесь громкого звука, приходите все трое."
        dv "Семёну вообще полезно вылезти из-за монитора, а тебе, Соколова, я наконец отдам нормальный медиатор вместо того, что остался в лагере."
        dv "Одной проверять, не приснился ли весь этот цирк, было бы скучновато."
        cs_ls "По рукам, Двачевская."
        cs_narrator "Улыбнулась я."
        cs_ls "Придём."
        cs_sy "А сейчас пошлите на кухню."
        cs_narrator "Поднялся Семён."
        cs_sy "Чайник, кажется, уже закипел, пока вы мне ещё и обои не переклеили."
    elif cs_ep_guest == 'mi':
        $ cs_rev_music(cs_music_purrple_dancing_dandelions, 0.16, 2.0, loop=False)
        cs_narrator "Едва мы переступили порог, из комнаты донеслась бодрая негромкая мелодия из портативной колонки, а навстречу нам буквально вылетела Мику."
        cs_narrator "На ней были яркий тёплый свитшот и удобные джинсы, большие беспроводные наушники висели на шее, а длинные циановые хвосты качнулись, когда она резко затормозила в полушаге от нас."
        show cs_epi_semen neutral home at cs_ep_actor_right
        show cs_epi_miku soft_smile casual at cs_ep_actor_left
        hide cs_epi_darya
        with dissolve
        mi "Лена!"
        mi "Даша!"
        show cs_epi_miku surprised casual with cs_sprite_change
        mi "Вы тоже здесь, ура!"
        cs_narrator "Она обняла нас обеих почти одновременно, не сбавляя темпа."
        mi "Представляете, я сегодня утром проснулась, сначала вообще не поняла, почему за окном снег, а не сосны, потом вспомнила про Семёна, нашла его, мы полчаса сидели и проверяли друг друга по мелочам, чтобы убедиться, что мы не сошли с ума!"
        show cs_epi_miku soft_smile casual with cs_sprite_change
        mi "А потом я посмотрела на комнату и решила помочь ему прибраться, потому что тут был настоящий завал, но пока мы разбирали стол, я нашла его старую флешку с записями, и мы решили послушать буквально один трек, а потом ещё один, и вот!"
        cs_narrator "Я перевела дух — за одну её реплику в комнате сразу стало вдвое шумнее — и оглядела результат их совместного порыва."
        cs_narrator "Следы уборки действительно были, но в какой-то совершенно своей, творческой логике."
        cs_narrator "Кружки на подоконнике стояли по цветам от светлых к тёмным, бумаги были переложены футлярами от дисков, а коробки у шкафа сложены ровной пирамидой."
        cs_narrator "Посреди пола сиротливо стояло ведро с тряпкой, про которое оба забыли минуте на третьей плейлиста."
        cs_narrator "Семён беспомощно развёл руками, глядя на нас с виноватой улыбкой:"
        show cs_epi_semen thoughtful home with cs_sprite_change
        cs_sy "Я честно пытался держать темп, девочки."
        cs_sy "Правда."
        cs_sy "Мы даже начали складывать коробки, но она услышала старый трек, начала объяснять про аранжировку и переходы, и всё встало."
        $ cs_d7_hide_portraits()
        show cs_cg_epi_guest_miku with dissolve
        mi "Ну там правда был очень классный бас в припеве!"
        cs_narrator "Горячо вступилась Мику, поправляя наушники на шее."
        mi "Лен, я даже вспомнила ту мелодию, которую записывала тебе на листке в шестой день!"
        mi "Жалко, что бумага осталась там, но я её почти всю помню наизусть."
        mi "Если я допишу припев дома на нормальном софте, поможешь мне с обложкой для сингла?"
        mi "Ты же художница, у тебя глаз сразу схватывает настроение!"
        cs_narrator "На секунду я даже растерялась — за последнюю неделю со всеми этими проверками и папками я почти забыла, как приятно слышать, что кто-то помнит, чем я вообще занимаюсь."
        cs_ls "С удовольствием, Мику, обязательно."
        cs_narrator "Улыбнулась я, снимая куртку и закатывая рукава."
        cs_ls "Только сначала мы спасём эту комнату, пока ведро не приросло к линолеуму."
        cs_ls "Творческий подход — это здорово, но теперь систему беру на себя."
        cs_ls "Музыка остаётся фоном, а мы работаем по плану."
        cs_da "О, командный голос Соколовой!"
        cs_narrator "Весело отозвалась Даша."
        cs_da "Семён, прячься, сейчас будет распределение обязанностей."
        cs_ls "Итак."
        cs_narrator "Сказала я, оглядывая фронт работ."
        cs_ls "Даша, идём по часовой стрелке от двери и разбираем пирамиду из коробок."
        cs_ls "Семён — мусорные пакеты и пылесос, без права побега."
        cs_ls "А мы с Мику разгребаем стол, флешки и диски — только обещай не переключать треки, пока не будет видно всей столешницы, — и заодно обсудим, какие цвета ты видишь для этой обложки."
        mi "Синий и тёплый жёлтый, как фонари зимой на снегу!"
        $ cs_rev_sfx("sound/sfx/paper_bag.ogg", 0.12)
        hide cs_cg_epi_guest_miku
        show cs_cg_epi_semen_cleanup_miku
        with dissolve
        cs_narrator "Сразу загорелась Мику, начиная складывать флешки и переходники в отдельную коробку и напевая в такт колонке."
        cs_narrator "Через полчаса под её нескончаемую болтовню и редкое ворчание Семёна мы вчетвером превратили этот художественный бардак в вполне нормальную комнату, где наконец-то можно было спокойно пройти к окну."
        $ cs_d7_scene("cs_bg_epi_semen_clean")
        scene cs_bg_epi_semen_clean with dissolve
        $ cs_ep_room_clean = True
        cs_narrator "Мику с гордостью оглядела чистый стол, подхватила нашу коробку с печеньем и первой потащила всех на кухню ставить чайник."
        $ cs_rev_music(cs_music_purrple_calm_waters, 0.11, 2.0)
    elif cs_ep_guest == 'mz':
        cs_narrator "У окна, спиной к заснеженному стеклу, стояла Женя — в строгой тёмной водолазке, прямых джинсах и своих привычных очках."
        cs_narrator "Первое, что бросилось в глаза, едва я зашла в комнату, — смешной контраст прямо посреди одного пространства."
        cs_narrator "Письменный стол и единственная книжная полка выглядели так, будто их только что приняла комиссия."
