# -*- coding: utf-8 -*-

label cs_epilogue_07:
    stop music fadeout 1.8
    $ cs_d7_scene("cs_bg_epi_semen_yard_evening")
    scene cs_bg_epi_semen_yard_evening with dissolve
    $ cs_d7_ambience(cs_wind)
    cs_narrator "Когда мы попрощались и вышли из подъезда Семёна, на улице уже стемнело."
    $ cs_rev_sfx(cs_path("audio/epilogue/snow_steps.ogg"), 0.19)
    cs_narrator "Небо над шестнадцатиэтажками стало тёмно-синим, в окнах зажглись тёплые жёлтые квадраты, а мороз к вечеру заметно усилился — снег под ботинками сухо скрипел."
    cs_narrator "Во дворе кто-то грел машину, счищая щёткой снег с лобового стекла, а вдалеке ровно шумела большая дорога."
    cs_narrator "Тротуар уже успело припорошить свежим снегом, а там, где дворники посыпали реагентом, под ногами блестела тёмная каша."
    cs_narrator "Свет от фонарей ложился на сугробы тёплыми жёлтыми кругами, и тени от машин тянулись по снегу длинными синими полосами."
    cs_narrator "Я мельком подумала, что надо будет дома наконец открыть альбом и сделать пару быстрых зимних зарисовок, пока не забылось это ощущение."
    cs_narrator "Мы шли к остановке не спеша, засунув руки поглубже в карманы пуховиков."
    $ cs_d7_scene("cs_stop")
    scene cs_stop with dissolve
    cs_narrator "Под стеклянным козырьком стояли ещё трое прохожих и прятались от ветра."
    cs_narrator "На электронном табло оранжевыми цифрами горело: «410 — через 2 мин»."
    cs_narrator "Я машинально достала телефон из кармана."
    cs_narrator "Заряд семьдесят восемь процентов, связь полная, карта показывала обычный маршрут через проспект до метро — без единого сбоя, без провалов и без странных конечных остановок."
    show cs_epi_darya neutral winter at cs_ep_actor_center with dissolve
    cs_da "Ну что, Соколова."
    cs_narrator "Сказала Даша, пряча подбородок в шарф и щурясь от редких снежинок в свете фонаря."
    show cs_epi_darya thoughtful winter with cs_sprite_change
    cs_da "Не страшно садиться в четыреста десятый?"
    cs_ls "У меня чёткий план безопасности."
    cs_narrator "Серьёзно ответила я."
    cs_ls "Если водитель окажется в летней рубашке или внутри запахнет соснами, выходим на следующей остановке."
    cs_ls "А если нет — просто едем домой."
    show cs_epi_darya soft_smile winter with cs_sprite_change
    cs_da "Звучит как самый здравый план за всю эту неделю."
    cs_narrator "Из-за поворота, мигая поворотником, выехал самый обыкновенный синий московский автобус маршрута № 410."
    $ cs_d7_hide_portraits()
    with dissolve
    $ cs_bus_stock_sound(cs_bus_brake, 0.20)
    cs_narrator "Автобус плавно притормозил у бордюра."
    $ cs_bus_stock_sound(cs_bus_door_open, 0.26)
    cs_narrator "Двери открылись с привычным шипением."
    $ cs_d7_scene("cs_bus_n_stop")
    $ cs_d7_ambience(cs_bus_idle, 0.12)
    scene cs_bus_n_stop with dissolve
    cs_narrator "Внутри было тепло, пахло мокрой шерстью, морозом и вечерним городом."
    cs_narrator "На экране под потолком спокойно сменялись названия остановок и прогноз погоды на завтра, а водитель в обычной тёмной зимней куртке сосредоточенно смотрел на дорогу."
    cs_narrator "Никакой мистики."
    cs_narrator "Никакого подвоха."
    cs_narrator "Просто вечерний городской рейс."
    cs_narrator "Мы приложили транспортные карты к валидатору, прошли в середину салона и сели рядом у окна."
    $ cs_bus_stock_sound(cs_bus_door_close, 0.23)
    $ cs_d7_scene("cs_bus_city")
    $ cs_d7_ambience(cs_bus_moving)
    scene cs_bus_city with dissolve
    cs_narrator "Автобус плавно набрал ход и влился в общий поток фар."
    $ cs_rev_music(cs_music_purrple_moving_landscapes, 0.16, 2.0, loop=False)
    if cs_ep_romance:
        $ cs_d7_hide_portraits()
        show cs_cg_epi_city_bus_romance with dissolve
        cs_narrator "Даша стянула варежку, положила её на колени, нашла мою руку и переплела пальцы."
        cs_narrator "За стеклом поплыли жёлтые пятна витрин, заснеженные скверы и длинные красные полосы габаритных огней, а в тёмном отражении окна рядом со мной сидела она — немного уставшая, живая и совсем спокойная."
        cs_da "Ну что."
        cs_narrator "Негромко спросила она, слегка коснувшись моего плеча."
        cs_da "Ко мне или к тебе?"
        cs_ls "Ко мне."
        cs_narrator "Ответила я сразу."
        cs_ls "Я же ещё в том автобусе обещала заказать самую большую порцию горячей лапши."
        cs_ls "Надо держать слово."
        cs_narrator "Она тихо улыбнулась и сжала мою ладонь чуть крепче."
    else:
        $ cs_d7_hide_portraits()
        show cs_cg_epi_city_bus_friendship with dissolve
        cs_narrator "Даша устроилась поудобнее у окна, легонько коснулась моего плеча и посмотрела на проплывающие мимо вечерние огни."
        cs_da "Слушай, Соколова… а в выходные повторим?"
        cs_da "Только без расследований, без генеральных уборок и без пропавших минут."
        cs_da "Просто нормальный кофе и кино."
        cs_ls "Обязательно."
        cs_narrator "Улыбнулась я."
        cs_ls "И клянусь, не возьму с собой ни одного блокнота."
    cs_narrator "Я смотрела на заснеженный московский проспект."
    cs_narrator "Я так и не узнала, кто оставил пятый прибор на столе, чей это был голос за стеной библиотеки и как вообще сработал тот первый зимний рейс."
    cs_narrator "Раньше эта неизвестность не дала бы мне спать неделями."
    cs_narrator "А сейчас она почти ничего не весила."
    cs_narrator "Рядом сидела Даша, в телефоне были номера друзей, а за окном Москва жила своей обычной жизнью."
    cs_narrator "И на этот раз мне хотелось ехать дальше вместе с ней."
    stop music fadeout 4.0
    stop ambience fadeout 1.5
    window hide dissolve
    $ cs_d7_scene("black")
    scene black with dissolve
    $ cs_ep_record_ending("CS_END_" + cs_ep_guest_mode.upper() + ("_ROMANCE" if cs_ep_romance else "_FRIENDSHIP"))
    jump cs_epilogue_credits
