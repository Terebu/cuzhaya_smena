style cs_final_credit_button:
    padding (14, 8)
    background Solid("#20384d")
    hover_background Solid("#325772")

style cs_final_credit_button_text:
    size 23
    color "#f7e8ce"
    hover_color "#ffffff"

style cs_final_credit_link:
    padding (0, 3)

style cs_final_credit_link_text:
    size 22
    color "#9cd8ff"
    hover_color "#ffffff"

define cs_final_credit_slide_seconds = 5.5

screen cs_epilogue_end_screen():
    modal True
    default cs_credit_index = 0
    default cs_credit_autoplay = True
    default cs_credit_sources_open = False

    $ cs_credit_count = len(cs_final_credit_gallery)
    $ cs_credit_chapter, cs_credit_caption, cs_credit_art = cs_final_credit_gallery[cs_credit_index]
    $ cs_credit_path = cs_path(cs_credit_art)
    $ cs_credit_group = cs_credit_index * (len(cs_final_credit_sources) + 1) // cs_credit_count

    add Solid("#0b141f")
    add cs_credit_path xysize (1920, 1080) fit "cover" align (0.5, 0.5) alpha 0.30
    add cs_credit_path xysize (1920, 1080) fit "contain" align (0.5, 0.5)

    if cs_credit_autoplay and not cs_credit_sources_open and cs_credit_index < cs_credit_count - 1:
        timer cs_final_credit_slide_seconds repeat True action [SetScreenVariable("cs_credit_index", cs_credit_index + 1), With(Dissolve(0.65))]

    if not cs_credit_sources_open:
        frame:
            pos (1230, 54)
            xsize 618
            padding (25, 20)
            background Solid("#0b141fe5")
            vbox:
                spacing 8
                if cs_credit_group == 0:
                    text "Чужая смена" size 58 color "#fff1d4"
                    text "Финальные титры" size 26 color "#b8d6e8"
                else:
                    $ cs_credit_name, cs_credit_description, cs_credit_links = cs_final_credit_sources[cs_credit_group - 1]
                    text cs_credit_name size 30 color "#fff1d4"
                    text cs_credit_description size 22 color "#e3ebf0"
                    for cs_credit_label, cs_credit_url in cs_credit_links:
                        textbutton cs_credit_label style "cs_final_credit_link" action OpenURL(cs_credit_url)

        frame:
            pos (68, 878)
            padding (18, 11)
            background Solid("#0b141fe5")
            vbox:
                spacing 3
                text cs_credit_chapter size 20 color "#b8d6e8"
                text cs_credit_caption size 30 color "#fff1d4"

        frame:
            pos (0, 982)
            xysize (1920, 98)
            background Solid("#0b141ff0")
            hbox:
                pos (62, 23)
                spacing 16
                textbutton "Назад" style "cs_final_credit_button":
                    action [SetScreenVariable("cs_credit_autoplay", False), SetScreenVariable("cs_credit_index", cs_credit_index - 1), With(Dissolve(0.35))]
                    sensitive cs_credit_index > 0
                text ("%d / %d" % (cs_credit_index + 1, cs_credit_count)) size 24 yalign 0.5 color "#d0dce6"
                textbutton "Далее" id "cs_final_credit_next" style "cs_final_credit_button":
                    action [SetScreenVariable("cs_credit_autoplay", False), SetScreenVariable("cs_credit_index", cs_credit_index + 1), With(Dissolve(0.35))]
                    sensitive cs_credit_index < cs_credit_count - 1
                if cs_credit_index < cs_credit_count - 1:
                    textbutton ("Пауза" if cs_credit_autoplay else "Автопоказ") style "cs_final_credit_button" action ToggleScreenVariable("cs_credit_autoplay")

            hbox:
                xpos 1858
                xanchor 1.0
                ypos 23
                spacing 14
                textbutton "Все источники" id "cs_final_credit_open_sources" style "cs_final_credit_button" action SetScreenVariable("cs_credit_sources_open", True)
                textbutton "Сохранить игру" style "cs_final_credit_button" action ShowMenu("save")
                textbutton "Главное меню" id "cs_final_credit_done" style "cs_final_credit_button" action Return()
    else:
        add Solid("#08111cc9")
        frame:
            align (0.5, 0.5)
            xysize (1070, 906)
            padding (36, 27)
            background Solid("#142332")
            vbox:
                spacing 20
                text "Материалы и источники" size 39 color "#fff1d4"
                viewport:
                    id "cs_final_credit_sources_view"
                    xysize (996, 691)
                    mousewheel True
                    draggable True
                    scrollbars "vertical"
                    vbox:
                        xmaximum 923
                        spacing 24
                        for cs_credit_name, cs_credit_description, cs_credit_links in cs_final_credit_sources:
                            vbox:
                                spacing 6
                                text cs_credit_name size 26 color "#fff1d4"
                                text cs_credit_description size 22 color "#e3ebf0"
                                for cs_credit_label, cs_credit_url in cs_credit_links:
                                    textbutton cs_credit_label style "cs_final_credit_link" action OpenURL(cs_credit_url)
                textbutton "К титрам" id "cs_final_credit_close_sources" style "cs_final_credit_button" action SetScreenVariable("cs_credit_sources_open", False)
