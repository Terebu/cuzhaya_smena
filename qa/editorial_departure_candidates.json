  {
    "file": "days/day02/part04/30_scene.rpy",
    "line": 209,
    "speaker": "cs_narrator",
    "text": "Я повернулась к Даше."
  },
  {
    "file": "days/day02/part04/31_a_scene.rpy",
    "line": 77,
    "speaker": "cs_narrator",
    "text": "Я медленно повернулась к ней."
  },
  {
    "file": "days/day02/part04/31_b_scene.rpy",
    "line": 43,
    "speaker": "cs_narrator",
    "text": "Мы направились к выходу."
  },
  {
    "file": "days/day02/part04/31_scene.rpy",
    "line": 29,
    "speaker": "cs_narrator",
    "text": "Виола вернулась к столу."
  },
  {
    "file": "days/day02/part04/31_scene.rpy",
    "line": 34,
    "speaker": "cs_narrator",
    "text": "Я уже направилась к двери."
  },
  {
    "file": "days/day02/part04/33_scene.rpy",
    "line": 57,
    "speaker": "cs_narrator",
    "text": "Когда мы вернулись к клубам, Семён уже ждал возле рабочего стола."
  },
  {
    "file": "days/day02/part05/34_scene.rpy",
    "line": 90,
    "speaker": "cs_narrator",
    "text": "И вернулась к рисунку."
  },
  {
    "file": "days/day02/part05/35_a_scene.rpy",
    "line": 34,
    "speaker": "cs_narrator",
    "text": "Повернулась к Семёну."
  },
  {
    "file": "days/day02/part05/35_b_scene.rpy",
    "line": 42,
    "speaker": "cs_narrator",
    "text": "А я вернулась к рисунку гитары."
  },
  {
    "file": "days/day02/part05/36_scene.rpy",
    "line": 130,
    "speaker": "cs_narrator",
    "text": "Я повернулась к ней."
  },
  {
    "file": "days/day02/part05/36_scene.rpy",
    "line": 176,
    "speaker": "cs_narrator",
    "text": "Я повернулась к нему."
  },
  {
    "file": "days/day02/part05/36_scene.rpy",
    "line": 190,
    "speaker": "cs_narrator",
    "text": "Мы направились к площади."
  },
  {
    "file": "days/day02/part05/37_scene.rpy",
    "line": 49,
    "speaker": "cs_narrator",
    "text": "Он повернулся ко мне."
  },
  {
    "file": "days/day02/part05/38_scene.rpy",
    "line": 72,
    "speaker": "cs_narrator",
    "text": "Я медленно повернулась к ней."
  },
  {
    "file": "days/day02/part05/39_scene.rpy",
    "line": 182,
    "speaker": "cs_narrator",
    "text": "Семён со Славей уже ушли по своим делам."
  },
  {
    "file": "days/day02/part06/41_b_scene.rpy",
    "line": 53,
    "speaker": "cs_sy",
    "text": "Ладно. Главное, чтобы не получилось так, что мы ушли искать выход, а потом сами потерялись."
  },
  {
    "file": "days/day02/part06/44_scene.rpy",
    "line": 256,
    "speaker": "cs_narrator",
    "text": "Мы направились к воротам."
  },
  {
    "file": "days/day02/part06/45_scene.rpy",
    "line": 106,
    "speaker": "cs_ls",
    "text": "Мы шли по ней достаточно долго. И дважды вернулись к одной и той же отметке, хотя ни разу не разворачивались."
  },
  {
    "file": "days/day02/part06/46_scene.rpy",
    "line": 66,
    "speaker": "cs_da",
    "text": "Лучше написать, что мы дважды вернулись к одной точке, двигаясь вперёд. Это мы действительно наблюдали."
  },
  {
    "file": "days/day02/part06/46_scene.rpy",
    "line": 155,
    "speaker": "cs_narrator",
    "text": "Он попрощался и пошёл своей дорогой."
  },
  {
    "file": "days/day02/part06/46_scene.rpy",
    "line": 251,
    "speaker": "cs_narrator",
    "text": "Просто пошла рядом."
  },
  {
    "file": "days/day02/part07/47_scene.rpy",
    "line": 60,
    "speaker": "cs_narrator",
    "text": "Она медленно повернулась ко мне."
  },
  {
    "file": "days/day02/part07/47_scene.rpy",
    "line": 107,
    "speaker": "cs_narrator",
    "text": "И пошла чуть впереди, обходя выступавший из травы камень."
  },
  {
    "file": "days/day02/part07/48_scene.rpy",
    "line": 196,
    "speaker": "cs_narrator",
    "text": "Мы медленно направились к медпункту."
  },
  {
    "file": "days/day02/part07/50_scene.rpy",
    "line": 110,
    "speaker": "cs_narrator",
    "text": "Я повернулась к Даше."
  },
  {
    "file": "days/day02/part07/52_scene.rpy",
    "line": 109,
    "speaker": "cs_narrator",
    "text": "Дарья сделала ещё шаг и повернулась ко мне."
  },
  {
    "file": "days/day02/part07/53_scene.rpy",
    "line": 60,
    "speaker": "cs_narrator",
    "text": "Медленно повернула ко мне голову."
  },
  {
    "file": "days/day02/part07/53_scene.rpy",
    "line": 90,
    "speaker": "cs_narrator",
    "text": "Мы направились к ней."
  },
  {
    "file": "days/day02/part08/54_scene.rpy",
    "line": 158,
    "speaker": "cs_narrator",
    "text": "И направилась к лавочке."
  },
  {
    "file": "days/day02/part08/55_scene.rpy",
    "line": 231,
    "speaker": "cs_narrator",
    "text": "Я повернулась к ней."
  },
  {
    "file": "days/day02/part08/56_scene.rpy",
    "line": 53,
    "speaker": "cs_sy",
    "text": "Особенно о том, как мы второй раз вернулись к кусту."
  },
  {
    "file": "days/day02/part08/56_scene.rpy",
    "line": 59,
    "speaker": "cs_narrator",
    "text": "Он повернулся ко мне."
  },
  {
    "file": "days/day02/part08/57_scene.rpy",
    "line": 26,
    "speaker": "cs_narrator",
    "text": "Разговор постепенно вернулся к обычным лагерным делам."
  },
  {
    "file": "days/day02/part08/57_scene.rpy",
    "line": 124,
    "speaker": "cs_ls",
    "text": "За то, что сегодня пошёл с нами к воротам. И не стал отмахиваться от наших предположений."
  },
  {
    "file": "days/day02/part08/58_a_scene.rpy",
    "line": 57,
    "speaker": "cs_narrator",
    "text": "И направилась к Жене."
  },
  {
    "file": "days/day02/part08/58_a_scene.rpy",
    "line": 200,
    "speaker": "cs_narrator",
    "text": "Женя пошла дальше."
  },
  {
    "file": "days/day02/part08/58_a_scene.rpy",
    "line": 227,
    "speaker": "cs_narrator",
    "text": "Я вернулась к лавочке."
  },
  {
    "file": "days/day02/part08/58_b_scene.rpy",
    "line": 35,
    "speaker": "cs_narrator",
    "text": "Я повернулась к Дарье."
  },
  {
    "file": "days/day02/part08/59_scene.rpy",
    "line": 101,
    "speaker": "cs_narrator",
    "text": "Он махнул рукой и направился к клубам."
  },
  {
    "file": "days/day02/part08/59_scene.rpy",
    "line": 163,
    "speaker": "cs_narrator",
    "text": "Я повернулась к ней."
  },
  {
    "file": "days/day02/part09/60_scene.rpy",
    "line": 363,
    "speaker": "cs_narrator",
    "text": "Мы направились к зданию."
  },
  {
    "file": "days/day02/part09/61_scene.rpy",
    "line": 368,
    "speaker": "cs_narrator",
    "text": "Я медленно повернулась к ней."
  },
  {
    "file": "days/day02/part09/63_scene.rpy",
    "line": 41,
    "speaker": "cs_narrator",
    "text": "Я медленно повернулась к Дарье."
  },
  {
    "file": "days/day02/part09/63_scene.rpy",
    "line": 292,
    "speaker": "cs_th",
    "text": "Сфотографировала бы какую-нибудь ерунду, отправила знакомым и пошла дальше."
  },
  {
    "file": "days/day02/part09/63_scene.rpy",
    "line": 297,
    "speaker": "cs_narrator",
    "text": "Женя уже направилась к столам."
  },
  {
    "file": "days/day02/part09/64_a_scene.rpy",
    "line": 34,
    "speaker": "cs_mz",
    "text": "Нет, приказ немедленно покинуть столовую."
  },
  {
    "file": "days/day02/part09/64_b_scene.rpy",
    "line": 88,
    "speaker": "cs_narrator",
    "text": "Женя вернулась к ужину."
  },
  {
    "file": "days/day02/part09/64_d2_scene.rpy",
    "line": 102,
    "speaker": "cs_narrator",
    "text": "Она вернулась к ужину."
  },
  {
    "file": "days/day02/part09/64_d_scene.rpy",
    "line": 113,
    "speaker": "cs_narrator",
    "text": "Затем всё-таки повернула книгу так, чтобы я могла прочитать название."
  },
  {
    "file": "days/day02/part09/64_e_scene.rpy",
    "line": 594,
    "speaker": "cs_narrator",
    "text": "Семён попрощался и отправился к выходу."
  },
  {
    "file": "days/day02/part09/64_e_scene.rpy",
    "line": 640,
    "speaker": "cs_narrator",
    "text": "Женя направилась к выходу."
  },
  {
    "file": "days/day02/part09/64_e_scene.rpy",
    "line": 656,
    "speaker": "cs_narrator",
    "text": "И направились к выходу."
  },
  {
    "file": "days/day02/part09/64_scene.rpy",
    "line": 236,
    "speaker": "cs_narrator",
    "text": "Я повернулась к ней."
  },
  {
    "file": "days/day02/part09/65_scene.rpy",
    "line": 534,
    "speaker": "cs_narrator",
    "text": "Она улыбнулась и вернулась к подготовке."
  },
  {
    "file": "days/day02/part10/00_flow.rpy",
    "line": 26,
    "speaker": "cs_narrator",
    "text": "Мы с Дарьей направились к площади: музыкальный вечер вот-вот должен был начаться."
  },
  {
    "file": "days/day02/part10/66_scene.rpy",
    "line": 29,
    "speaker": "cs_narrator",
    "text": "Она повернулась ко мне."
  },
  {
    "file": "days/day02/part10/66_scene.rpy",
    "line": 52,
    "speaker": "cs_narrator",
    "text": "Мы направились к домику."
  },
  {
    "file": "days/day02/part10/69_concert.rpy",
    "line": 12,
    "speaker": "cs_narrator",
    "text": "Мы вернулись к местам у края первого ряда. Отсюда сцену было видно целиком."
  },
  {
    "file": "days/day02/part10/69_scene.rpy",
    "line": 80,
    "speaker": "cs_th",
    "text": "Сегодня просто вернула книгу."
  },
  {
    "file": "days/day02/part10/69_scene.rpy",
    "line": 91,
    "speaker": "cs_narrator",
    "text": "Мы направились к площади."
  },
  {
    "file": "days/day02/part10/70_scene.rpy",
    "line": 98,
    "speaker": "cs_narrator",
    "text": "Она направилась к нашему домику."
  },
  {
    "file": "days/day02/part10/71_scene.rpy",
    "line": 107,
    "speaker": "cs_th",
    "text": "Кажется, отдых действительно пошёл мне на пользу."
  },
  {
    "file": "days/day02/part10/72_scene.rpy",
    "line": 101,
    "speaker": "cs_narrator",
    "text": "Повернулась к Даше."
  },
  {
    "file": "days/day02/part10/73_scene.rpy",
    "line": 13,
    "speaker": "cs_narrator",
    "text": "Повернулась к Дарье."
  },
  {
    "file": "days/day02/part10/74_scene.rpy",
    "line": 137,
    "speaker": "cs_narrator",
    "text": "Дарья повернулась ко мне."
  },
  {
    "file": "days/day02/reading_interlude/59_01_scene.rpy",
    "line": 177,
    "speaker": "cs_narrator",
    "text": "Дарья направилась к домикам."
  },
  {
    "file": "days/day02/reading_interlude/59_01_scene.rpy",
    "line": 185,
    "speaker": "cs_narrator",
    "text": "И направилась к двери."
  },
  {
    "file": "days/day02/reading_interlude/59_03_scene.rpy",
    "line": 128,
    "speaker": "cs_narrator",
    "text": "И вернулась к странице."
  },
  {
    "file": "days/day02/reading_interlude/59_04a_scene.rpy",
    "line": 94,
    "speaker": "cs_narrator",
    "text": "Она направилась к своему столу."
  },
  {
    "file": "days/day02/reading_interlude/59_04a_scene.rpy",
    "line": 101,
    "speaker": "cs_narrator",
    "text": "Я вернулась к книге."
  },
  {
    "file": "days/day02/reading_interlude/59_04b_scene.rpy",
    "line": 101,
    "speaker": "cs_narrator",
    "text": "И вернулась за стол."
  },
  {
    "file": "days/day02/reading_interlude/59_04c_scene.rpy",
    "line": 152,
    "speaker": "cs_narrator",
    "text": "Она направилась к своему столу."
  },
  {
    "file": "days/day02/reading_interlude/59_04c_scene.rpy",
    "line": 202,
    "speaker": "cs_narrator",
    "text": "И вернулась к работе."
  },
  {
    "file": "days/day02/reading_interlude/59_04c_scene.rpy",
    "line": 207,
    "speaker": "cs_narrator",
    "text": "И снова принялась читать."
  },
  {
    "file": "days/day02/reading_interlude/59_05_scene.rpy",
    "line": 213,
    "speaker": "cs_narrator",
    "text": "Вернулась ко мне."
  },
  {
    "file": "days/day02/reading_interlude/59_05_scene.rpy",
    "line": 244,
    "speaker": "cs_narrator",
    "text": "И вернулась к чтению."
  },
  {
    "file": "days/day02/reading_interlude/59_06_scene.rpy",
    "line": 170,
    "speaker": "cs_narrator",
    "text": "Дарья повернулась ко мне."
  },
  {
    "file": "days/day02/reading_interlude/59_07a_scene.rpy",
    "line": 56,
    "speaker": "cs_narrator",
    "text": "И вернулась к своему столу."
  },
  {
    "file": "days/day02/reading_interlude/59_07b_scene.rpy",
    "line": 135,
    "speaker": "cs_narrator",
    "text": "Она вернулась к работе."
  },
  {
    "file": "days/day02/reading_interlude/59_07c_scene.rpy",
    "line": 282,
    "speaker": "cs_narrator",
    "text": "Женя вернулась за свой стол."
  },
  {
    "file": "days/day02/reading_interlude/59_08_scene.rpy",
    "line": 230,
    "speaker": "cs_narrator",
    "text": "Она вернулась к бумагам."
  },
  {
    "file": "days/day02/reading_interlude/59_08_scene.rpy",
    "line": 362,
    "speaker": "cs_narrator",
    "text": "Повернулась к Жене."
  },
  {
    "file": "days/day02/reading_interlude/59_08_scene.rpy",
    "line": 368,
    "speaker": "cs_narrator",
    "text": "Мы направились к выходу."
  },
  {
    "file": "days/day02/reading_interlude/59_10_scene.rpy",
    "line": 11,
    "speaker": "cs_narrator",
    "text": "По дороге мы ненадолго свернули к нашему домику."
  },
  {
    "file": "days/prologue/02_seven_percent.rpy",
    "line": 17,
    "speaker": "cs_narrator",
    "text": "Именно поэтому в то утро я вышла из дома совершенно без какого-либо плана."
  },
  {
    "file": "days/prologue/03_stranger.rpy",
    "line": 56,
    "speaker": "cs_narrator",
    "text": "Я отвернулась к окну."
  },
  {
    "file": "days/prologue/05_wrong_way.rpy",
    "line": 27,
    "speaker": "cs_narrator",
    "text": "Девушка рядом повернулась к окну."
  },
  {
    "file": "days/prologue/05_wrong_way.rpy",
    "line": 63,
    "speaker": "cs_narrator",
    "text": "Я снова отвернулась к окну."
  }
]