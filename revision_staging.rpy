    def cs_rev_d4_arrival_repair():
        if not cs_active or not cs_rev_active or cs_rev_day!=4 or cs_rev_scene!=4:return
        node=renpy.game.script.lookup(renpy.game.context().current)
        if type(node).__name__!='Say':return
        start=renpy.game.script.lookup('cs_rev_d4_04')
        cursor=start.next
        while cursor is not None:
            if type(cursor).__name__=='Say' and getattr(cursor,'what','')==u'Семён поднял голову.':
                if node.filename==cursor.filename and start.linenumber<node.linenumber<cursor.linenumber:
                    cs_rev_exit(['cs_semen'])
                return
            if type(cursor).__name__=='Return':return
            cursor=getattr(cursor,'next',None)
    def cs_rev_d4_arrival_at_line(event,**kwargs):
        if event=='begin':cs_rev_d4_arrival_repair()
    config.after_load_callbacks.append(cs_rev_d4_arrival_repair)
    config.all_character_callbacks.append(cs_rev_d4_arrival_at_line)
