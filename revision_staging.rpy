    def cs_rev_early_ambience_sync():
        if not cs_active or not cs_rev_active or cs_day03_started or cs_rev_day not in (1,2):return
        location=None
        target=False
        for tag in renpy.get_showing_tags():
            name=' '.join((tag,)+tuple(renpy.get_attributes(tag) or ()))
            value=cs_forest if name=='bg int_bus' else cs_day03_audio_target(name)
            if value is not False:
                location,target=name,value
                break
        if location is None and cs_day03_audio_location:
            location=cs_day03_audio_location
            target=cs_forest if location=='bg int_bus' else cs_day03_audio_target(location)
        if target is False:return
        current=renpy.music.get_playing(channel='ambience')
        if target is None:
            if current:renpy.music.stop(channel='ambience')
        elif current!=target:
            renpy.music.play(target,channel='ambience',loop=True,fadeout=0.0,fadein=0.8)
            renpy.music.set_volume(0.16,channel='ambience')
        if location:store.cs_day03_audio_location=location
    def cs_rev_early_ambience_at_line(event,**kwargs):
        if event=='begin':cs_rev_early_ambience_sync()
    config.after_load_callbacks.append(cs_rev_early_ambience_sync)
    config.interact_callbacks.append(cs_rev_early_ambience_sync)
    config.all_character_callbacks.append(cs_rev_early_ambience_at_line)

