    cs_rev_base_audio_target=cs_day03_audio_target
    def cs_day03_audio_target(image):
        base=cs_rev_base_audio_target(image)
        if image.startswith(("bg int_library","cs_library_interior")):target="sound/ambiences/library_day.ogg"
        elif image.startswith("bg int_musclub"):target="sound/ambiences/music_club_day.ogg"
        elif image.startswith("bg int_clubs"):target="sound/ambiences/clubs_inside_day.ogg"
        elif image.startswith(("cs_int_administration","cs_storage_int")):target="sound/ambiences/int_cabin_day.ogg"
        elif image=="bg ext_camp_entrance_day":target="sound/ambiences/camp_entrance_day.ogg"
        elif image.startswith("cs_road_"):target="sound/ambiences/forest_day.ogg"
        elif image.startswith("cs_storage_ext_"):target="sound/ambiences/camp_center_day.ogg"
        else:return base
        # Apply story modes after recognising custom locations, including
        # roads which the original base map does not know about.
        if cs_active and getattr(store,"cs_d5_started",False):
            mode=getattr(store,"cs_bus_audio_mode","natural")
            if cs_d5_quiet or mode in ("hushed","silence"):return None
            if mode=="ominous":return cs_bus_drone
        return target if renpy.loadable(target) else base


