[
  {
    "number": "46",
    "title": "Неожиданное сходство",
    "blocks": [
      {
        "stage": "BG: `ext_path_sunset` — продолжение восьмой части."
      },
      {
        "stage": "MUSIC: `a_promise_from_distant_days` — продолжить из предыдущей части, затем плавно затихнуть."
      },
      {
        "stage": "AMBIENCE: `ambience_camp_center_evening`."
      },
      {
        "stage": "SPRITE: Дарья — пионерская форма, normal scale, справа."
      },
      {
        "who": "cs_narrator",
        "text": "Мы с Дарьей продолжали идти по дорожке."
      },
      {
        "who": "cs_narrator",
        "text": "После разговора на площади между нами установилось какое-то новое, непривычное спокойствие."
      },
      {
        "who": "cs_narrator",
        "text": "Я больше не пыталась придумать удачную шутку."
      },
      {
        "who": "cs_narrator",
        "text": "Она не требовала объяснений."
      },
      {
        "who": "cs_narrator",
        "text": "Мы просто шли рядом."
      },
      {
        "who": "cs_narrator",
        "text": "И, пожалуй, впервые за весь день мне этого вполне хватало."
      },
      {
        "who": "cs_narrator",
        "text": "Я взглянула на Дарью."
      },
      {
        "who": "cs_narrator",
        "text": "Красные волосы."
      },
      {
        "who": "cs_narrator",
        "text": "Белая рубашка."
      },
      {
        "who": "cs_narrator",
        "text": "Красный галстук."
      },
      {
        "who": "cs_narrator",
        "text": "На закатном солнце её волосы казались ещё ярче."
      },
      {
        "who": "cs_th",
        "text": "Всё-таки форма ей идёт."
      },
      {
        "who": "cs_narrator",
        "text": "Я едва заметно улыбнулась."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья сразу заметила."
      },
      {
        "who": "cs_da",
        "text": "Что?"
      },
      {
        "who": "cs_ls",
        "text": "Ничего."
      },
      {
        "who": "cs_da",
        "text": "У тебя опять такое выражение лица."
      },
      {
        "who": "cs_ls",
        "text": "Какое?"
      },
      {
        "who": "cs_da",
        "text": "Довольное."
      },
      {
        "who": "cs_narrator",
        "text": "Я задумалась."
      },
      {
        "who": "cs_ls",
        "text": "Прошу занести в протокол. Подозреваемая впервые за день довольна происходящим."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья рассмеялась."
      },
      {
        "who": "cs_da",
        "text": "Ты когда-нибудь перестанешь разговаривать протоколами?"
      },
      {
        "who": "cs_ls",
        "text": "Не исключено. Но пока экспериментальная программа продолжается."
      },
      {
        "who": "cs_narrator",
        "text": "Мы свернули за один из домиков."
      },
      {
        "who": "cs_narrator",
        "text": "Я на секунду отвлеклась на вывеску впереди и едва не столкнулась с девушкой, выходившей нам навстречу."
      },
      {
        "stage": "SFX: не использовать комический звук столкновения — обе успели остановиться."
      },
      {
        "who": "cs_ls",
        "text": "Ой, извини!"
      },
      {
        "who": "cs_un",
        "text": "Извини…"
      },
      {
        "who": "cs_narrator",
        "text": "Мы произнесли это почти одновременно."
      },
      {
        "who": "cs_narrator",
        "text": "Я подняла глаза."
      },
      {
        "who": "cs_narrator",
        "text": "И замерла."
      },
      {
        "stage": "SPRITE: `un normal pioneer` — слева, dissolve 0.7."
      },
      {
        "who": "cs_narrator",
        "text": "Передо мной стояла девушка с фиолетовыми волосами, собранными в два хвоста."
      },
      {
        "who": "cs_narrator",
        "text": "Зелёные глаза."
      },
      {
        "who": "cs_narrator",
        "text": "Светлая кожа."
      },
      {
        "who": "cs_narrator",
        "text": "Пионерская форма."
      },
      {
        "who": "cs_narrator",
        "text": "И совершенно знакомое лицо."
      },
      {
        "who": "cs_th",
        "text": "Да ладно."
      },
      {
        "who": "cs_narrator",
        "text": "Я несколько секунд молчала."
      },
      {
        "who": "cs_narrator",
        "text": "Она тоже."
      },
      {
        "who": "cs_narrator",
        "text": "Потом девушка слегка опустила взгляд, явно не понимая, почему незнакомка так пристально её рассматривает."
      },
      {
        "who": "cs_narrator",
        "text": "И тут до меня окончательно дошло."
      },
      {
        "who": "cs_th",
        "text": "Лена."
      },
      {
        "who": "cs_th",
        "text": "Та самая."
      },
      {
        "who": "cs_th",
        "text": "Только не Соколова."
      },
      {
        "who": "cs_narrator",
        "text": "Я невольно посмотрела на её волосы."
      },
      {
        "who": "cs_narrator",
        "text": "Затем на собственную фиолетовую прядь."
      },
      {
        "who": "cs_narrator",
        "text": "Похожий оттенок."
      },
      {
        "who": "cs_narrator",
        "text": "Почти одинаковый цвет глаз."
      },
      {
        "who": "cs_narrator",
        "text": "Но совершенно разная манера держаться."
      },
      {
        "who": "cs_narrator",
        "text": "Она выглядела тихой и немного настороженной."
      },
      {
        "who": "cs_narrator",
        "text": "А я, судя по её выражению лица, уже успела поставить человека в неловкое положение."
      },
      {
        "who": "cs_th",
        "text": "Отлично."
      },
      {
        "who": "cs_th",
        "text": "Встретила тёзку и немедленно начала вести себя подозрительно."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья остановилась рядом."
      },
      {
        "who": "cs_narrator",
        "text": "Перевела взгляд с девушки на меня."
      },
      {
        "who": "cs_narrator",
        "text": "Потом обратно."
      },
      {
        "who": "cs_da",
        "text": "Лен?"
      },
      {
        "who": "cs_narrator",
        "text": "Я не ответила сразу."
      },
      {
        "who": "cs_narrator",
        "text": "Потому что вспомнила кое-что ещё."
      },
      {
        "who": "cs_narrator",
        "text": "Я знала эту девушку по оригинальной истории."
      },
      {
        "who": "cs_narrator",
        "text": "Её характер."
      },
      {
        "who": "cs_narrator",
        "text": "Некоторые события, связанные с ней."
      },
      {
        "who": "cs_narrator",
        "text": "И несколько вариантов будущего, о которых сейчас совершенно не хотелось думать."
      },
      {
        "who": "cs_narrator",
        "text": "На экране компьютера всё воспринималось иначе."
      },
      {
        "who": "cs_narrator",
        "text": "Там можно было вернуться к сохранению."
      },
      {
        "who": "cs_narrator",
        "text": "Попробовать другой выбор."
      },
      {
        "who": "cs_narrator",
        "text": "Посмотреть, как изменится история."
      },
      {
        "who": "cs_narrator",
        "text": "А здесь передо мной стоял человек."
      },
      {
        "who": "cs_narrator",
        "text": "Живой."
      },
      {
        "who": "cs_narrator",
        "text": "Настоящий."
      },
      {
        "who": "cs_narrator",
        "text": "И явно не обязанный соответствовать тому, что я помнила."
      },
      {
        "who": "cs_th",
        "text": "Я сама говорила Семёну не относиться к ним как к персонажам."
      },
      {
        "who": "cs_th",
        "text": "Пора выполнять собственные рекомендации."
      },
      {
        "who": "cs_narrator",
        "text": "Девушка осторожно произнесла:"
      },
      {
        "who": "cs_un",
        "text": "Всё нормально?"
      },
      {
        "who": "cs_narrator",
        "text": "Я кивнула."
      },
      {
        "who": "cs_ls",
        "text": "Да. Просто задумалась."
      },
      {
        "stage": "MUSIC: fadeout 2.0."
      },
      {
        "stage": "PAUSE: 0.7"
      },
      {
        "who": "cs_narrator",
        "text": "И тут я поняла, что могу сделать."
      },
      {
        "who": "cs_narrator",
        "text": "Остановиться."
      },
      {
        "who": "cs_narrator",
        "text": "Попробовать познакомиться."
      },
      {
        "who": "cs_narrator",
        "text": "Или просто извиниться и пойти дальше."
      },
      {
        "who": "cs_narrator",
        "text": "В конце концов, никто не обязан дружить со мной только потому, что я знаю его историю."
      }
    ]
  },
  {
    "number": "47",
    "title": "Первая развилка",
    "blocks": [
      {
        "stage": "BG: `ext_path_sunset` — сохранить."
      },
      {
        "stage": "SPRITE: Лена Тихонова — `un normal pioneer`, слева. Дарья — pioneer neutral, справа."
      },
      {
        "stage": "ВНУТРЕННИЙ МОНОЛОГ ЛЕНЫ СОКОЛОВОЙ:"
      },
      {
        "who": "cs_th",
        "text": "Может, стоит познакомиться?"
      },
      {
        "who": "cs_th",
        "text": "Хотя, с другой стороны, девушка явно никуда не спешит знакомиться с человеком, который только что едва её не сбил."
      },
      {
        "stage": "MENU — первый выбор игрока."
      },
      {
