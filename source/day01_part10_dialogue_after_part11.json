[
  {
    "number": "52",
    "title": "После ужина",
    "blocks": [
      {
        "who": "cs_narrator",
        "text": "Ужин закончился без происшествий."
      },
      {
        "who": "cs_narrator",
        "text": "Что, учитывая события последних нескольких часов, уже можно было считать достижением."
      },
      {
        "who": "cs_narrator",
        "text": "Я отодвинула пустую тарелку и допила компот."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья сидела напротив, наблюдая за тем, как пионеры постепенно расходятся по своим делам."
      },
      {
        "who": "cs_narrator",
        "text": "За соседним столом кто-то спорил о предстоящих соревнованиях. У выхода смеялись девочки. Где-то звякнула посуда."
      },
      {
        "who": "cs_narrator",
        "text": "Всё было совершенно обыкновенным."
      },
      {
        "who": "cs_th",
        "text": "Никаких путешествий во времени."
      },
      {
        "who": "cs_th",
        "text": "Никаких загадочных автобусов."
      },
      {
        "who": "cs_th",
        "text": "Просто ужин в пионерском лагере."
      },
      {
        "who": "cs_th",
        "text": "По крайней мере, для всех остальных."
      },
      {
        "who": "cs_da",
        "text": "Ну что, теперь в домик?"
      },
      {
        "who": "cs_narrator",
        "text": "Я задумалась."
      },
      {
        "who": "cs_ls",
        "text": "Вообще-то у меня появилась ещё одна идея."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья медленно положила ложку."
      },
      {
        "who": "cs_da",
        "text": "Лен."
      },
      {
        "who": "cs_ls",
        "text": "Что?"
      },
      {
        "who": "cs_da",
        "text": "Мы сегодня уже ходили к двум инженерам и пытались объяснить им устройство смартфона."
      },
      {
        "who": "cs_ls",
        "text": "Вполне плодотворный визит."
      },
      {
        "who": "cs_da",
        "text": "А потом ты полчаса рассказывала, как работают компьютерные сети."
      },
      {
        "who": "cs_ls",
        "text": "Просветительская деятельность."
      },
      {
        "who": "cs_narrator",
        "text": "Она посмотрела на меня."
      },
      {
        "who": "cs_narrator",
        "text": "Я улыбнулась."
      },
      {
        "who": "cs_ls",
        "text": "Хорошо. В этот раз никаких лекций."
      },
      {
        "who": "cs_da",
        "text": "И куда ты собралась?"
      },
      {
        "who": "cs_ls",
        "text": "В библиотеку."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья удивлённо моргнула."
      },
      {
        "who": "cs_da",
        "text": "Зачем?"
      },
      {
        "who": "cs_narrator",
        "text": "Я поставила стакан на стол."
      },
      {
        "who": "cs_ls",
        "text": "Хочу посмотреть местные газеты, журналы. Может, найти календарь."
      },
      {
        "who": "cs_da",
        "text": "Мы ведь уже узнали год."
      },
      {
        "who": "cs_ls",
        "text": "Узнали, какой год называют местные жители. Это немного другое."
      },
      {
        "who": "cs_narrator",
        "text": "Она задумалась."
      },
      {
        "who": "cs_ls",
        "text": "Шурик и Электроник сказали, что сейчас тысяча девятьсот восьмидесятый. Но я бы хотела проверить ещё несколько независимых источников."
      },
      {
        "who": "cs_da",
        "text": "Думаешь, они могли ошибиться?"
      },
      {
        "who": "cs_ls",
        "text": "Скорее думаю, что нам стоит перестать воспринимать любое совпадение с игрой как окончательное доказательство."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья кивнула."
      },
      {
        "who": "cs_da",
        "text": "Разумно."
      },
      {
        "who": "cs_narrator",
        "text": "Я поднялась."
      },
      {
        "who": "cs_ls",
        "text": "Вот. Иногда мои идеи бывают полезными."
      },
      {
        "who": "cs_da",
        "text": "Иногда."
      },
      {
        "who": "cs_ls",
        "text": "Прошу зафиксировать положительную оценку."
      },
      {
        "who": "cs_narrator",
        "text": "Она рассмеялась."
      },
      {
        "who": "cs_narrator",
        "text": "Мы направились к выходу."
      }
    ]
  },
  {
    "number": "53",
    "title": "Последний посетитель",
    "blocks": [
      {
        "who": "cs_narrator",
        "text": "После ужина на улице стало немного прохладнее."
      },
      {
        "who": "cs_narrator",
        "text": "Солнце медленно опускалось за деревья, окрашивая дорожки мягким оранжевым светом."
      },
      {
        "who": "cs_narrator",
        "text": "Я шла рядом с Дарьей, поглядывая по сторонам."
      },
      {
        "who": "cs_narrator",
        "text": "Дорогу до библиотеки я помнила."
      },
      {
        "who": "cs_narrator",
        "text": "По крайней мере, примерно."
      },
      {
        "who": "cs_narrator",
        "text": "А после дневных прогулок начинала ориентироваться уже не только по игровым фонам."
      },
      {
        "who": "cs_da",
        "text": "Ты знаешь, какая здесь библиотека?"
      },
      {
        "who": "cs_ls",
        "text": "Была одна в оригинальной истории."
      },
      {
        "who": "cs_da",
        "text": "Значит, опять проверяем совпадения?"
      },
      {
        "who": "cs_ls",
        "text": "На этот раз с пользой для образования."
      },
      {
        "who": "cs_narrator",
        "text": "Я ненадолго замолчала."
      },
      {
        "who": "cs_narrator",
        "text": "Затем добавила:"
      },
      {
        "who": "cs_ls",
        "text": "И ещё мне любопытно познакомиться с местной библиотекаршей."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья бросила на меня подозрительный взгляд."
      },
      {
        "who": "cs_da",
        "text": "Почему?"
      },
      {
        "who": "cs_ls",
        "text": "Женя."
      },
      {
        "who": "cs_da",
        "text": "Это имя?"
      },
      {
        "who": "cs_ls",
        "text": "Да. Она довольно строгая."
      },
      {
        "who": "cs_da",
        "text": "И?"
      },
      {
        "who": "cs_ls",
        "text": "Не особенно любит шум, беспорядок и людей, которые отвлекают её от работы."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья посмотрела на меня."
      },
      {
        "who": "cs_narrator",
        "text": "Потом медленно улыбнулась."
      },
      {
        "who": "cs_da",
        "text": "То есть ты решила пойти именно туда?"
      },
      {
        "who": "cs_ls",
        "text": "Почему бы и нет?"
      },
      {
        "who": "cs_da",
        "text": "Лен, пожалуйста, не пытайся специально её раздражать."
      },
      {
        "who": "cs_narrator",
        "text": "Я пожала плечами."
      },
      {
        "who": "cs_ls",
        "text": "Постараюсь."
      },
      {
        "who": "cs_da",
        "text": "Это не очень убедительный ответ."
      },
      {
        "who": "cs_ls",
        "text": "Другого пока не подготовила."
      },
      {
        "who": "cs_narrator",
        "text": "Мы свернули к библиотеке."
      },
      {
        "who": "cs_narrator",
        "text": "Перед нами стояла библиотека."
      },
      {
        "who": "cs_narrator",
        "text": "Знакомое здание."
      },
      {
        "who": "cs_narrator",
        "text": "Знакомые окна."
      },
      {
        "who": "cs_narrator",
        "text": "Знакомая дверь."
      },
      {
        "who": "cs_narrator",
        "text": "И совершенно незнакомая перспектива разговора с человеком, который мог оказаться не таким, каким я привыкла видеть его на экране."
      },
      {
        "who": "cs_narrator",
        "text": "Я остановилась у входа."
      },
      {
        "who": "cs_da",
        "text": "Ты чего?"
      },
      {
        "who": "cs_ls",
        "text": "Думаю."
      },
      {
        "who": "cs_da",
        "text": "О чём?"
      },
      {
        "who": "cs_ls",
        "text": "О том, как не испортить первое впечатление."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья посмотрела на меня."
      },
      {
        "who": "cs_narrator",
        "text": "Пауза."
      },
      {
        "who": "cs_da",
        "text": "Начни с обычного «здравствуйте»."
      },
      {
        "who": "cs_narrator",
        "text": "Я задумчиво кивнула."
      },
      {
        "who": "cs_ls",
        "text": "Радикальное предложение."
      },
      {
        "who": "cs_narrator",
        "text": "Она рассмеялась."
      },
      {
        "who": "cs_narrator",
        "text": "Я открыла дверь."
      }
    ]
  },
  {
    "number": "54",
    "title": "Хранительница книжного фонда",
    "blocks": [
      {
        "who": "cs_narrator",
        "text": "Внутри пахло бумагой."
      },
      {
        "who": "cs_narrator",
        "text": "Деревом."
      },
      {
        "who": "cs_narrator",
        "text": "Старой краской."
      },
      {
        "who": "cs_narrator",
        "text": "И чем-то ещё, что бывает только в библиотеках с длинными рядами книжных полок."
      },
      {
        "who": "cs_narrator",
        "text": "Я огляделась."
      },
      {
        "who": "cs_narrator",
        "text": "Несколько стеллажей."
      },
      {
        "who": "cs_narrator",
        "text": "Читательские столы."
      },
      {
        "who": "cs_narrator",
        "text": "Каталожные ящики."
      },
      {
        "who": "cs_narrator",
        "text": "Стопки книг."
      },
      {
        "who": "cs_narrator",
        "text": "Никаких компьютеров."
      },
      {
        "who": "cs_narrator",
        "text": "Никаких электронных систем поиска."
      },
      {
        "who": "cs_narrator",
        "text": "Только бумага."
      },
      {
        "who": "cs_narrator",
        "text": "Очень много бумаги."
      },
      {
        "who": "cs_th",
        "text": "Поисковая система версии тысяча девятьсот восьмидесятого года."
      },
      {
        "who": "cs_th",
        "text": "Индексация ручная."
      },
      {
        "who": "cs_th",
        "text": "Время ответа — зависит от настроения библиотекаря."
      },
      {
        "who": "cs_narrator",
        "text": "За столом сидела девушка в очках."
      },
      {
        "who": "cs_narrator",
        "text": "Она читала книгу, придерживая страницу пальцем."
      },
      {
        "who": "cs_narrator",
        "text": "Услышав дверь, подняла глаза."
      },
      {
        "who": "cs_th",
        "text": "Женя."
      },
      {
        "who": "cs_narrator",
        "text": "Именно такой я её и помнила."
      },
      {
        "who": "cs_narrator",
        "text": "Только теперь она не была двухмерным изображением."
      },
      {
        "who": "cs_narrator",
        "text": "Она сидела за настоящим столом, листала настоящую книгу и совершенно явно собиралась заниматься своими делами, пока мы не появились."
      },
      {
        "who": "cs_mz",
        "text": "Здравствуйте. Что-то хотели?"
      },
      {
        "who": "cs_narrator",
        "text": "Я шагнула вперёд."
      },
      {
        "who": "cs_ls",
        "text": "Добрый вечер."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья поздоровалась следом."
      },
      {
        "who": "cs_narrator",
        "text": "Женя посмотрела на часы."
      },
      {
        "who": "cs_mz",
        "text": "Если за книгами, то лучше не затягивайте. Скоро буду закрывать."
      },
      {
        "who": "cs_ls",
        "text": "Мы ненадолго."
      },
      {
        "who": "cs_narrator",
        "text": "Она кивнула."
      },
      {
        "who": "cs_mz",
        "text": "Что ищете?"
      },
      {
        "who": "cs_ls",
        "text": "Газеты. Или календарь."
      },
      {
        "who": "cs_narrator",
        "text": "Женя приподняла бровь."
      },
      {
        "who": "cs_mz",
        "text": "Календарь?"
      },
      {
        "who": "cs_ls",
        "text": "Желательно текущего года."
      },
      {
        "who": "cs_narrator",
        "text": "Женя посмотрела на меня внимательнее."
      },
      {
        "who": "cs_mz",
        "text": "А зачем?"
      },
      {
        "who": "cs_narrator",
        "text": "Я задумалась."
      },
      {
        "who": "cs_th",
        "text": "Вот и начались вопросы."
      },
      {
        "who": "cs_ls",
        "text": "Хотим кое-что проверить."
      },
      {
        "who": "cs_mz",
        "text": "Например?"
      },
      {
        "who": "cs_ls",
        "text": "Дату."
      },
      {
        "who": "cs_narrator",
        "text": "Несколько секунд Женя молчала."
      },
      {
        "who": "cs_mz",
        "text": "Ты не знаешь сегодняшнее число?"
      },
      {
        "who": "cs_ls",
        "text": "Пока не совсем уверена."
      },
      {
        "who": "cs_narrator",
        "text": "Она перевела взгляд на Дарью."
      },
      {
        "who": "cs_mz",
        "text": "Вы новенькие?"
      },
      {
        "who": "cs_da",
        "text": "Да, сегодня приехали."
      },
      {
        "who": "cs_narrator",
        "text": "Женя снова посмотрела на меня."
      },
      {
        "who": "cs_mz",
        "text": "Понятно."
      },
      {
        "who": "cs_narrator",
        "text": "Судя по тону, понятно ей было далеко не всё."
      },
      {
        "who": "cs_narrator",
        "text": "Она закрыла книгу."
      },
      {
        "who": "cs_mz",
        "text": "Я Женя. За библиотеку отвечаю. Если хотите что-нибудь взять, сначала запишу вас."
      },
      {
        "who": "cs_narrator",
        "text": "Я чуть заметно кивнула."
      },
      {
        "who": "cs_ls",
        "text": "Лена Соколова. А это Дарья."
      },
      {
        "who": "cs_da",
        "text": "Можно Даша."
      },
      {
        "who": "cs_narrator",
        "text": "Женя взглянула на наши волосы."
      },
      {
        "who": "cs_narrator",
        "text": "Затем на пионерскую форму."
      },
      {
        "who": "cs_mz",
        "text": "Понятно. Про двух новеньких уже говорили."
      },
      {
        "who": "cs_narrator",
        "text": "Я усмехнулась."
      },
      {
        "who": "cs_ls",
        "text": "Надеюсь, исключительно хорошее."
      },
      {
        "who": "cs_mz",
        "text": "Разное."
      },
      {
        "who": "cs_ls",
        "text": "Обнадёживающее начало."
      },
      {
        "who": "cs_narrator",
        "text": "Она не улыбнулась."
      },
      {
        "who": "cs_narrator",
        "text": "Но в её глазах мелькнуло что-то похожее на интерес."
      },
      {
        "who": "cs_mz",
        "text": "Только, пожалуйста, потише. Здесь библиотека."
      },
      {
        "who": "cs_narrator",
        "text": "Я кивнула."
      },
      {
        "who": "cs_ls",
        "text": "Договорились."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья посмотрела на меня."
      },
      {
        "who": "cs_da",
        "text": "Видишь? Нормально получается."
      },
      {
        "who": "cs_ls",
        "text": "Не спугни."
      },
      {
        "who": "cs_narrator",
        "text": "Женя подняла голову."
      },
      {
        "who": "cs_mz",
        "text": "Вы что-то сказали?"
      },
      {
        "who": "cs_ls",
        "text": "Нет. Обсуждаем соблюдение правил."
      },
      {
        "who": "cs_narrator",
        "text": "Женя вздохнула и вернулась к столу."
      },
      {
        "who": "cs_narrator",
        "text": "Я заметила возле неё стопку возвращённых книг."
      },
      {
        "who": "cs_narrator",
        "text": "Некоторые были разложены по размеру."
      },
      {
        "who": "cs_narrator",
        "text": "Другие лежали отдельно."
      },
      {
        "who": "cs_narrator",
        "text": "На корешках виднелись инвентарные номера."
      },
      {
        "who": "cs_th",
        "text": "Интересно."
      },
      {
        "who": "cs_th",
        "text": "Кажется, сейчас можно либо попытаться познакомиться поближе, либо просто заняться собственными поисками."
      }
    ]
  },
  {
    "number": "55",
    "title": "Развилка — знакомство с Женей",
    "blocks": [
      {
        "who": "cs_narrator",
        "text": "Я посмотрела на стопку книг."
      },
      {
        "who": "cs_narrator",
        "text": "Затем на Женю."
      },
      {
        "who": "cs_narrator",
        "text": "Она уже собиралась приступить к сортировке."
      },
      {
        "who": "cs_th",
        "text": "Можно предложить помощь."
      },
      {
        "who": "cs_th",
        "text": "А можно не вмешиваться и просто поискать нужные издания."
      }
    ]
  },
  {
    "number": "55А",
    "title": "Помощь библиотекарю",
    "blocks": [
      {
        "who": "cs_narrator",
        "text": "Я посмотрела на книги возле стола."
      },
      {
        "who": "cs_ls",
        "text": "Слушай, тебе помочь?"
      },
      {
        "who": "cs_narrator",
        "text": "Женя подняла глаза."
      },
      {
        "who": "cs_mz",
        "text": "С чем?"
      },
      {
        "who": "cs_narrator",
        "text": "Я указала на стопку."
      },
      {
        "who": "cs_ls",
        "text": "С книгами. Судя по всему, их нужно разобрать."
      },
      {
        "who": "cs_narrator",
        "text": "Женя немного помолчала."
      },
      {
        "who": "cs_mz",
        "text": "А ты умеешь?"
      },
      {
        "who": "cs_narrator",
        "text": "Я посмотрела на неё."
      },
      {
        "who": "cs_ls",
        "text": "Сортировать книги? Думаю, освою."
      },
      {
        "who": "cs_mz",
        "text": "Здесь не просто по алфавиту всё раскладывается."
      },
      {
        "who": "cs_narrator",
        "text": "Она показала на инвентарные номера."
      },
      {
        "who": "cs_mz",
        "text": "Есть разделы, каталожные карточки, номера хранения."
      },
      {
        "who": "cs_narrator",
        "text": "Я кивнула."
      },
      {
        "who": "cs_ls",
        "text": "Тогда сначала объясни, что куда."
      },
      {
        "who": "cs_narrator",
        "text": "Женя несколько секунд изучала моё лицо."
      },
      {
        "who": "cs_narrator",
        "text": "Кажется, пыталась понять, серьёзно ли я предлагаю помочь."
      },
      {
        "who": "cs_narrator",
        "text": "Затем пододвинула ко мне небольшую стопку."
      },
      {
        "who": "cs_mz",
        "text": "Хорошо. Вот эти пока разложи по авторам. Только ничего на полки самостоятельно не ставь."
      },
      {
        "who": "cs_ls",
        "text": "Принято."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья подошла ближе."
      },
      {
        "who": "cs_da",
        "text": "Можно я тоже помогу?"
      },
      {
        "who": "cs_narrator",
        "text": "Женя посмотрела на неё."
      },
      {
        "who": "cs_mz",
        "text": "Если аккуратно."
      },
      {
        "who": "cs_da",
        "text": "Постараемся."
      },
      {
        "who": "cs_narrator",
        "text": "Мы принялись разбирать книги."
      },
      {
        "who": "cs_narrator",
        "text": "Работа оказалась довольно простой, если не торопиться."
      },
      {
        "who": "cs_narrator",
        "text": "Несколько фамилий."
      },
      {
        "who": "cs_narrator",
        "text": "Названия."
      },
      {
        "who": "cs_narrator",
        "text": "Инвентарные номера."
      },
      {
        "who": "cs_narrator",
        "text": "Никаких сложных технологий."
      },
      {
        "who": "cs_narrator",
        "text": "Обычная аккуратность."
      },
      {
        "who": "cs_narrator",
        "text": "Я взяла очередную книгу и посмотрела на титульный лист."
      },
      {
        "who": "cs_ls",
        "text": "Интересная система."
      },
      {
        "who": "cs_mz",
        "text": "В каком смысле?"
      },
      {
        "who": "cs_ls",
        "text": "Всё можно найти без компьютера. Только нужно правильно организовать."
      },
      {
        "who": "cs_narrator",
        "text": "Женя нахмурилась."
      },
      {
        "who": "cs_mz",
        "text": "А компьютер здесь при чём?"
      },
      {
        "who": "cs_th",
        "text": "А вот это сейчас лучше не развивать."
      },
      {
        "who": "cs_ls",
        "text": "Ни при чём. Просто сравниваю с тем, к чему привыкла."
      },
      {
        "who": "cs_narrator",
        "text": "Она кивнула."
      },
      {
        "who": "cs_mz",
        "text": "Если систему не соблюдать, потом ничего не найдёшь."
      },
      {
        "who": "cs_ls",
        "text": "Вполне понимаю."
      },
      {
        "who": "cs_narrator",
        "text": "Я положила очередную книгу в нужную стопку."
      },
      {
        "who": "cs_ls",
        "text": "Хаос хорош, пока не приходится искать в нём конкретную вещь."
      },
      {
        "who": "cs_narrator",
        "text": "Женя посмотрела на меня."
      },
      {
        "who": "cs_narrator",
        "text": "На этот раз с некоторым одобрением."
      },
      {
        "who": "cs_mz",
        "text": "Вот именно."
      },
      {
        "who": "cs_narrator",
        "text": "Дарья едва заметно улыбнулась."
      },
      {
        "who": "cs_th",
        "text": "Ого."
      },
      {
        "who": "cs_th",
        "text": "Кажется, впервые за день моё чувство порядка кому-то пригодилось."
      },
      {
        "who": "cs_narrator",
        "text": "Мы закончили разбирать небольшую стопку."
      },
      {
        "who": "cs_narrator",
        "text": "Женя проверила результат."
      },
      {
        "who": "cs_narrator",
        "text": "Затем кивнула."
      },
      {
        "who": "cs_mz",
        "text": "Нормально. Спасибо."
      },
      {
        "who": "cs_ls",
        "text": "Всегда пожалуйста."
      },
      {
        "who": "cs_narrator",
        "text": "Она немного помолчала."
      },
      {
        "who": "cs_mz",
        "text": "Обычно новенькие сюда приходят за книгами. А не помогать."
      },
      {
        "who": "cs_narrator",
        "text": "Я пожала плечами."
      },
      {
        "who": "cs_ls",
        "text": "Сегодня у меня вообще не самый обычный день."
      },
      {
        "who": "cs_narrator",
        "text": "Женя чуть заметно улыбнулась."
      },
      {
        "who": "cs_mz",
        "text": "Это я уже поняла."
      },
      {
        "who": "cs_narrator",
        "text": "Я посмотрела на Дарью."
      },
      {
        "who": "cs_narrator",
        "text": "Она тихо произнесла:"
      },
      {
        "who": "cs_da",
        "text": "Видишь? Спокойное знакомство."
      },
      {
        "who": "cs_ls",
        "text": "Запишем в достижения."
      },
      {
        "who": "cs_mz",
        "text": "Только без шума."
      },
      {
        "who": "cs_narrator",
        "text": "Я немедленно понизила голос."
      },
      {
        "who": "cs_ls",
        "text": "Так точно."
      },
      {
        "who": "cs_narrator",
        "text": "Женя покачала головой."
      },
      {
        "who": "cs_narrator",
        "text": "Но на этот раз уже не выглядела раздражённой."
      }
    ]
  },
  {
