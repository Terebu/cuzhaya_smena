  "speaker_changes": [
    {
      "old_index": 172,
      "new_index": 185,
      "old_speaker": "sy",
      "new_speaker": "ls",
      "text": "Лена Соколова: Хоть что-то предсказуемое."
    },
    {
      "old_index": 173,
      "new_index": 186,
      "old_speaker": "ls",
      "new_speaker": "sy",
      "text": "Семён: Не спеши радоваться. Мы ещё кашу не видели."
    },
    {
      "old_index": 341,
      "new_index": 373,
      "old_speaker": "mz",
      "new_speaker": "sy",
      "text": "Семён: Я ещё выбираю формулировку."
    },
    {
      "old_index": 373,
      "new_index": 405,
      "old_speaker": "sy",
      "new_speaker": "ls",
      "text": "Лена Соколова: Один кто?"
    },
    {
      "old_index": 806,
      "new_index": 908,
      "old_speaker": "da",
      "new_speaker": "ls",
      "text": "Лена Соколова: Так мы доказательства потеряем раньше всякой мистики."
    },
    {
      "old_index": 807,
      "new_index": 909,
      "old_speaker": "ls",
      "new_speaker": "mz",
      "text": "Женя: Зато будет понятная причина. Мне уже нравится."
    },
    {
      "old_index": 1007,
      "new_index": 1134,
      "old_speaker": "da",
      "new_speaker": "sy",
      "text": "Семён: Что?"
    },
    {
      "old_index": 1022,
      "new_index": 1151,
      "old_speaker": "mt",
      "new_speaker": "vi",
      "text": "Виола: Те самые?"
    }
  ],
  "editorial_speaker_corrections": [
    {
      "index": 94,
      "speaker": "da",
      "reason": "Dasha slows down and says she prefers walking"
    }
  ],
  "staging": {
    "93": {
      "text": "На втором круге Даша сбавила шаг.",
      "commands": [
        "$ cs_d5_room(\"bg ext_playground_day\")"
      ]
    },
    "117": {
      "text": "Мы пошли к умывальникам.",
      "commands": [
        "$ cs_d5_room(\"bg ext_house_of_mt_day\")"
      ]
    },
    "297": {
      "text": "Это было лучше, чем уверенный ответ наугад.",
      "commands": [
        "$ cs_d5_documents_location = \"lena\""
      ]
    },
    "322": {
      "text": "Оригиналы фотографий и списка остались у Ольги Дмитриевны.",
      "commands": [
        "$ cs_d5_documents_location = \"olga\""
      ]
    },
    "361": {
      "text": "На обратной стороне таблички белело: «НЕ ОГЛЯДЫВАЙСЯ».",
      "commands": [
        "show screen cs_d5_insert(\"НЕ ОГЛЯДЫВАЙСЯ\", \"Обратная сторона таблички\")"
      ]
    },
    "374": {
      "text": "Из-за поворота донёсся двигатель.",
      "commands": [
        "hide screen cs_d5_insert"
      ]
    },
    "375": {
      "text": "Мы отошли к воротам.",
      "commands": [
        "$ cs_d5_room(\"bg ext_bus\")"
      ]
    },
    "386": {
      "text": "Постановка: тот же фон, автобус перед остановкой. Птицы затихают после остановки двигателя на холостом ходу. Несовпадающее отражение показывать только фрагментом стекла; лицо третьей Лены не раскрывать.",
      "commands": [
        "stop music fadeout 1.0"
      ]
    },
    "684": {
      "text": "За столом всё ещё сидел Семён. Живой и усталый.",
      "commands": [
        "$ cs_d5_room(\"bg int_library_day\")"
      ]
    },
    "798": {
      "text": "На выходе нас догнала Алиса.",
      "commands": [
        "$ cs_d5_room(\"bg ext_dining_hall_near_day\")"
      ]
    },
    "897": {
      "text": "На столе уже лежали фотографии.",
      "commands": [
        "$ cs_d5_documents_location = \"library\""
      ]
    },
    "930": {
      "text": "Снаружи постучали.",
      "commands": [
        "play sound cs_d5_seven_knocks"
      ]
    },
    "963": {
      "text": "Женя кивнула и медленно потянула ручку.",
      "commands": [
        "$ cs_d5_room(\"bg ext_library_day\")"
      ]
    },
    "967": {
      "text": "Возле косяка появились отметки мелом: семь коротких линий, последняя перечёркнута.",
      "commands": [
        "show screen cs_d5_insert(\"│ │ │ │ │ │ ╳\", \"Отметки на косяке\")"
      ]
    },
    "971": {
      "text": "Лена Тихонова вышла следом и остановилась на пороге.",
      "commands": [
        "hide screen cs_d5_insert"
      ]
    },
    "1181": {
      "text": "Часы над дверью показывали начало девятого. Стрелка шла, за окном кто-то смеялся.",
      "commands": [
        "$ cs_d5_clock = \"20:05\""
      ]
    },
    "1249": {
      "text": "Семён сидел на крыльце. Я вышла к нему с чашкой.",
      "commands": [
        "$ cs_d5_room(\"bg ext_house_of_mt_night\")"
      ]
    },
    "1279": {
      "text": "Из домика выглянула Даша.",
      "commands": []
    },
    "1290": {
      "text": "Мы вернулись внутрь.",
      "commands": [
        "$ cs_d5_room(\"bg int_house_of_mt_night\")"
      ]
    },
    "1327": {
      "text": "До полуночи оставалось меньше четверти часа.",
      "commands": [
        "$ cs_d5_quiet = True",
        "stop ambience fadeout 0.5",
        "stop music fadeout 1.0",
        "$ cs_d5_clock = \"23:47\"",
        "show screen cs_d5_clock_face"
      ]
    },
    "1359": {
      "text": "Оба циферблата показывали без одной минуты двенадцать. Потом остановился и будильник.",
      "commands": [
        "$ cs_d5_clock = \"23:59\""
      ]
    },
    "1361": {
      "text": "В дверь постучали семь раз.",
      "commands": [
        "play sound cs_d5_seven_knocks"
      ]
    },
    "1362": {
      "text": "На последнем ударе погас свет.",
      "commands": [
        "$ cs_director_scene(\"bg int_house_of_mt_night2\")",
        "show bg int_house_of_mt_night2 zorder -100",
        "with Dissolve(0.6)"
      ]
    },
    "1388": {
      "text": "Ольга Дмитриевна осветила бумагу.",
      "commands": [
        "show screen cs_d5_insert(\"Семёну\", \"Конверт\")"
      ]
    },
    "1406": {
      "text": "«ТЫ УЖЕ ВЫБИРАЛ».",
      "commands": [
        "show screen cs_d5_insert(\"ТЫ УЖЕ ВЫБИРАЛ\", \"Оборот карточки\")"
      ]
    },
    "1407": {
      "text": "Семён провёл большим пальцем по краю стола.",
      "commands": [
        "hide screen cs_d5_insert"
      ]
    },
    "1488": {
      "text": "«ПЕРВЫЙ ИЛИ ВТОРАЯ».",
      "commands": [
        "show screen cs_d5_insert(\"ПЕРВЫЙ ИЛИ ВТОРАЯ\nДО РАССВЕТА\", \"Надпись на внутренней двери\")"
      ]
    },
    "1491": {
      "text": "Я посмотрела на стол.",
      "commands": [
        "hide screen cs_d5_insert"
      ]
    },
    "1353": {
      "text": "Схождение. Каждое отсутствующее действие замещается отдельно: если нет Слави, термос убирает Даша; если нет Алисы, фонарик берёт Ольга; если нет Мику, будильник проверяет Виола.",
      "commands": [
        "if not cs_d5_slavya_present:",
        "    cs_narrator \"Даша убрала термос от края стола.\"",
        "if not cs_d5_alisa_present:",
        "    cs_narrator \"Ольга Дмитриевна взяла фонарик.\"",
        "if not cs_d5_miku_present:",
        "    cs_narrator \"Виола проверила будильник.\""
      ]
    },
    "1219": {
      "text": "day05_slavya_present = false.",
      "commands": [
        "$ cs_actor_exit([\"sl\"])",
        "$ cs_d5_cast = []"
      ]
    },
    "1503": {
      "text": "Даша подняла с пола плед и накрыла наши колени.",
      "commands": [
        "$ cs_pov_begin()",
        "with cs_sprite_leave",
        "show screen cs_d5_notes"
      ]
    },
    "856": {
      "text": "Она сама села за пианино и сыграла короткую фразу. На последней ноте убрала руки.",
      "commands": [
        "play music cs_miku_piano_track fadein 0.5"
      ]
    },
    "857": {
      "text": "Мику: Дальше во сне семь хлопков. Я открываю дверь, а там дорога. Не крыльцо клуба — сразу дорога.",
      "commands": [
        "stop music fadeout 1.0"
      ]
    },
    "476": {
      "text": "Ольгу Дмитриевну мы нашли у административного корпуса.",
      "commands": [
        "$ cs_d5_room(\"cs_ext_administration_day\")"
      ]
    },
    "1242": {
      "text": "Схождение. До начала ночного события Славя при уходе присоединяется к обычному дежурству другого отряда. Мику при уходе остаётся с Ульяной; Алиса, если не участвует, тоже возвращается к Ульяне. Эти перемещения при необходимости показать короткими переходами без дополнительных расследований.",
      "commands": [
        "if not cs_d5_slavya_present:",
        "    cs_narrator \"Славя передала дежурство по нашему отряду вожатой и присоединилась к обычному дежурству другого отряда.\"",
        "if not cs_d5_miku_present or not cs_d5_alisa_present:",
        "    cs_narrator \"Ульяна обещала побыть с теми, кто сегодня не придёт в домик вожатой.\""
      ]
    },
    "81": {
      "text": "Через несколько минут мы обе стояли в пионерской форме.",
      "commands": [
        "$ cs_d5_dressed = True",
        "$ cs_d5_costume(\"sport\")",
        "$ cs_d5_focus(\"da\")",
        "with cs_sprite_enter"
      ]
    },
    "86": {
      "text": "У крыльца мы задержались: я перезавязала шнурок, Даша сделала несколько наклонов.",
      "commands": [
        "$ cs_d5_room(\"cs_house_lena_darya_ext_day\")"
      ]
    },
    "90": {
      "text": "Размявшись, мы побежали через площадь.",
      "commands": [
        "$ cs_d5_room(\"bg ext_square_day\")"
      ]
    },
    "187": {
      "text": "До завтрака мы всё-таки дошли до умывальников.",
      "commands": [
        "$ cs_d5_room(\"bg ext_washstand_day\")"
      ]
    },
    "194": {
      "text": "Лена Соколова: Давайте после завтрака зайдём к Ольге Дмитриевне.",
      "commands": [
        "$ cs_d5_room(\"cs_house_lena_darya_int_day\")",
        "cs_narrator \"Семён подождал у дорожки, пока мы с Дашей ненадолго зашли в домик.\"",
        "cs_narrator \"Даша переоделась в пионерскую форму, а я поправила галстук.\"",
        "$ cs_d5_run_finished = True",
        "$ cs_d5_costume(\"pioneer\")",
        "$ cs_d5_room(\"cs_camp_path_day\")"
      ]
    },
    "258": {
      "text": "Уже на дорожке я поймала себя на желании ещё раз проговорить план.",
      "commands": [
        "$ cs_d5_room(\"cs_camp_path_day\")"
      ]
    },
    "336": {
      "text": "К воротам мы пошли через площадь.",
      "commands": [
        "$ cs_d5_room(\"bg ext_square_day\")"
      ]
    },
    "347": {
      "text": "У ворот всё было как обычно: выцветший щит, пыльная обочина и дорога, которую я теперь терпеть не могла.",
      "commands": [
        "$ cs_d5_room(\"bg ext_no_bus\")"
      ]
    },
    "490": {
      "text": "Я не возражала.",
      "commands": [
        "$ cs_d5_room(\"bg ext_washstand_day\")"
      ]
    },
    "818": {
      "text": "У крыльца мы остановились: Алиса никак не могла распутать провод, который несла из столовой.",
      "commands": [
        "$ cs_d5_room(\"bg ext_musclub_day\")"
      ]
    },
    "821": {
      "text": "Мику встретила нас у пианино с нотной тетрадью.",
      "commands": [
        "$ cs_d5_room(\"bg int_musclub_day\")"
      ]
    },
    "832": {
      "text": "Я села на свободный стул, Семён остался рядом с дверью.",
      "commands": [
        "stop music fadeout 1.0"
      ]
    },
    "1402": {
      "text": "«ОСТАТЬСЯ — ОДИН.",
      "commands": [
        "show screen cs_d5_insert(\"ОСТАТЬСЯ — ОДИН.\nВЕРНУТЬСЯ — ОДИН.\nВЫБИРАЕТ ПЕРВЫЙ\", \"Лицевая сторона карточки\")"
      ]
    },
    "1321": {
      "text": "Разбудила меня тишина. Насекомые за окном замолкли разом.",
      "commands": [
        "$ cs_d5_quiet = True",
        "stop ambience fadeout 1.0"
      ]
    },
    "1056": {
      "text": "До ужина оставалось несколько часов.",
      "commands": [
        "$ cs_actor_exit([\"mt\", \"cs\"])",
        "$ cs_d5_cast = [\"cs_zhenya\"]"
      ]
    },
    "829": {
      "text": "Мику сыграла отрывок и ткнула в строчку.",
      "commands": [
        "play music cs_miku_piano_track fadein 0.5"
      ]
    },
    "1130": {
      "text": "Мы сдали посуду и вышли вместе.",
      "commands": [
        "$ cs_d5_room(\"bg ext_dining_hall_near_sunset\")"
      ]
    },
    "1500": {
      "text": "Лена Соколова: Запиши всё, что ещё помнишь. Даже если кажется ерундой.",
      "commands": [
        "$ cs_d5_focus(\"sy\")"
      ]
    },
    "578": {
      "text": "Мы с Дашей вышли проветриться и дошли до скамейки у площадки.",
      "commands": [
        "$ cs_d5_room(\"bg ext_playground_day\")"
      ]
    }
  }
}